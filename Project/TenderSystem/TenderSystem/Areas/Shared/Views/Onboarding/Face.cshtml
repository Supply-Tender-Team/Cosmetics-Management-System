@{
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Face setup";
    var count = (int)(ViewData["Count"] ?? 0);
}
@section Styles {
    <link rel="stylesheet" href="~/css/onboarding.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/face.css" asp-append-version="true" />
}
<p class="onboarding-kicker">ONBOARDING &middot; SECURITY OPTION &middot; FACE</p>
<h1 class="h3">Set up face sign-in</h1>
<p class="onboarding-lead">The camera asks you to look straight and turn your head to both sides, so a photo cannot fool it. We save a protected template of your face, never the photo.</p>
<section class="onboarding-form">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    @if (count > 0)
    {
        <div class="alert alert-success mb-0">Your face is saved. Go back to continue, or to set up a fingerprint as well.</div>
        <a class="btn btn-brand w-100" asp-area="Shared" asp-controller="Onboarding" asp-action="Security">Back to the options</a>
    }
    else
    {
        <a class="onboarding-back" asp-area="Shared" asp-controller="Onboarding" asp-action="Security"><i class="bi bi-arrow-left" aria-hidden="true"></i> Choose fingerprint instead</a>
        <partial name="_FaceCapture" model="@("enroll")" />
    }
</section>
@section Scripts {
    <script src="~/js/face.js" asp-append-version="true"></script>
    <script>document.addEventListener('face:enrolled', function () { setTimeout(function () { location.reload(); }, 900); });</script>
}
