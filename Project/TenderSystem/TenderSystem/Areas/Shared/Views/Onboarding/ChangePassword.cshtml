@model TenderSystem.Areas.Shared.Models.ChangePasswordViewModel
@{ Layout = "~/Views/Shared/_AuthLayout.cshtml"; ViewData["Title"] = "Change password"; }
@section Styles { <link rel="stylesheet" href="~/css/onboarding.css" asp-append-version="true" /> }
<p class="onboarding-kicker">FIRST SIGN IN · SECURITY</p>
<h1 class="h3">Set a new password</h1>
<p class="onboarding-lead">Your account needs a new password before you continue.</p>
<form asp-area="Shared" asp-controller="Onboarding" asp-action="ChangePassword" method="post" class="onboarding-form">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div><label asp-for="CurrentPassword" class="form-label">Current password</label><input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" /><span asp-validation-for="CurrentPassword" class="text-danger"></span></div>
    <div><label asp-for="NewPassword" class="form-label">New password</label><input asp-for="NewPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="NewPassword" class="text-danger"></span></div>
    <div><label asp-for="ConfirmPassword" class="form-label">Confirm new password</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
    <button class="btn btn-brand w-100" type="submit">Save and continue</button>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
