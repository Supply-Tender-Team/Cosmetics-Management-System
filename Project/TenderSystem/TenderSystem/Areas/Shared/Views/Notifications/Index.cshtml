@model List<TenderSystem.Data.Entities.Collaboration.Notification>
@{
    ViewData["Title"] = "Notifications";
    ViewData["PageSubtitle"] = "Stay updated on your requests and tender activities.";
}

@section Styles {
    <link rel="stylesheet" href="~/css/notifications.css" asp-append-version="true" />
}

<section class="notifications-page" aria-label="Notifications">
    <partial name="_PageHeader" />

    @{
        var unreadCount = Model.Count(notification => !notification.IsRead);
    }

    <div class="notifications-overview" aria-label="Notification summary">
        <div class="notifications-overview-copy">
            <span class="notifications-overview-icon"><i class="bi bi-bell" aria-hidden="true"></i></span>
            <div>
                <strong>Your updates, all in one place</strong>
                <p>Review the latest activity and open the related page when you need more details.</p>
            </div>
        </div>
        <div class="notifications-overview-stats">
            <div class="notifications-stat">
                <span>Total updates</span>
                <strong>@Model.Count</strong>
            </div>
            <div class="notifications-stat notifications-stat-unread">
                <span>Unread</span>
                <strong>@unreadCount</strong>
            </div>
        </div>
    </div>

    <partial name="_Toast" />

    @if (Model.Count == 0)
    {
        ViewData["EmptyStateTitle"] = "No notifications yet";
        ViewData["EmptyStateMessage"] = "Your notifications will appear here when there are updates.";
        ViewData["EmptyStateIcon"] = "bi-bell";
        <partial name="_EmptyState" />
    }
    else
    {
        <div class="notifications-list-heading">
            <div>
                <h2>Recent activity</h2>
                <p>Choose an update to continue to its related task.</p>
            </div>
            <div class="notifications-filter" role="group" aria-label="Filter notifications">
                <button class="is-active" type="button" data-notification-filter="all" aria-pressed="true">All <span>@Model.Count</span></button>
                <button type="button" data-notification-filter="unread" aria-pressed="false">Unread <span>@unreadCount</span></button>
            </div>
        </div>

        <p class="notifications-filter-empty" hidden>No unread notifications right now.</p>

        <ul class="notifications-list" data-notifications-list>
            @foreach (var notification in Model)
            {
                var notificationIcon = "bi-bell-fill";
                var notificationCategory = "Update";
                if (notification.Type == "TenderInvitation")
                {
                    notificationIcon = "bi-envelope-paper";
                    notificationCategory = "Tender invitation";
                }
                else if (notification.Type == "TenderEvaluation")
                {
                    notificationIcon = "bi-clipboard-check";
                    notificationCategory = "Committee evaluation";
                }
                else if (notification.Type == "OfferReceived")
                {
                    notificationIcon = "bi-inboxes";
                    notificationCategory = "Offer received";
                }
                else if (notification.Type == "EvaluationReportForManager")
                {
                    notificationIcon = "bi-file-earmark-check";
                    notificationCategory = "Report review";
                }
                else if (notification.Type == "EvaluationReportReady")
                {
                    notificationIcon = "bi-file-earmark-text";
                    notificationCategory = "Evaluation report";
                }
                else if (notification.Type == "ClarificationMessage")
                {
                    notificationIcon = "bi-chat-left-text";
                    notificationCategory = "Clarification";
                }
                else if (notification.Type == "SupplierTenderAwarded")
                {
                    notificationIcon = "bi-trophy";
                    notificationCategory = "Tender result";
                }
                else if (notification.Type == "SupplierTenderNotSelected")
                {
                    notificationIcon = "bi-info-circle";
                    notificationCategory = "Tender result";
                }
                else if (notification.Type == "DecisionRequired")
                {
                    notificationIcon = "bi-clipboard2-check";
                    notificationCategory = "Decision required";
                }
                else if (notification.Type == "TopCommitteeDecision")
                {
                    notificationIcon = "bi-gavel";
                    notificationCategory = "Top Committee decision";
                }
                else if (notification.Type == "TopCommitteeResultForManager")
                {
                    notificationIcon = "bi-award";
                    notificationCategory = "Top Committee result";
                }
                else if (notification.Type == "TopCommitteeDecisionBlocked")
                {
                    notificationIcon = "bi-hourglass-split";
                    notificationCategory = "Decision on hold";
                }
                else if (notification.Type == "ManagerDecisionRecorded")
                {
                    notificationIcon = "bi-check2-square";
                    notificationCategory = "Decision recorded";
                }
                else if (notification.Type == "RequestSubmitted")
                {
                    notificationIcon = "bi-inbox";
                    notificationCategory = "New request";
                }

                var notificationCardClass = notification.IsRead ? string.Empty : "is-unread";
                var notificationStateClass = notification.IsRead ? "is-read" : "is-new";
                var notificationStateIcon = notification.IsRead ? "bi-check2" : "bi-dot";
                var notificationStateText = notification.IsRead ? "Read" : "New";
                <li data-notification-item data-is-read="@notification.IsRead.ToString().ToLowerInvariant()">
                    <article class="notification-card @notificationCardClass">
                        <span class="notification-type-icon" aria-hidden="true">
                            <i class="bi @notificationIcon"></i>
                        </span>

                        <div class="notification-card-top">
                            <div class="notification-card-copy">
                                <div class="notification-title-row">
                                    <h3>@notification.Title</h3>
                                    <span class="notification-state @notificationStateClass">
                                        <i class="bi @notificationStateIcon" aria-hidden="true"></i>
                                        @notificationStateText
                                    </span>
                                </div>
                                <span class="badge badge-status">@notificationCategory</span>
                                <p class="notification-message">@notification.Message</p>
                            </div>
                        </div>

                        <div class="notification-card-meta">
                            <span class="notification-date">
                                <i class="bi bi-clock" aria-hidden="true"></i>
                                @notification.CreatedAt.ToString("dd MMM yyyy, HH:mm") UTC
                            </span>

                            <div class="notification-actions">
                                @if (!string.IsNullOrWhiteSpace(notification.Link)
                                    && Url.IsLocalUrl(notification.Link))
                                {
                                    <a class="notification-details btn btn-brand" href="@Url.Content(notification.Link)">
                                        <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
                                        Open update
                                    </a>
                                }

                                @if (!notification.IsRead)
                                {
                                    <form asp-area="Shared"
                                          asp-controller="Notifications"
                                          asp-action="MarkRead"
                                          asp-route-id="@notification.Id"
                                          method="post">
                                        <button class="notification-mark-read btn btn-outline-secondary" type="submit">
                                            <i class="bi bi-check2" aria-hidden="true"></i>
                                            Mark as read
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </article>
                </li>
            }
        </ul>
    }
</section>
