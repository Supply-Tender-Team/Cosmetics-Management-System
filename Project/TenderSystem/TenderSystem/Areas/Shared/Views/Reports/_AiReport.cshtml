@model TenderSystem.Areas.Shared.Models.Reports.ReportPageViewModel
<section class="reports-ai" data-ai-report aria-labelledby="ai-report-title">
    <header class="reports-ai-header">
        <div class="reports-ai-heading"><span class="reports-ai-icon" aria-hidden="true"><i class="bi bi-stars"></i></span><div><span class="reports-ai-eyebrow">AI ASSISTED</span><h2 id="ai-report-title">A clearer picture, in one report</h2><p>Summarize @Model.Selected!.Title.ToLowerInvariant(), or focus on something specific.</p></div></div>
        <span class="reports-ai-badge">Connection pending</span>
    </header>
    <form data-ai-form method="post" asp-action="GenerateAiReport" data-choices-url="@Url.Action("AiReportChoices", "Reports", new { area = "Shared" })">
        <input type="hidden" name="Type" value="@Model.Selected.Key" />
        <fieldset class="reports-ai-modes"><legend class="visually-hidden">Report scope</legend>
            <label><input type="radio" name="SpecificTopic" value="false" checked /><span><strong>Quick summary</strong><small>All records in this report. No filters needed.</small></span></label>
            <label><input type="radio" name="SpecificTopic" value="true" disabled="@(!Model.Selected.HasSupplier && !Model.Selected.HasTender && !Model.Selected.HasDepartment && !Model.Selected.HasPerson && !Model.Selected.HasDate && Model.Statuses.Count == 0)" /><span><strong>Specific topic</strong><small>@(Model.Selected.HasSupplier || Model.Selected.HasTender || Model.Selected.HasDepartment || Model.Selected.HasPerson || Model.Selected.HasDate || Model.Statuses.Count > 0 ? "Choose one focus and an optional date range." : "This report supports a full overview only.")</small></span></label>
        </fieldset>
        <div class="reports-ai-focus" data-ai-focus hidden>
            <div class="reports-ai-fields">
                <div><label for="ai-focus">Focus on</label><select id="ai-focus" name="Focus" class="form-select" disabled><option value="">Choose a focus</option>
                    @if(Model.Selected.HasSupplier){<option value="supplier">A supplier</option>}
                    @if(Model.Selected.HasTender){<option value="tender">A tender</option>}
                    @if(Model.Selected.HasDepartment){<option value="department">A department</option>}
                    @if(Model.Selected.HasPerson){<option value="person">@Model.Selected.PersonLabel</option>}
                    @if(Model.Statuses.Count > 0){<option value="status">A status</option>}
                    @if(Model.Selected.HasSupplier){<option value="compare-suppliers">Compare suppliers</option>}
                    @if(Model.Selected.HasDepartment){<option value="compare-departments">Compare departments</option>}
                    @if(Model.Selected.HasDate){<option value="period">A date range</option>}
                </select></div>
                <div data-ai-choice-wrap hidden><label for="ai-choice">Choose a record</label><select id="ai-choice" name="FocusId" class="form-select" disabled><option value="">Choose a record</option></select></div>
                @if(Model.Selected.HasDate){<div><label for="ai-from">From date (@Model.Selected.DateLabel.ToLowerInvariant())</label><input type="date" class="form-control" id="ai-from" name="From" disabled /></div><div><label for="ai-to">To date</label><input type="date" class="form-control" id="ai-to" name="To" disabled /></div>}
            </div>
            <p class="reports-ai-hint" data-ai-topic-hint>This scope is separate from the regular table filters. Dates use UTC.</p>
        </div>
        <div class="reports-ai-actions"><button class="btn btn-brand" type="submit" data-ai-generate><i class="bi bi-stars" aria-hidden="true"></i> Generate report</button><button type="button" class="btn reports-ai-export" disabled aria-describedby="ai-connection-note"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> Export generated report PDF</button></div>
    </form>
    <p id="ai-connection-note" class="reports-ai-hint">AI generation will be available when the report service is connected. Your regular reports and exports work as usual.</p>
    <p data-ai-status class="reports-ai-status" role="status" aria-live="polite" hidden></p>
</section>
