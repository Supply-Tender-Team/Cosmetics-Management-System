@model TenderSystem.Areas.Shared.Models.Reports.ReportPageViewModel
@{ ViewData["Title"] = Model.Selected?.Title ?? "Report"; }
@section Styles { <link rel="stylesheet" href="~/css/reports.css" asp-append-version="true" /> }
@section Scripts { <script src="~/js/reports.js" asp-append-version="true"></script> }
<div class="reports-page reports-print">
    <div class="reports-print-actions"><a class="btn btn-outline-secondary" asp-action="Index" asp-all-route-data="@Model.RouteValues()">Back to reports</a><button type="button" class="btn btn-brand" data-report-print>Print / Save as PDF</button><p class="text-muted mb-0">Choose “Save as PDF” in your browser's print window.</p></div>
    <header class="reports-print-heading"><span class="reports-eyebrow">MS. WAND · Reports</span><h1 class="page-title">@Model.Selected?.Title</h1><p>Generated by @Model.GeneratedBy · @Model.GeneratedAt.ToString("dd MMM yyyy, HH:mm") UTC</p><p>@Model.TotalCount filtered records @(Model.Selected?.HasDate == true ? "· " + Model.Selected.DateLabel + " dates" : "")</p></header>
    @if(Model.AppliedFilters.Count > 0)
    { <dl class="reports-applied-filters">@foreach(var filter in Model.AppliedFilters){<dt>@filter.Label</dt><dd>@filter.Value</dd>}</dl> }
    @if(Model.Breakdown.Count > 0)
    { <partial name="~/Areas/Shared/Views/Reports/_Breakdown.cshtml" model="Model" /> }
    @if(Model.Rows.Count==0){<p>No records match these filters.</p>}else{<partial name="~/Areas/Shared/Views/Reports/_PrintRecords.cshtml" model="Model" />}
    <p class="reports-footnote">This document contains the records available to the signed-in user at generation time.</p>
</div>
