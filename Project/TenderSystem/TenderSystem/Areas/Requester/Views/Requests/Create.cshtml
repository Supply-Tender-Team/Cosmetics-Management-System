@model TenderSystem.Areas.Requester.Models.CreatePurchaseRequestViewModel
@{
    ViewData["Title"] = Model.Id.HasValue ? "Edit Request" : "New Purchase Request";
}

@section Styles {
    <link rel="stylesheet" href="~/css/requester.css" asp-append-version="true" />
}

<div class="requester-dashboard requester-create-page">
    <div class="requester-form-intro">
        <a class="requester-back-link" asp-area="Requester" asp-controller="Dashboard" asp-action="Index">
            <i class="bi bi-arrow-left me-1"></i>Back to dashboard
        </a>
        <span class="requester-eyebrow requester-create-eyebrow"><i class="bi bi-stars me-2"></i>Department request</span>
        <h1 class="page-title">@(Model.Id.HasValue ? "Edit purchase request" : "New purchase request")</h1>
        <p class="text-muted">Describe what your department needs. You can save it as a draft or submit it for review.</p>
        <img class="requester-title-art requester-create-art" src="~/images/requester-cosmetics-crop.png" asp-append-version="true" alt="" aria-hidden="true" />
    </div>

    <div class="requester-panel requester-form-panel">
        <form asp-area="Requester" asp-controller="Requests" asp-action="Create" method="post" id="purchaseRequestForm">
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="All" class="requester-validation-summary" role="alert"></div>

            <section class="requester-form-section">
                <div class="requester-form-section-heading">
                    <span class="requester-form-step"><i class="bi bi-card-checklist"></i><span>01</span></span>
                    <div>
                        <h2>Request details</h2>
                        <p>Tell us what you need and when it is required.</p>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title" class="form-control" placeholder="For example: Glass packaging bottles" />
                        <span asp-validation-for="Title" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Reason" class="form-label"></label>
                        <textarea asp-for="Reason" class="form-control" rows="3" placeholder="Explain why your department needs these items."></textarea>
                        <span asp-validation-for="Reason" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Priority" class="form-label"></label>
                        <select asp-for="Priority" class="form-select">
                            <option value="">Choose priority</option>
                            <option value="Low">Low</option>
                            <option value="Medium">Medium</option>
                            <option value="High">High</option>
                            <option value="Urgent">Urgent</option>
                        </select>
                        <span asp-validation-for="Priority" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="TargetDate" class="form-label"></label>
                        <input asp-for="TargetDate" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" class="form-control" />
                        <span asp-validation-for="TargetDate" class="text-danger"></span>
                    </div>
                </div>
            </section>

            <section class="requester-form-section requester-items-section">
                <div class="requester-form-section-heading requester-items-heading">
                    <span class="requester-form-step"><i class="bi bi-basket3"></i><span>02</span></span>
                    <div>
                        <h2>Requested items</h2>
                        <p>Add each item with its quantity, unit, and specifications.</p>
                    </div>
                    <button type="button" class="btn btn-outline-brand requester-add-item" id="addRequestItem">
                        <i class="bi bi-plus-lg me-1"></i>Add item
                    </button>
                </div>

                <span asp-validation-for="Items" class="text-danger d-block mb-2"></span>
                <div id="requestItems">
                    @for (var i = 0; i < Model.Items.Count; i++)
                    {
                        <div class="requester-item-card" data-item-row>
                            <div class="requester-item-card-heading">
                                <strong><i class="bi bi-box-seam"></i>Item <span data-item-number>@(i + 1)</span></strong>
                                <button type="button" class="btn btn-sm btn-outline-secondary requester-remove-item" data-remove-item aria-label="Remove item">
                                    <i class="bi bi-trash3"></i><span class="ms-1">Remove</span>
                                </button>
                            </div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="Items[i].ItemName" class="form-label"></label>
                                    <input asp-for="Items[i].ItemName" class="form-control" placeholder="Item or service name" />
                                    <span asp-validation-for="Items[i].ItemName" class="text-danger"></span>
                                </div>
                                <div class="col-md-3 col-6">
                                    <label asp-for="Items[i].Quantity" class="form-label"></label>
                                    <input asp-for="Items[i].Quantity" class="form-control" type="number" min="0.01" step="0.01" />
                                    <span asp-validation-for="Items[i].Quantity" class="text-danger"></span>
                                </div>
                                <div class="col-md-3 col-6">
                                    <label asp-for="Items[i].Unit" class="form-label"></label>
                                    <select asp-for="Items[i].Unit" class="form-select">
                                        <option value="">Choose weight unit</option>
                                        @foreach (var unit in TenderSystem.Areas.Requester.Models.CreatePurchaseRequestItemViewModel.AllowedWeightUnits)
                                        {
                                            <option value="@unit">@unit</option>
                                        }
                                    </select>
                                    <span asp-validation-for="Items[i].Unit" class="text-danger"></span>
                                </div>
                                <div class="col-12">
                                    <label asp-for="Items[i].Specifications" class="form-label"></label>
                                    <textarea asp-for="Items[i].Specifications" class="form-control" rows="2" placeholder="Size, material, quality, or other requirements"></textarea>
                                    <span asp-validation-for="Items[i].Specifications" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </section>

            <div class="requester-form-actions">
                <a class="btn btn-outline-secondary" asp-area="Requester" asp-controller="Dashboard" asp-action="Index">Cancel</a>
                <button type="submit" name="submitAction" value="draft" formnovalidate class="btn btn-outline-brand">
                    <i class="bi bi-save me-1"></i>@(Model.Id.HasValue ? "Save changes" : "Save draft")
                </button>
                <button type="submit" name="submitAction" value="submit" class="btn btn-brand">
                    <i class="bi bi-send me-1"></i>Submit for review
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/request-create.js" asp-append-version="true"></script>
}
