@model TenderSystem.Areas.Requester.Models.PurchaseRequestDetailsViewModel
@{
    var statusClass = Model.Status.ToLowerInvariant().Replace(" ", "-");
    var priorityClass = Model.Priority.ToLowerInvariant();
    var hasDecision = Model.Status is "Approved" or "Rejected" or "Returned" or "Converted to Tender";
}

<div class="modal fade requester-details-modal" id="request-details-@Model.Id" tabindex="-1" aria-labelledby="request-details-title-@Model.Id" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <span class="requester-modal-kicker"><i class="bi bi-file-earmark-text"></i>@Model.RequestNumber</span>
                    <span class="requester-eyebrow">@Model.DepartmentName · Purchase request</span>
                    <h2 class="modal-title" id="request-details-title-@Model.Id">@Model.Title</h2>
                </div>
                <img class="requester-modal-art" src="~/images/requester-cosmetics-crop.png" asp-append-version="true" alt="" aria-hidden="true" />
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="requester-modal-summary">
                    <span class="badge badge-status requester-status status-@statusClass"><i class="bi bi-record-circle me-1"></i>@Model.Status</span>
                    <span class="requester-priority priority-@priorityClass"><i class="bi bi-flag me-1"></i>@Model.Priority priority</span>
                    <span class="requester-modal-date"><i class="bi bi-calendar2-check"></i><span>Needed by<strong>@Model.TargetDate.ToString("dd MMM yyyy")</strong></span></span>
                </div>

                <section class="requester-modal-section">
                    <h3><span class="requester-modal-icon"><i class="bi bi-card-text"></i></span>Request information</h3>
                    <dl class="requester-details-fields">
                        <div><dt>Department</dt><dd>@Model.DepartmentName</dd></div>
                        <div><dt>Created</dt><dd>@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</dd></div>
                        @if (Model.SubmittedAt.HasValue)
                        {
                            <div><dt>Submitted</dt><dd>@Model.SubmittedAt.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</dd></div>
                        }
                        @if (Model.EstimatedBudget.HasValue)
                        {
                            <div><dt>Estimated budget</dt><dd>@Model.EstimatedBudget.Value.ToString("N2")</dd></div>
                        }
                    </dl>
                </section>

                <div class="requester-modal-reason">
                    <h3><i class="bi bi-chat-square-text me-2"></i>Reason for request</h3>
                    <p>@Model.Reason</p>
                </div>

                <h3 class="requester-modal-section-title"><span class="requester-modal-icon"><i class="bi bi-basket3"></i></span>Requested items <span class="requester-modal-item-count">@Model.Items.Count</span></h3>
                <div class="table-responsive">
                    <table class="table requester-table align-middle mb-0">
                        <thead><tr><th>Item</th><th>Quantity</th><th>Unit</th><th>Specifications</th></tr></thead>
                        <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="requester-request-title">@item.ItemName</td>
                                <td>@item.Quantity.ToString("0.##")</td>
                                <td>@item.Unit</td>
                                <td>@(string.IsNullOrWhiteSpace(item.Specifications) ? "—" : item.Specifications)</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.ReviewNote))
                {
                    <div class="requester-modal-review-note">
                    <h3><span class="requester-modal-icon"><i class="bi bi-chat-left-text"></i></span>Review note</h3>
                        <p>@Model.ReviewNote</p>
                    </div>
                }

                <section class="requester-modal-section">
                    <h3><span class="requester-modal-icon"><i class="bi bi-signpost-split"></i></span>Request timeline</h3>
                    <ol class="requester-timeline">
                        <li class="complete">
                            <span class="requester-timeline-marker"><i class="bi bi-check-lg"></i></span>
                            <div><strong>Request created</strong><span>@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span></div>
                        </li>
                        <li class="@(Model.SubmittedAt.HasValue ? "complete" : "pending")">
                            <span class="requester-timeline-marker">@(Model.SubmittedAt.HasValue ? "✓" : "2")</span>
                            <div><strong>@(Model.SubmittedAt.HasValue ? "Submitted for review" : "Saved as draft")</strong><span>@(Model.SubmittedAt.HasValue ? Model.SubmittedAt.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm") : "Submit the request when it is ready.")</span></div>
                        </li>
                        <li class="@(hasDecision ? "complete" : Model.Status == "Under Review" ? "current" : "pending")">
                            <span class="requester-timeline-marker">@(hasDecision ? "✓" : "3")</span>
                            <div>
                                <strong>@(hasDecision ? Model.Status : Model.Status == "Under Review" ? "Under review" : "Review decision")</strong>
                                <span>@(hasDecision ? "Current decision. The decision date is not stored for this request." : Model.Status == "Under Review" ? "The sourcing team is reviewing the request." : "This step starts after the request is submitted.")</span>
                            </div>
                        </li>
                    </ol>
                </section>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary requester-modal-dismiss" data-bs-dismiss="modal"><i class="bi bi-x-lg me-2"></i>Close details</button>
            </div>
        </div>
    </div>
</div>
