@model TenderSystem.Areas.Requester.Models.RequesterDashboardViewModel
@{
    ViewData["Title"] = "Requester Dashboard";
    var requestStatusRows = new[]
    {
        (Label: "Draft", Count: Model.DraftRequests, CssClass: "draft"),
        (Label: "Submitted", Count: Model.SubmittedRequests, CssClass: "submitted"),
        (Label: "Approved", Count: Model.ApprovedRequests, CssClass: "approved"),
        (Label: "Returned", Count: Model.ReturnedRequests, CssClass: "returned"),
        (Label: "Rejected", Count: Model.RejectedRequests, CssClass: "rejected"),
        (Label: "Converted to Tender", Count: Model.ConvertedToTenderRequests, CssClass: "converted")
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/requester.css" asp-append-version="true" />
}

<div class="requester-dashboard">
    @if (TempData["RequestSuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="status">@successMessage</div>
    }

    <section class="requester-welcome">
        <div>
            <span class="requester-eyebrow">@Model.DepartmentName · Department overview</span>
            <h1 class="page-title">Welcome to your workspace</h1>
            <p class="text-muted mb-0">Manage your purchase requests and follow their progress.</p>
        </div>
        <img class="requester-title-art requester-dashboard-art" src="~/images/requester-cosmetics-crop.png" asp-append-version="true" alt="" aria-hidden="true" />
        <a class="btn btn-brand" asp-area="Requester" asp-controller="Requests" asp-action="Create">
            <i class="bi bi-plus-lg me-2"></i>New purchase request
        </a>
    </section>

    <section class="requester-stats" aria-label="Request summary">
        <article class="requester-stat-card">
            <div class="requester-stat-heading"><span>Total requests</span><i class="bi bi-file-earmark-text"></i></div>
            <strong class="requester-counter" data-count="@Model.TotalRequests">@Model.TotalRequests</strong>
            <p>All your purchase requests</p>
        </article>
        <article class="requester-stat-card">
            <div class="requester-stat-heading"><span>Drafts</span><i class="bi bi-file-earmark"></i></div>
            <strong class="requester-counter" data-count="@Model.DraftRequests">@Model.DraftRequests</strong>
            <p>Requests saved for later</p>
        </article>
        <article class="requester-stat-card">
            <div class="requester-stat-heading"><span>Approved</span><i class="bi bi-check-circle"></i></div>
            <strong class="requester-counter" data-count="@Model.ApprovedRequests">@Model.ApprovedRequests</strong>
            <p>Approved requests</p>
        </article>
        <article class="requester-stat-card">
            <div class="requester-stat-heading"><span>Returned</span><i class="bi bi-arrow-return-left"></i></div>
            <strong class="requester-counter" data-count="@Model.ReturnedRequests">@Model.ReturnedRequests</strong>
            <p>Requests that need your attention</p>
        </article>
    </section>

    <section class="requester-overview requester-reveal">
        <article class="requester-panel">
            <div class="requester-panel-heading">
                <div>
                    <h2>Request status overview</h2>
                    <p>Distribution of your purchase requests</p>
                </div>
            </div>

            @foreach (var statusRow in requestStatusRows)
            {
                var statusProgress = Model.TotalRequests == 0 ? 0 : statusRow.Count * 100.0 / Model.TotalRequests;
                <div class="requester-status-row">
                    <div><span>@statusRow.Label</span><strong>@statusRow.Count</strong></div>
                    <div class="requester-progress-track" role="progressbar" aria-label="@statusRow.Label" aria-valuenow="@statusRow.Count" aria-valuemin="0" aria-valuemax="@Model.TotalRequests">
                        <div class="requester-progress-fill @statusRow.CssClass" style="width: @statusProgress.ToString("0.##")%"></div>
                    </div>
                </div>
            }
        </article>

        <article class="requester-panel requester-approval-panel">
            <div class="requester-panel-heading">
                <div>
                    <h2>Approval summary</h2>
                    <p>Your current request progress</p>
                </div>
            </div>
            <div class="requester-approval-circle" style="--approval-percent: @Model.ApprovalPercent" aria-label="@Model.ApprovalPercent percent of requests approved">
                <div class="requester-approval-inner">
                    <strong class="requester-approval-count" data-count="@Model.ApprovalPercent">@Model.ApprovalPercent%</strong>
                    <span>Approved</span>
                </div>
            </div>
            <p class="requester-approval-caption"><strong>@Model.ApprovedRequests of @Model.TotalRequests requests</strong><br />have been approved</p>
            <div class="requester-summary-note"><i class="bi bi-info-circle me-2"></i>Review notes can help you update returned requests.</div>
        </article>
    </section>

    <section class="requester-panel requester-table-panel requester-reveal">
        <div class="requester-panel-heading requester-heading-between">
            <div>
                <h2>Recent purchase requests</h2>
                <p>Your latest requests and their current status</p>
            </div>
            <a class="requester-text-link" asp-area="Requester" asp-controller="Requests" asp-action="Index">View all</a>
        </div>

        @if (Model.RecentRequests.Count == 0)
        {
            <div class="requester-empty-state">
                <i class="bi bi-inbox"></i>
                <p>You haven't created a purchase request yet.</p>
                <a asp-area="Requester" asp-controller="Requests" asp-action="Create">Create your first request</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table requester-table align-middle mb-0">
                    <thead>
                        <tr><th>Request ID</th><th>Title</th><th>Date</th><th>Priority</th><th>Status</th><th><span class="visually-hidden">Action</span></th></tr>
                    </thead>
                    <tbody>
                    @foreach (var request in Model.RecentRequests)
                    {
                        var statusCssClass = request.Status.ToLowerInvariant().Replace(" ", "-");
                        var priorityCssClass = request.Priority.ToLowerInvariant();
                        <tr>
                            <td class="requester-request-number">@request.RequestNumber</td>
                            <td class="requester-request-title">@request.Title</td>
                            <td>@request.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td><span class="requester-priority priority-@priorityCssClass">@request.Priority</span></td>
                            <td><span class="badge badge-status requester-status status-@statusCssClass">@request.Status</span></td>
                            <td class="text-end"><button type="button" class="requester-view-link requester-modal-trigger" data-bs-toggle="modal" data-bs-target="#request-details-@request.Id" aria-label="View @request.RequestNumber"><i class="bi bi-eye"></i></button></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="requester-panel requester-notes-panel requester-reveal">
        <div class="requester-panel-heading">
            <div>
                <h2>Recent review notes</h2>
                <p>Feedback on your purchase requests</p>
            </div>
        </div>

        @if (Model.RecentReviewNotes.Count == 0)
        {
            <p class="text-muted mb-0">There are no review notes yet.</p>
        }
        else
        {
            @foreach (var note in Model.RecentReviewNotes)
            {
                <button type="button" class="requester-review-note border-0 w-100 text-start" data-bs-toggle="modal" data-bs-target="#request-details-@note.Id">
                    <span class="requester-note-icon"><i class="bi bi-chat-left-text"></i></span>
                    <span><strong>@note.Title <small>· @note.RequestNumber</small></strong><span class="requester-note-text">@note.Note</span></span>
                    <i class="bi bi-chevron-right requester-note-arrow"></i>
                </button>
            }
        }
    </section>
</div>

@foreach (var request in Model.RecentRequests.Concat(Model.ReviewNoteRequests).GroupBy(request => request.Id).Select(group => group.First()))
{
    @await Html.PartialAsync("~/Areas/Requester/Views/Requests/_RequestDetailsModal.cshtml", request)
}

@await Html.PartialAsync("~/Areas/Requester/Views/Requests/_DeleteRequestModal.cshtml")

@section Scripts {
    <script src="~/js/requester.js" asp-append-version="true"></script>
}
