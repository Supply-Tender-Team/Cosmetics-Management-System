@model IReadOnlyList<TenderSystem.Data.Entities.Tenders.Tender>
@{
    ViewData["Title"] = "Tenders eligible for re-tendering";
}
@section Styles {
    <link rel="stylesheet" href="~/css/requester.css" asp-append-version="true" />
}

<div class="requester-dashboard requester-list-page">
    <div class="requester-list-heading">
        <div>
            <span class="requester-eyebrow">Sourcing workspace</span>
            <h1 class="page-title">@ViewData["Title"]</h1>
            <p class="text-muted mb-0">Finally rejected tenders that are still the latest cycle for their request.</p>
        </div>
        <a class="btn btn-outline-secondary" asp-action="Index">Back to tenders</a>
    </div>

    @if (TempData["TenderError"] is string error)
    {
        <div class="alert alert-warning" role="alert">@error</div>
    }

    <section class="requester-panel">
        @if (Model.Count == 0)
        {
            <p class="mb-0">No tenders are currently eligible for re-tendering.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr><th scope="col">Tender</th><th scope="col">Purchase request</th><th scope="col">Action</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var tender in Model)
                        {
                            <tr>
                                <td><a asp-action="Details" asp-route-id="@tender.Id">@tender.TenderNumber</a><div>@tender.Title</div></td>
                                <td>@tender.Requisition.RequestNumber</td>
                                <td><a class="btn btn-brand" asp-action="ReTender" asp-route-id="@tender.Id">Re-Tender</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
