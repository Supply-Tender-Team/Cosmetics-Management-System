@model TenderSystem.Data.Entities.Tenders.Tender
@using TenderSystem.Areas.Sourcing.Models
@{
    var technicalWeight = Model.EvaluationCriteria.Where(criterion => criterion.Type == "Technical").Sum(criterion => criterion.WeightPercent);
    var criteriaTab = Context.Request.Query["tab"] == "criteria";
    ViewData["Title"] = "Tender details";
    var scores = ((IEnumerable<TenderOfferScore>)ViewData["Scores"]!).OrderByDescending(s => s.Total).ToArray();
    var showRanks = ViewData["CanRankOffers"] is true && scores.All(s => s.Total.HasValue);
}
@section Styles {
    <link rel="stylesheet" href="~/css/sourcing-modals.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/requester.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sourcing-tender-details.css" asp-append-version="true" />
}
@section Scripts {
    @if (Model.Status == "Draft")
    {
        <script src="~/js/sourcing-draft-publish.js" asp-append-version="true" defer></script>
    }
}
<div class="requester-dashboard requester-list-page">
    <a class="requester-text-link" asp-action="Index">← Tenders</a>
    <section class="requester-list-heading mt-3">
        <div><span class="requester-eyebrow">@Model.TenderNumber · @Model.Status</span><h1 class="page-title">@Model.Title</h1><p class="mb-0">@Model.Requisition.RequestNumber · Due @Model.SubmissionDeadline.ToString("dd MMM yyyy")</p></div>
        <img class="requester-title-art requester-list-art" src="~/images/requester-cosmetics-crop.png" asp-append-version="true" alt="" />
        @if (ViewData["CanReTender"] is true)
        {
            <a class="btn btn-brand" asp-action="ReTender" asp-route-id="@Model.Id"><i class="bi bi-arrow-repeat me-2" aria-hidden="true"></i>Re-Tender</a>
        }
    </section>
    @{
        var tenderError = TempData["TenderError"] as string;
        var invitationError = TempData["InvitationError"] as string;
        var success = TempData["InvitationSuccess"] as string;
        if ((tenderError ?? invitationError) is string error)
        {
            TempData["ToastTitle"] = "Tender action blocked";
            TempData["ToastMessage"] = error;
            TempData["ToastType"] = "warning";
        }
        else if (success is not null)
        {
            TempData["ToastTitle"] = "Tender updated";
            TempData["ToastMessage"] = success;
            TempData["ToastType"] = "success";
        }
    }
    <partial name="_Toast" />
    <nav class="nav nav-tabs tender-detail-tabs mt-4 mb-3" role="tablist" aria-label="Tender details">
        <button class="nav-link @(!criteriaTab ? "active" : "")" id="scope-tab" data-bs-toggle="tab" data-bs-target="#tender-scope" type="button" role="tab" aria-controls="tender-scope" aria-selected="@((!criteriaTab).ToString().ToLowerInvariant())">Overview</button>
        <button class="nav-link @(criteriaTab ? "active" : "")" id="criteria-tab" data-bs-toggle="tab" data-bs-target="#tender-criteria" type="button" role="tab" aria-controls="tender-criteria" aria-selected="@(criteriaTab.ToString().ToLowerInvariant())">Evaluation criteria</button>
        <button class="nav-link" id="scores-tab" data-bs-toggle="tab" data-bs-target="#tender-scores" type="button" role="tab" aria-controls="tender-scores" aria-selected="false">Offer ranking</button>
    </nav>

    <div class="tab-content">
        <section class="tab-pane @(!criteriaTab ? "show active" : "") requester-panel requester-list-panel" id="tender-scope" role="tabpanel" aria-labelledby="scope-tab" tabindex="0">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
                <div>
                    <strong>@Model.Status</strong>
                    <p class="mb-0">@(Model.Status == "Draft"
                        ? "This draft is saved. The tender has not been published or sent."
                        : "This tender has been published. The selected suppliers and committee have been notified.")</p>
                </div>
                @if (Model.Status == "Draft")
                {
                    <button class="btn btn-brand" type="button" data-bs-toggle="modal" data-bs-target="#publishDraft">Publish tender</button>
                }
            </div>
            <dl class="row">
                <dt class="col-sm-3">Request sent</dt><dd class="col-sm-9">@((Model.Requisition.SubmittedAt ?? Model.Requisition.CreatedAt).ToString("dd MMM yyyy"))</dd>
                <dt class="col-sm-3">Offers needed by</dt><dd class="col-sm-9">@Model.Requisition.TargetDate.ToString("dd MMM yyyy")</dd>
                <dt class="col-sm-3">Offer submission deadline</dt><dd class="col-sm-9">@Model.SubmissionDeadline.ToString("dd MMM yyyy, HH:mm 'UTC'")</dd>
            </dl>
            <p class="text-muted">Final approval: @(Model.RequiresTopCommittee ? "Manager, then Top Committee" : "Manager")</p>
            <div class="row g-4">
                <div class="col-md-6">
                    <h2 class="h5">Scope</h2>
                    <p class="mb-0 tender-detail-copy">@Model.Description</p>
                </div>
                <div class="col-md-6">
                    <h2 class="h5">Terms</h2>
                    <p class="mb-0 tender-detail-copy">@Model.Terms</p>
                </div>
            </div>
            <div class="mt-4">
                <h2 class="h5">Suppliers</h2>
                @if (Model.TenderSuppliers.Count == 0)
                {
                    <p>Choose suppliers when you publish this draft.</p>
                }
                else
                {
                    <ul>@foreach (var supplier in Model.TenderSuppliers.OrderBy(s => s.SupplierProfile.CompanyName))
                    { <li>@supplier.SupplierProfile.CompanyName</li> }</ul>
                }
            </div>
        </section>

    <section class="tab-pane @(criteriaTab ? "show active" : "") requester-panel requester-list-panel" id="tender-criteria" role="tabpanel" aria-labelledby="criteria-tab" tabindex="0">
        @if (Model.PublishDate is not null)
        {
            <p>The internal tender brief is shared with the four assigned members when published. Offer review continues in Compliance and Evaluation Tracking.</p>
        }
        <h2 class="h5">Evaluation criteria</h2>
        <div class="table-responsive"><table class="table requester-table">
            <thead><tr><th>Criterion</th><th>Type</th><th>Weight</th><th>Status</th></tr></thead>
            <tbody>
            @foreach (var criterion in Model.EvaluationCriteria.OrderBy(c => c.Id))
            {
                <tr><td class="requester-request-title">@criterion.Name</td><td>@criterion.Type</td><td>@criterion.WeightPercent.ToString("0.##")%</td><td>@(criterion.IsLocked ? "Locked" : "Draft")</td></tr>
            }
            </tbody>
        </table></div>
    </section>
    <section class="tab-pane requester-panel requester-list-panel" id="tender-scores" role="tabpanel" aria-labelledby="scores-tab" tabindex="0">
        <h2 class="h5">Committee scores and offer ranking</h2>
        <p class="text-muted">Ranking adds the committee’s average technical and financial question scores. Ranks appear once compliance and committee scores are complete for all eligible offers. Equal totals share a rank.</p>
        <div class="table-responsive"><table class="table requester-table align-middle">
            <thead><tr><th>Supplier</th><th>Price</th>
                @foreach (var seat in TenderSetup.Seats)
                {
                    <th>@seat.Title<br /><small>@Model.CommitteeMembers.FirstOrDefault(m => m.MemberRole == seat.Code)?.User.FullName</small></th>
                }
                <th>Technical average / @technicalWeight.ToString("0.##")</th><th>Financial average / @Model.EvaluationCriteria.Where(c => c.Type == "Financial").Sum(c => c.WeightPercent).ToString("0.##")</th><th>Total / 100</th></tr></thead>
            <tbody>
            @if (scores.Length == 0) { <tr><td colspan="9">No eligible offers to score yet.</td></tr> }
            @foreach (var score in scores)
            {
                <tr><td>@score.Supplier @if (showRanks) { <strong class="d-block">Rank @(1 + scores.Count(other => other.Total > score.Total))</strong> }</td><td>@score.Price.ToString("N2") @score.Currency</td>
                    @foreach (var points in score.Technical) { <td>@(points?.ToString("0.##") ?? "Pending")</td> }
                    <td>@(score.Average?.ToString("0.##") ?? "Pending")</td><td>@(score.Financial?.ToString("0.##") ?? "Pending")</td><td><strong>@(score.Total?.ToString("0.##") ?? "Pending")</strong></td>
                </tr>
            }
            </tbody>
        </table></div>
    </section>
    </div>
</div>

@if (Model.Status == "Draft")
{
    <partial name="_DraftPublish" model="Model" />
}
