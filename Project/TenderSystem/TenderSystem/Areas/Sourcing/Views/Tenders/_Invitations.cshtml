@model TenderSystem.Data.Entities.Tenders.Tender
@{
    var suppliers = (IReadOnlyList<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewData["InvitableSuppliers"]!;
    var category = ViewData["InvitationCategory"] as string;
    var choosingSuppliers = Context.Request.Query["chooseSuppliers"] == "true";
    var isDraft = Model.Status == "Draft";
    var canInvite = (Model.Status is "Draft" or "Published" or "Open") && Model.SubmissionDeadline > DateTime.UtcNow;
}
<h2 class="h5 mb-2">Invite suppliers</h2>

@if (canInvite)
{
    <form asp-action="Details" method="get" class="d-flex flex-wrap align-items-end gap-2 mb-3">
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="hidden" name="tab" value="invitations" />
        <input type="hidden" name="chooseSuppliers" value="true" />
        <div>
            <label class="form-label" for="invitationCategory">Filter by category</label>
            <select id="invitationCategory" name="category" class="form-select">
                <option value="">All categories</option>
                @foreach (var option in (IEnumerable<string>)ViewData["InvitationCategories"]!)
                {
                    <option value="@option" selected="@(option == category)">@option</option>
                }
            </select>
        </div>
        <button type="submit" class="btn btn-brand">Next</button>
    </form>
}
@if (Model.SubmissionDeadline <= DateTime.UtcNow)
{
    <p>The submission deadline has passed. Supplier invitations are closed.</p>
}
else if (canInvite && choosingSuppliers && suppliers.Count == 0)
{
    <p id="tenderSupplierEmpty" class="text-muted">No approved suppliers available for this category.</p>
}
else if (canInvite && choosingSuppliers)
{
    <form asp-action="@(isDraft ? "Publish" : "Invite")" asp-route-id="@Model.Id" method="post" id="tenderInvitationForm">
        <input type="hidden" name="category" value="@category" />
        <div class="dropdown tender-supplier-dropdown mb-3">
            <button class="btn btn-outline-secondary dropdown-toggle w-100 text-start" type="button" id="tenderSupplierPicker"
                    data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                Choose suppliers <span id="tenderSupplierCount" class="small ms-1" aria-live="polite"></span>
            </button>
            <div class="dropdown-menu w-100 p-2" aria-labelledby="tenderSupplierPicker">
                <label class="tender-supplier-option">
                    <input class="form-check-input mt-0" type="checkbox" id="tenderSelectAll" />
                    <strong>Select all suppliers</strong>
                </label>
                <div class="tender-supplier-options">
                    @foreach (var supplier in suppliers)
                    {
                        <label class="tender-supplier-option">
                            <input class="form-check-input mt-0" name="supplierIds" type="checkbox" value="@supplier.Value" />
                            <span>@supplier.Text</span>
                        </label>
                    }
                </div>
            </div>
        </div>
        <button class="btn btn-brand" type="button" id="tenderReviewButton" disabled>Review invitations</button>
        <section class="tender-invitation-review pt-3 mt-3" id="tenderInvitationReview" aria-labelledby="tenderReviewTitle" hidden>
            <h3 class="h6" id="tenderReviewTitle" tabindex="-1">Review invitations</h3>
            <ul id="tenderSelectedSuppliers"></ul>
            <button class="btn btn-brand" type="button" id="tenderInviteButton">@(isDraft ? "Publish and send invitations" : "Send invitations")</button>
        </section>
    </form>
}
<hr class="my-4" />
<div class="d-flex justify-content-between align-items-center gap-2 mb-2">
    <h2 class="h5 mb-0">Invitation history <span class="requester-priority">@Model.Invitations.Count</span></h2>
    @if (Model.Invitations.Count > 0)
    {
        <button class="btn btn-sm btn-outline-secondary" type="button" id="invitationHistoryToggle" aria-controls="invitationHistoryTable" aria-expanded="true">Hide table</button>
    }
</div>
@if (Model.Invitations.Count == 0)
{
    <p class="text-muted mb-0">No invitations sent yet.</p>
}
else
{
    <div class="table-responsive" id="invitationHistoryTable">
        <table class="table requester-table align-middle mb-0">
            <thead><tr><th scope="col">Supplier</th><th scope="col">Sent</th><th scope="col">Respond by (UTC)</th><th scope="col">Status</th><th scope="col">Response</th></tr></thead>
            <tbody>
            @foreach (var invitation in Model.Invitations.OrderByDescending(i => i.RespondedAt ?? i.SentAt).ThenByDescending(i => i.Id))
            {
                var status = invitation.Status == "Pending" && invitation.ExpiresAt <= DateTime.UtcNow ? "Expired" : invitation.Status;
                var style = status switch { "Accepted" => "approved", "Declined" => "rejected", "Expired" => "converted-to-tender", _ => "submitted" };
                <tr>
                    <td class="requester-request-title">@invitation.SupplierProfile.CompanyName</td>
                    <td>@invitation.SentAt.ToString("dd MMM yyyy")</td>
                    <td>@invitation.ExpiresAt.ToString("dd MMM yyyy, HH:mm")</td>
                    <td><span class="badge badge-status requester-status status-@style">@status</span></td>
                    <td>@(invitation.RespondedAt?.ToString("dd MMM yyyy") ?? "—")
                        @if (!string.IsNullOrWhiteSpace(invitation.DeclineReason)) { <div class="small">@invitation.DeclineReason</div> }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
