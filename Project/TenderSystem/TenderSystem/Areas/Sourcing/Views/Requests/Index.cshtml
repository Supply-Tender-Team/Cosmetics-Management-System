@model IReadOnlyList<TenderSystem.Data.Entities.Requests.PurchaseRequisition>
@{
    ViewData["Title"] = "Incoming requests";
}
@section Styles {
    <link rel="stylesheet" href="~/css/sourcing-requests.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/sourcing-requests.js" asp-append-version="true" defer></script>
}

<div class="src-requests">
    <h1 class="page-title">Incoming requests</h1>
    <p class="text-muted">Review purchase requests submitted by your departments.</p>
    @if (TempData["RequestError"] is string error)
    {
        <div class="alert alert-warning" role="alert">@error</div>
    }
    @if (TempData["RequestSuccess"] is string success)
    {
        <div class="toast-container position-fixed bottom-0 end-0 p-3">
            <div id="requestResult" class="toast" role="status" data-bs-autohide="false">
                <div class="toast-header"><strong class="me-auto">Review decision</strong><button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button></div>
                <div class="toast-body">@success</div>
            </div>
        </div>
    }
    <section class="src-panel">
        <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
            <h2 class="h5 mb-0">Awaiting review <span class="src-tag">@Model.Count</span></h2>
            @if (Model.Count > 0)
            {
                <button type="button" class="btn btn-sm btn-outline-secondary" id="requestTableToggle" aria-controls="requestTable" aria-expanded="true">Hide table</button>
            }
        </div>
        @if (Model.Count == 0)
        {
            <p class="text-muted mb-0">There are no purchase requests awaiting review.</p>
        }
        else
        {
            <div class="table-responsive src-queue" id="requestTable">
                <table class="table align-middle mb-0">
                    <thead><tr><th scope="col">Request</th><th scope="col">Department</th><th scope="col">Priority</th><th scope="col">Submitted</th><th scope="col">Needed by</th><th scope="col">Status</th><th scope="col">Action</th></tr></thead>
                    <tbody>
                    @foreach (var request in Model)
                    {
                        <tr>
                            <td><strong>@request.Title</strong><div class="small text-muted">@request.RequestNumber · @request.RequestedByUser.FullName</div></td>
                            <td>@request.Department.Name</td>
                            <td>@request.Priority</td>
                            <td>@(request.SubmittedAt?.ToString("dd MMM yyyy") ?? "—")</td>
                            <td>@request.TargetDate.ToString("dd MMM yyyy")</td>
                            <td><span class="src-tag">@request.Status</span></td>
                            <td><a class="btn btn-sm src-primary" asp-action="Review" asp-route-id="@request.Id" data-request-review aria-label="Review @request.RequestNumber">Review</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

<div class="modal fade" id="requestReview" tabindex="-1" aria-labelledby="requestReviewTitle" aria-hidden="true">
    <div class="modal-dialog src-review-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header src-review-header">
                <h2 class="modal-title h5" id="requestReviewTitle">Purchase request review</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close review"></button>
            </div>
            <div class="modal-body" id="requestReviewBody" aria-live="polite"></div>
        </div>
    </div>
</div>

