@model TenderSystem.Areas.Sourcing.Models.CompareOffersViewModel
@using TenderSystem.Infrastructure
@{
    ViewData["Title"] = "Compare Offers";
    ViewData["PageSubtitle"] = "Compare submitted offers and manage limited tender resends. This page does not score or award offers.";
    var selectedTenderOption = Model.Tenders.FirstOrDefault(tender => tender.Id == Model.SelectedTenderId);
}

@section Styles {
    <link rel="stylesheet" href="~/css/compare-offers.css" asp-append-version="true" />
}

<main class="compare-offers-page">
    <header class="compare-page-heading">
        <div>
            <span class="compare-eyebrow">Sourcing workspace</span>
            <h1 class="page-title">Side-by-side offer review</h1>
            <p>Review offers from one tender, and resend it to the originally selected suppliers when fewer than three submit.</p>
        </div>
    </header>

    <section class="compare-panel compare-tender-panel" aria-labelledby="tender-select-heading">
        <div class="compare-panel-heading">
            <div>
                <span class="compare-step">01</span>
                <h2 id="tender-select-heading">Select a tender</h2>
            </div>
            <p>Tenders with submitted offers or selected suppliers are listed.</p>
        </div>

        @if (Model.Tenders.Count == 0)
        {
            <div class="compare-empty"><i class="bi bi-inbox" aria-hidden="true"></i><div><strong>No tenders ready for comparison</strong><p>No tender currently has submitted bids or an expired submission period awaiting a resend.</p></div></div>
        }
        else
        {
            <form method="get" asp-area="Sourcing" asp-controller="Offers" asp-action="Compare" class="compare-filter-form">
                <div class="compare-tender-select-row">
                    <span id="tender-label" class="form-label">Tender</span>
                    <div class="compare-tender-picker" data-tender-picker>
                        <input type="hidden" name="tenderId" value="@Model.SelectedTenderId" data-tender-value />
                        <button type="button" class="form-select compare-tender-trigger" data-tender-trigger
                                aria-labelledby="tender-label" aria-haspopup="listbox" aria-expanded="false" aria-controls="tender-option-list">
                            <span data-tender-current>
                                @if (selectedTenderOption is not null)
                                {
                                    <span class="compare-tender-current-title">@selectedTenderOption.Title</span>
                                    <small>@selectedTenderOption.CreatedAt.ToLocalTime().ToString("dd MMM yyyy") · @selectedTenderOption.EligibleOfferCount offer(s)</small>
                                }
                                else
                                {
                                    <span class="compare-tender-placeholder">Select a tender</span>
                                    <small>Search by tender name</small>
                                }
                            </span>
                            <i class="bi bi-chevron-down" aria-hidden="true"></i>
                        </button>
                        <div class="compare-tender-menu" data-tender-menu hidden>
                            <div data-voice-search-scope="filter">
<div class="compare-tender-search-wrap">
                                <i class="bi bi-search" aria-hidden="true"></i>
                                <input type="search" class="compare-tender-search" placeholder="Search tenders…"
                                       aria-label="Search tenders by name" data-tender-search autocomplete="off" data-voice-search-input />
                                <partial name="_SourcingVoiceSearchControls" />
                            </div>
                            <div class="form-text" role="status" aria-live="polite" data-voice-search-status></div>
                        </div>
                            <div class="compare-tender-options" id="tender-option-list" role="listbox" aria-labelledby="tender-label" data-tender-options>
                        @foreach (var tender in Model.Tenders)
                        {
                            var selected = Model.SelectedTenderId == tender.Id;
                            <button type="button" class="compare-tender-option @(selected ? "is-selected" : "")"
                                    role="option" aria-selected="@selected.ToString().ToLowerInvariant()" tabindex="-1"
                                    data-tender-option data-value="@tender.Id"
                                    data-search="@tender.Title">
                                <span class="compare-tender-option-main"><span>@tender.Title</span></span>
                                <span class="compare-tender-option-meta"><small>@tender.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</small><small>@tender.EligibleOfferCount offer(s)</small></span>
                            </button>
                        }
                                <p class="compare-tender-no-results" data-tender-empty hidden>No tenders match your search.</p>
                            </div>
                        </div>
                    </div>
                    <button class="btn btn-brand" type="submit">Load comparison</button>
                </div>
            </form>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.PageMessage))
    {
        <div class="compare-message" role="status"><i class="bi bi-info-circle" aria-hidden="true"></i>@Model.PageMessage</div>
    }
    @if (TempData["ResendError"] is string resendError)
    {
        <div class="compare-message" role="alert"><i class="bi bi-exclamation-circle" aria-hidden="true"></i>@resendError</div>
    }

    @if (Model.SelectedTender is not null)
    {
        <section class="compare-tender-summary" aria-labelledby="selected-tender-heading">
            <div class="compare-tender-title">
                <span class="compare-eyebrow">@Model.SelectedTender.TenderNumber</span>
                <h2 id="selected-tender-heading">@Model.SelectedTender.Title</h2>
            </div>
            <div class="compare-tender-meta">
                <div><span>Tender status</span><partial name="_StatusBadge" model="Model.SelectedTender.Status" /></div>
                <div><span>Submission deadline</span><strong>@Model.SelectedTender.SubmissionDeadline.ToString("dd MMM yyyy, HH:mm 'UTC'")</strong></div>
                <div><span>Eligible submitted offers</span><strong>@Model.EligibleOfferCount</strong></div>
            </div>
        </section>

        <section class="compare-panel compare-resend-panel" aria-labelledby="resend-heading">
            <div class="compare-panel-heading">
                <div><span class="compare-step">↻</span><h2 id="resend-heading">Tender submission rounds</h2></div>
                <p>Only the suppliers selected during tender setup can be invited again.</p>
            </div>
            <dl class="compare-resend-stats">
                <div class="compare-resend-stat"><dt><i class="bi bi-inboxes" aria-hidden="true"></i>Offers received</dt><dd>@Model.SubmittedSupplierCount <small>distinct suppliers</small></dd></div>
                <div class="compare-resend-stat"><dt><i class="bi bi-arrow-repeat" aria-hidden="true"></i>Resend attempts</dt><dd>@Model.ResendsUsed <small>of @Model.MaxResends used</small></dd></div>
                <div class="compare-resend-note"><i class="bi bi-info-circle" aria-hidden="true"></i><span>Resending invites selected suppliers who have not submitted. The deadline stays the same.</span></div>
            </dl>
            <div class="compare-resend-action">
                @if (Model.CanResend)
                {
                    <form asp-area="Sourcing" asp-controller="Offers" asp-action="Resend" method="post" class="compare-resend-form">
                        <input type="hidden" name="tenderId" value="@Model.SelectedTender.Id" />
                        <input type="hidden" name="shownDeadline" value="@Model.SelectedTender.SubmissionDeadline.ToString("O")" />
                        <input type="hidden" name="shownResendsUsed" value="@Model.ResendsUsed" />
                        <button class="btn btn-brand" type="submit"><i class="bi bi-arrow-repeat me-2" aria-hidden="true"></i>Resend tender</button>
                        <span><strong>@Model.ResendableSupplierCount</strong> selected supplier(s) can be invited again.</span>
                    </form>
                }
                else if (!string.IsNullOrWhiteSpace(Model.ResendMessage))
                {
                    <p class="compare-resend-message" role="status"><i class="bi bi-info-circle" aria-hidden="true"></i><span>@Model.ResendMessage</span></p>
                }
            </div>
        </section>

        @if (Model.EligibleOfferCount > 0)
        {
            <section class="compare-panel compare-overview" aria-labelledby="comparison-overview-heading">
                <div class="compare-panel-heading">
                    <div><span class="compare-step">02</span><h2 id="comparison-overview-heading">Comparison overview</h2></div>
                    <p>Price summaries are separated by currency and describe submitted prices only.</p>
                </div>
                <dl class="compare-overview-metrics">
                    <div><dt><i class="bi bi-inboxes" aria-hidden="true"></i>Matching offers</dt><dd>@Model.MatchingOfferCount <small>of @Model.EligibleOfferCount eligible</small></dd></div>
                    <div><dt><i class="bi bi-buildings" aria-hidden="true"></i>Suppliers</dt><dd>@Model.SupplierCount</dd></div>
                    <div><dt><i class="bi bi-truck" aria-hidden="true"></i>Earliest delivery</dt><dd>@(Model.EarliestDeliveryDays.HasValue ? $"{Model.EarliestDeliveryDays} days" : "Not provided")</dd></div>
                    <div><dt><i class="bi bi-calendar2-check" aria-hidden="true"></i>Latest delivery</dt><dd>@(Model.LatestDeliveryDays.HasValue ? $"{Model.LatestDeliveryDays} days" : "Not provided")</dd></div>
                </dl>
                <div class="compare-price-summary">
                    @if (Model.CurrencySummaries.Count == 1)
                    {
                        var summary = Model.CurrencySummaries[0];
                        <div class="compare-single-price" aria-label="Submitted price summary">
                            <div class="compare-price-currency"><span>Currency · @summary.OfferCount offer(s)</span><strong>@(string.IsNullOrWhiteSpace(summary.Currency) ? "Not provided" : summary.Currency)</strong></div>
                            @if (summary.OfferCount == 1)
                            {
                                <div class="compare-single-price-value"><span>Submitted price</span><strong>@summary.LowestPrice.ToString("N2")</strong></div>
                            }
                            else
                            {
                                <div><span>Lowest</span><strong>@summary.LowestPrice.ToString("N2")</strong></div>
                                <div><span>Highest</span><strong>@summary.HighestPrice.ToString("N2")</strong></div>
                                <div><span>Average</span><strong>@summary.AveragePrice.ToString("N2")</strong></div>
                            }
                        </div>
                    }
                    else
                    {
                        <h3>Submitted prices by currency</h3>
                        <div class="compare-price-table-scroll" tabindex="0" role="region" aria-label="Price summary by currency">
                            <table class="table compare-price-table">
                                <thead><tr><th scope="col">Currency</th><th scope="col">Offers</th><th scope="col">Lowest</th><th scope="col">Highest</th><th scope="col">Average</th></tr></thead>
                                <tbody>
                                    @foreach (var summary in Model.CurrencySummaries)
                                    {
                                        <tr>
                                            <th scope="row">@(string.IsNullOrWhiteSpace(summary.Currency) ? "Not provided" : summary.Currency)</th>
                                            <td>@summary.OfferCount</td>
                                            <td>@summary.LowestPrice.ToString("N2")</td>
                                            <td>@summary.HighestPrice.ToString("N2")</td>
                                            <td>@summary.AveragePrice.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </section>

            <section class="compare-panel" aria-labelledby="filter-heading">
                <div class="compare-panel-heading">
                    <div><span class="compare-step">03</span><h2 id="filter-heading">Filter and sort offers</h2></div>
                    <p>Filters combine and keep the selected tender.</p>
                </div>

                @if (Model.FilterErrors.Count > 0)
                {
                    <div class="compare-validation" role="alert">
                        <strong>Review these filter values:</strong>
                        <ul>@foreach (var error in Model.FilterErrors) { <li>@error</li> }</ul>
                    </div>
                }

                <form method="get" asp-area="Sourcing" asp-controller="Offers" asp-action="Compare" class="compare-filter-form">
                    <input type="hidden" name="tenderId" value="@Model.SelectedTenderId" />
                    <div class="compare-primary-filters">
                        <div>
                            <label asp-for="Filters.SupplierName" class="form-label">Supplier</label>
                            <select asp-for="Filters.SupplierName" class="form-select">
                                <option value="">All suppliers</option>
                                @foreach (var supplier in Model.AvailableSuppliers)
                                {
                                    <option value="@supplier">@supplier</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label asp-for="Filters.BidStatus" class="form-label">Bid status</label>
                            <select asp-for="Filters.BidStatus" class="form-select">
                                <option value="">All eligible statuses</option>
                                <option value="@Statuses.BidStatus.Submitted">@Statuses.BidStatus.Submitted</option>
                                <option value="@Statuses.BidStatus.UnderReview">@Statuses.BidStatus.UnderReview</option>
                                <option value="@Statuses.BidStatus.Compliant">@Statuses.BidStatus.Compliant</option>
                                <option value="@Statuses.BidStatus.NonCompliant">@Statuses.BidStatus.NonCompliant</option>
                            </select>
                        </div>
                        <div>
                            <label asp-for="Filters.Currency" class="form-label">Currency</label>
                            <select asp-for="Filters.Currency" class="form-select">
                                <option value="">All currency groups</option>
                                @foreach (var currency in Model.AvailableCurrencies)
                                {
                                    <option value="@currency">@(currency == "__missing__" ? "Not provided" : currency)</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label asp-for="Filters.SortBy" class="form-label">Sort by</label>
                            <select asp-for="Filters.SortBy" class="form-select">
                                <option value="activity">Latest activity</option><option value="submitted">Submission date</option><option value="supplier">Supplier name</option><option value="price">Price within currency</option><option value="delivery">Delivery days</option><option value="validity">Offer validity</option><option value="compliance">Compliance result</option>
                            </select>
                        </div>
                    </div>

                    @{ var advancedFiltersActive = Model.Filters.ComplianceResult is not null || Model.Filters.MinimumPrice.HasValue || Model.Filters.MaximumPrice.HasValue || Model.Filters.MaximumDeliveryDays.HasValue || Model.Filters.MinimumValidityDays.HasValue || Model.Filters.HasDocuments.HasValue || Model.Filters.SubmittedFrom.HasValue || Model.Filters.SubmittedTo.HasValue || !Model.Filters.Descending; }
                    <details class="compare-advanced-filters" open="@(advancedFiltersActive || Model.FilterErrors.Count > 0 ? "open" : null)">
                        <summary><span><i class="bi bi-sliders2" aria-hidden="true"></i> More filters <small>Price, delivery, documents and dates</small></span><i class="bi bi-chevron-down compare-filter-chevron" aria-hidden="true"></i></summary>
                        <div class="compare-filter-grid">
                            <div>
                                <label asp-for="Filters.ComplianceResult" class="form-label">Latest compliance</label>
                                <select asp-for="Filters.ComplianceResult" class="form-select">
                                    <option value="">Any result</option>
                                    <option value="@Statuses.ComplianceResult.Compliant">@Statuses.ComplianceResult.Compliant</option>
                                    <option value="@Statuses.ComplianceResult.NonCompliant">@Statuses.ComplianceResult.NonCompliant</option>
                                    <option value="@Statuses.ComplianceResult.PendingClarification">@Statuses.ComplianceResult.PendingClarification</option>
                                    <option value="__none__">Not reviewed</option>
                                </select>
                            </div>
                            <div><label asp-for="Filters.MinimumPrice" class="form-label">Minimum price</label><select asp-for="Filters.MinimumPrice" class="form-select"><option value="">No minimum</option>@foreach (var price in Model.AvailablePrices){<option value="@price">@price.ToString("N2")</option>}</select></div>
                            <div><label asp-for="Filters.MaximumPrice" class="form-label">Maximum price</label><select asp-for="Filters.MaximumPrice" class="form-select"><option value="">No maximum</option>@foreach (var price in Model.AvailablePrices){<option value="@price">@price.ToString("N2")</option>}</select></div>
                            <div><label asp-for="Filters.MaximumDeliveryDays" class="form-label">Maximum delivery days</label><select asp-for="Filters.MaximumDeliveryDays" class="form-select"><option value="">Any delivery time</option>@foreach (var days in Model.AvailableDeliveryDays){<option value="@days">Up to @days days</option>}</select></div>
                            <div><label asp-for="Filters.MinimumValidityDays" class="form-label">Minimum offer validity</label><select asp-for="Filters.MinimumValidityDays" class="form-select"><option value="">Any validity</option>@foreach (var days in Model.AvailableValidityDays){<option value="@days">At least @days days</option>}</select></div>
                            <div>
                                <label asp-for="Filters.HasDocuments" class="form-label">Documents</label>
                                <select asp-for="Filters.HasDocuments" class="form-select"><option value="">Any</option><option value="true">Has documents</option><option value="false">No documents</option></select>
                            </div>
                            <div><label asp-for="Filters.SubmittedFrom" class="form-label">Submitted from</label><select asp-for="Filters.SubmittedFrom" class="form-select"><option value="">Any date</option>@foreach (var date in Model.AvailableSubmissionDates){<option value="@date.ToString("yyyy-MM-dd")">@date.ToString("dd MMM yyyy")</option>}</select></div>
                            <div><label asp-for="Filters.SubmittedTo" class="form-label">Submitted to</label><select asp-for="Filters.SubmittedTo" class="form-select"><option value="">Any date</option>@foreach (var date in Model.AvailableSubmissionDates){<option value="@date.ToString("yyyy-MM-dd")">@date.ToString("dd MMM yyyy")</option>}</select></div>
                            <div>
                                <label asp-for="Filters.Descending" class="form-label">Sort direction</label>
                                <select asp-for="Filters.Descending" class="form-select"><option value="true">Descending</option><option value="false">Ascending</option></select>
                            </div>
                        </div>
                    </details>

                    <div class="compare-filter-actions">
                        <button class="btn btn-brand" type="submit"><i class="bi bi-funnel me-2" aria-hidden="true"></i>Apply filters</button>
                        <a class="btn btn-outline-secondary" asp-area="Sourcing" asp-controller="Offers" asp-action="Compare" asp-route-tenderId="@Model.SelectedTenderId">Clear filters</a>
                    </div>
                </form>
            </section>

            <section class="compare-panel compare-results-panel" aria-labelledby="offers-heading">
                <div class="compare-panel-heading">
                    <div><span class="compare-step">04</span><h2 id="offers-heading">Offer comparison</h2></div>
                    <p>@Model.MatchingOfferCount matching offers · Prices remain grouped by currency.</p>
                </div>

                @if (Model.Offers.Count == 0)
                {
                    <div class="compare-empty"><i class="bi bi-search" aria-hidden="true"></i><div><strong>No offers match these filters</strong><p>Clear one or more filters to see offers for this tender.</p></div></div>
                }
                else
                {
                                        <div class="compare-table-scroll" tabindex="0" role="region" aria-label="Offer comparison table; scroll horizontally to view all fields">
                        <table class="table compare-offers-table">
                            <thead><tr>
                                <th scope="col">Supplier and offer</th><th scope="col">Submitted</th><th scope="col">Total price</th><th scope="col">Delivery</th><th scope="col">Compliance result</th><th scope="col">Documents</th><th scope="col">Details</th>
                            </tr></thead>
                            <tbody>
                                @foreach (var offer in Model.Offers)
                                {
                                    <tr class="compare-offer-row">
                                        <th scope="row">@offer.SupplierName<small class="compare-bid-number">Bid #@offer.Id</small></th>
                                        <td><time datetime="@offer.SubmittedAt.ToString("O")">@offer.SubmittedAt.ToString("dd MMM yyyy, HH:mm 'UTC'")</time></td>
                                        <td class="compare-price">@offer.TotalPrice.ToString("N2") <span>@(string.IsNullOrWhiteSpace(offer.Currency) ? "Not Provided" : offer.Currency)</span></td>
                                        <td><span>@(offer.DeliveryDays > 0 ? $"{offer.DeliveryDays} days delivery" : "Delivery not provided")</span><small class="compare-bid-number">@(offer.ValidityDays > 0 ? $"Valid for {offer.ValidityDays} days" : "Validity not provided")</small></td>
                                        <td>@if (string.IsNullOrWhiteSpace(offer.LatestComplianceResult)) { <span class="compare-muted">Not reviewed</span> } else { <partial name="_StatusBadge" model="offer.LatestComplianceResult" /> }</td>
                                        <td><span class="compare-muted">@offer.DocumentCount file(s)</span></td>
                                        <td><button type="button" class="compare-open-details" data-bs-toggle="modal" data-bs-target="#offerDetailsModal-@offer.Id"><i class="bi bi-card-text" aria-hidden="true"></i> Open details</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @foreach (var offer in Model.Offers)
                    {
                        var hasShippingDetails = offer.Items.Any(item => item.ShippingCost > 0);
                        var hasInstallationDetails = offer.Items.Any(item => item.InstallationCost is > 0);
                        var hasSampleImages = offer.Items.Any(item => item.SampleImages.Count > 0);
                        var hasItemAttachments = offer.Documents.Any(document => document.BidItemId.HasValue && document.DocType != "SampleImage");
                        var otherDocuments = offer.Documents
                            .Where(document => !document.BidItemId.HasValue && !document.BidGuaranteeId.HasValue)
                            .ToList();
                        <div class="modal fade compare-offer-modal" id="offerDetailsModal-@offer.Id" tabindex="-1" aria-labelledby="offerDetailsModalLabel-@offer.Id" aria-hidden="true">
                            <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <div><span class="compare-eyebrow">Supplier offer</span><h2 class="modal-title" id="offerDetailsModalLabel-@offer.Id">@offer.SupplierName</h2></div>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <div class="compare-detail-grid">
                                            <section class="compare-full-section">
                                                <div class="compare-detail-section-heading"><span>01</span><h3>Supplier and offer details</h3></div>
                                                <dl class="compare-detail-facts compare-offer-facts">
                                                    <div><dt>Tax registration number</dt><dd>@(string.IsNullOrWhiteSpace(offer.SupplierTaxNumber) ? "Not provided" : offer.SupplierTaxNumber)</dd></div>
                                                    <div><dt>Payment terms</dt><dd>@(string.IsNullOrWhiteSpace(offer.PaymentTerms) ? "Not provided" : offer.PaymentTerms)</dd></div>
                                                    <div class="compare-summary-fact"><dt>Technical summary</dt><dd>@(string.IsNullOrWhiteSpace(offer.TechnicalSummary) ? "Not provided" : offer.TechnicalSummary)</dd></div>
                                                </dl>
                                                <p class="compare-note">Supplier descriptions are shown as submitted. Technical scoring happens in evaluation.</p>
                                            </section>
                                            <section class="compare-full-section compare-guarantees-section">
                                                <div class="compare-detail-section-heading"><span>02</span><h3>Guarantees</h3></div>
                                                @if (offer.Guarantees.Count == 0)
                                                {
                                                    <p class="compare-muted">No guarantee details were provided.</p>
                                                }
                                                else
                                                {
                                                    <div class="compare-guarantee-list">
                                                        @foreach (var guarantee in offer.Guarantees)
                                                        {
                                                            var guaranteeName = guarantee.GuaranteeType;
                                                            if (guarantee.GuaranteeType == "BankGuarantee")
                                                                guaranteeName = "Bank guarantee";
                                                            else if (guarantee.GuaranteeType == "JudicialGuarantee")
                                                                guaranteeName = "Judicial guarantee";

                                                            <article class="compare-guarantee-card">
                                                                <div class="compare-guarantee-card-heading">
                                                                    <h4>@guaranteeName</h4>
                                                                    <strong>@guarantee.Amount.ToString("N2") @guarantee.Currency</strong>
                                                                </div>
                                                                <dl class="compare-detail-facts compare-guarantee-facts">
                                                                    <div><dt>Reference</dt><dd>@(string.IsNullOrWhiteSpace(guarantee.ReferenceNumber) ? "Not provided" : guarantee.ReferenceNumber)</dd></div>
                                                                    <div><dt>Issuer</dt><dd>@(string.IsNullOrWhiteSpace(guarantee.IssuerName) ? "Not provided" : guarantee.IssuerName)</dd></div>
                                                                    <div><dt>Beneficiary</dt><dd>@(string.IsNullOrWhiteSpace(guarantee.BeneficiaryName) ? "Not provided" : guarantee.BeneficiaryName)</dd></div>
                                                                    <div><dt>Issued</dt><dd>@(guarantee.IssuedAt?.ToString("dd MMM yyyy") ?? "Not provided")</dd></div>
                                                                    <div><dt>Expires</dt><dd>@(guarantee.ExpiresAt?.ToString("dd MMM yyyy") ?? "Not provided")</dd></div>
                                                                </dl>
                                                                @if (guarantee.Documents.Count > 0)
                                                                {
                                                                    <ul class="compare-document-list">
                                                                        @foreach (var document in guarantee.Documents)
                                                                        {
                                                                            <li><span><strong>@document.FileName</strong><small>Guarantee document · @document.UploadedAt.ToString("dd MMM yyyy")</small></span><a asp-area="Sourcing" asp-controller="Offers" asp-action="OfferDocument" asp-route-documentId="@document.Id" asp-route-tenderId="@Model.SelectedTenderId" target="_blank" rel="noopener noreferrer">Open securely <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a></li>
                                                                        }
                                                                    </ul>
                                                                }
                                                            </article>
                                                        }
                                                    </div>
                                                }
                                            </section>
                                            <section class="compare-full-section compare-other-documents-section">
                                                <div class="compare-detail-section-heading"><span>03</span><h3>Other submitted documents</h3></div>
                                                @if (otherDocuments.Count == 0)
                                                {
                                                    <p class="compare-muted">Offer-level attachments appear here. Item files are shown with their item, sample images appear in the item list, and guarantee documents appear with each guarantee.</p>
                                                }
                                                else
                                                {
                                                    <ul class="compare-document-list">
                                                        @foreach (var document in otherDocuments)
                                                        {
                                                            <li><span><strong>@document.FileName</strong><small>@document.DocType · @document.UploadedAt.ToString("dd MMM yyyy") · @((document.SizeBytes / 1024d).ToString("N0")) KB</small></span><a asp-area="Sourcing" asp-controller="Offers" asp-action="OfferDocument" asp-route-documentId="@document.Id" asp-route-tenderId="@Model.SelectedTenderId" target="_blank" rel="noopener noreferrer">Open securely <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a></li>
                                                        }
                                                    </ul>
                                                }
                                            </section>
                                            <section class="compare-item-section">
                                                <div class="compare-detail-section-heading"><span>04</span><h3>Items and offered specifications</h3></div>
                                                @if (offer.Items.Count == 0)
                                                {
                                                    <p class="compare-muted">No item details were provided.</p>
                                                }
                                                else
                                                {
                                                    <div class="compare-item-table-scroll"><table class="table compare-item-table">
                                                        <thead><tr>
                                                            <th>Requested item and specifications</th><th>Quantity (offered / requested)</th><th>Unit price</th>
                                                            <th>Tax</th>
                                                            @if (hasShippingDetails) { <th>Delivery and freight cost</th> }
                                                            @if (hasInstallationDetails) { <th>Installation</th> }
                                                            @if (hasSampleImages) { <th>Sample images</th> }
                                                            @if (hasItemAttachments) { <th>Item files</th> }
                                                            <th>Supplier's proposed specifications</th>
                                                        </tr></thead><tbody>
                                                        @foreach (var item in offer.Items)
                                                        {
                                                            <tr>
                                                                <th scope="row">@item.ItemName<small class="compare-bid-number">Required: @(string.IsNullOrWhiteSpace(item.RequestedSpecifications) ? "No specifications provided" : item.RequestedSpecifications)</small></th>
                                                                <td data-label="Quantity (offered / requested)">@item.Quantity.ToString("N2") / @item.RequestedQuantity.ToString("N2") @item.Unit</td>
                                                                <td data-label="Unit price">@item.UnitPrice.ToString("N2") @offer.Currency</td>
                                                                <td data-label="Tax">@item.TaxAmount.ToString("N2") @offer.Currency<small class="compare-bid-number">@item.TaxRate.ToString("0.##")% rate</small></td>
                                                                @if (hasShippingDetails) { <td data-label="Delivery and freight cost">@item.ShippingCost.ToString("N2") @offer.Currency</td> }
                                                                @if (hasInstallationDetails) { <td data-label="Installation">@item.InstallationCost.GetValueOrDefault().ToString("N2") @offer.Currency</td> }
                                                                @if (hasSampleImages)
                                                                {
                                                                    <td data-label="Sample images">
                                                                        @if (item.SampleImages.Count == 0)
                                                                        {
                                                                            <span class="compare-muted">None for this item</span>
                                                                        }
                                                                        else
                                                                        {
                                                                            <div class="compare-sample-images">
                                                                                @foreach (var image in item.SampleImages)
                                                                                {
                                                                                    <a href="@Url.Action("SampleImage", "Offers", new { area = "Sourcing", documentId = image.Id })" target="_blank" rel="noopener noreferrer" aria-label="View full sample image: @image.FileName">
                                                                                        <img src="@Url.Action("SampleImage", "Offers", new { area = "Sourcing", documentId = image.Id })" alt="Sample image for @item.ItemName" loading="lazy" />
                                                                                    </a>
                                                                                }
                                                                            </div>
                                                                        }
                                                                    </td>
                                                                }
                                                                @if (hasItemAttachments)
                                                                {
                                                                    <td data-label="Item files">
                                                                        @foreach (var document in offer.Documents.Where(document => document.BidItemId == item.Id && document.DocType != "SampleImage"))
                                                                        {
                                                                            <a class="compare-item-file-link" asp-area="Sourcing" asp-controller="Offers" asp-action="OfferDocument" asp-route-documentId="@document.Id" asp-route-tenderId="@Model.SelectedTenderId" target="_blank" rel="noopener noreferrer">@document.FileName <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a>
                                                                        }
                                                                        @if (!offer.Documents.Any(document => document.BidItemId == item.Id && document.DocType != "SampleImage"))
                                                                        {
                                                                            <span class="compare-muted">None</span>
                                                                        }
                                                                    </td>
                                                                }
                                                                <td data-label="Supplier's proposed specifications">@(string.IsNullOrWhiteSpace(item.OfferedSpecifications) ? "Not provided" : item.OfferedSpecifications)</td>
                                                            </tr>
                                                        }
                                                    </tbody></table></div>
                                                }
                                            </section>
                                        </div>
                                    </div>
                                    <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close details</button></div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </section>
        }
    }
</main>

@section Scripts {
    <script src="~/js/voice-search.js" asp-append-version="true" defer></script>
    <script src="~/js/compare-tender-picker.js" asp-append-version="true" defer></script>
    <script>
        // Bootstrap modals must be direct children of body. The page itself animates with transform,
        // which otherwise traps fixed-position dialogs inside the scrolling content column.
        document.querySelectorAll('.compare-offer-modal').forEach(modal => document.body.append(modal));
    </script>
}
