@model IReadOnlyList<TenderSystem.Data.Entities.Bids.Bid>
@{ ViewData["Title"] = "Compare offers"; }
@section Styles { <link rel="stylesheet" href="~/css/requester.css" asp-append-version="true" /> }
<div class="requester-dashboard requester-list-page">
    <h1 class="page-title">Compare offers</h1>
    <section class="requester-panel requester-list-panel mt-3">
        @if (Model.Count == 0)
        {
            <p class="mb-0">No submitted offers yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table requester-table">
                    <thead><tr><th>Tender</th><th>Supplier</th><th>Price</th><th>Delivery</th><th>Status</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var offer in Model)
                        {
                            <tr>
                                <td>@offer.Tender.Title</td><td>@offer.SupplierProfile.CompanyName</td>
                                <td>@offer.TotalPrice.ToString("N2") @offer.Currency</td>
                                <td>@offer.DeliveryDays days</td><td>@offer.Status</td>
                                <td><a asp-controller="Compliance" asp-action="Index" asp-route-tenderId="@offer.TenderId">Review compliance</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>