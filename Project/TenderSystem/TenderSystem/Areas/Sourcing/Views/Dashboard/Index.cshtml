@model TenderSystem.Areas.Sourcing.Models.SourcingDashboardViewModel
@{
    ViewData["Title"] = "Sourcing Dashboard";
    var search = Context.Request.Query["search"].ToString().Trim();
    var queues = new[]
    {
        new { Title = "Approved requests", Icon = "bi-clipboard-check", Count = Model.ApprovedRequestCount, Controller = "Requests", Action = "Index", Link = "View requests", Date = "Target date", Status = "Priority", Empty = "No approved requests to source.", Rows = Model.ApprovedRequests },
        new { Title = "Active tenders", Icon = "bi-megaphone", Count = Model.ActiveTenderCount, Controller = "Tenders", Action = "Index", Link = "View tenders", Date = "Submission deadline", Status = "Status", Empty = "No published or open tenders.", Rows = Model.ActiveTenders },
        new { Title = "Incoming offers", Icon = "bi-inbox", Count = Model.IncomingOfferCount, Controller = "Offers", Action = "Compare", Link = "Compare offers", Date = "Submitted", Status = "Status", Empty = "No submitted offers awaiting review.", Rows = Model.IncomingOffers }
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sourcing-dashboard.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/sourcing-dashboard-search.js" asp-append-version="true" defer></script>
}

<div class="ad sourcing-dashboard">
    <header class="sourcing-overview">
        <div>
            <h1 class="page-title mb-2">Sourcing Dashboard</h1>
            <p class="mb-0">Track approved requests, manage tenders, and follow supplier offers through evaluation.</p>
        </div>
        <a class="btn btn-brand" asp-action="Create" asp-controller="Tenders"><i class="bi bi-plus-lg me-2" aria-hidden="true"></i>Create tender</a>
    </header>

    <nav class="ad-kpis sourcing-kpis" aria-label="Sourcing statistics">
        @for (var index = 0; index < queues.Length; index++)
        {
            var queue = queues[index];
            <a class="ad-kpi" href="#sourcing-queue-@index" style="--i: @index">
                <span class="ad-kpi-icon"><i class="bi @queue.Icon" aria-hidden="true"></i></span>
                <span class="ad-kpi-body">
                    <span class="ad-kpi-label">@queue.Title</span>
                    <strong class="ad-kpi-value">@queue.Count.ToString("N0")</strong>
                </span>
                <i class="bi bi-arrow-down ad-kpi-go" aria-hidden="true"></i>
            </a>
        }
        <a class="ad-kpi" style="--i: 3" asp-controller="Tenders" asp-action="Suppliers">
            <span class="ad-kpi-icon"><i class="bi bi-envelope" aria-hidden="true"></i></span>
            <span class="ad-kpi-body">
                <span class="ad-kpi-label">Pending invitations</span>
                <strong class="ad-kpi-value">@Model.PendingInvitationCount.ToString("N0")</strong>
            </span>
            <i class="bi bi-arrow-up-right ad-kpi-go" aria-hidden="true"></i>
        </a>
    </nav>

    <form class="sourcing-search" method="get" asp-controller="Dashboard" asp-action="Index" role="search">
        <label class="visually-hidden" for="sourcing-search">Search sourcing queues</label>
        <div>
            <input id="sourcing-search" class="form-control" name="search" type="search" value="@search"
                   placeholder="Reference, title, department or supplier" />
            <button class="btn btn-brand" type="submit">Search</button>
            @if (!string.IsNullOrEmpty(search))
            {
                <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
            }
        </div>
    </form>
    <p class="visually-hidden" role="status" data-search-status></p>

    @for (var index = 0; index < queues.Length; index++)
    {
        var queue = queues[index];
        <section class="sourcing-queue" id="sourcing-queue-@index" aria-labelledby="sourcing-title-@index">
            <header>
                <h2 id="sourcing-title-@index">@queue.Title <span class="sourcing-queue-count"><span class="visually-hidden">Total: </span>@queue.Count.ToString("N0")</span></h2>
                <a asp-controller="@queue.Controller" asp-action="@queue.Action">@queue.Link <i class="bi bi-arrow-up-right ms-1" aria-hidden="true"></i></a>
            </header>
            <details class="sourcing-disclosure" open>
                <summary><span class="sourcing-hide">Hide list</span><span class="sourcing-show">Show list</span></summary>
            @if (queue.Rows.Count == 0)
            {
                <p class="sourcing-empty">@(string.IsNullOrEmpty(search) ? queue.Empty : "No records match your search in this list.")</p>
            }
            else
            {
                <div class="table-responsive" tabindex="0" role="region" aria-labelledby="sourcing-title-@index">
                    <table class="table align-middle mb-0">
                        <thead><tr><th scope="col">Reference</th><th scope="col">@queue.Date</th><th scope="col">@queue.Status</th></tr></thead>
                        <tbody>
                            @foreach (var row in queue.Rows)
                            {
                                <tr>
                                    <th scope="row"><span class="sourcing-reference">@row.Reference</span><span class="d-block">@row.Title</span><small>@row.Detail</small></th>
                                    <td><time datetime="@row.Date.ToString("yyyy-MM-dd")">@row.Date.ToString("dd MMM yyyy")</time></td>
                                    <td><span class="sourcing-status">@row.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (queue.Count > queue.Rows.Count)
                {
                    <p class="sourcing-empty">Showing @queue.Rows.Count of @queue.Count.ToString("N0") records.</p>
                }
            }
            </details>
        </section>
    }
</div>
