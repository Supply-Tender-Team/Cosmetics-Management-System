@model TenderSystem.Areas.Sourcing.Models.SourcingDashboardViewModel
@{
    ViewData["Title"] = "Sourcing Dashboard";
    var search = Context.Request.Query["search"].ToString().Trim();
    var cards = new[]
    {
        ("Approved requests", Model.ApprovedRequestCount, "bi-clipboard-check", "Ready to source"),
        ("Active tenders", Model.ActiveTenderCount, "bi-megaphone", "Published or open"),
        ("Incoming offers", Model.IncomingOfferCount, "bi-inbox", "Submitted or under review"),
        ("Pending invitations", Model.PendingInvitationCount, "bi-envelope", "Awaiting supplier response")
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/requester.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sourcing-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sourcing-requests.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/sourcing-dashboard-search.js" asp-append-version="true" defer></script>
    <script src="~/js/sourcing-requests.js" asp-append-version="true" defer></script>
    <script src="~/js/requester.js" asp-append-version="true" defer></script>
}

<div class="requester-dashboard sourcing-dashboard">
    <section class="requester-welcome">
        <div>
            <span class="requester-eyebrow">Sourcing · Department overview</span>
            <h1 class="page-title">Welcome to your workspace</h1>
            <p class="text-muted mb-0">Review purchase requests, manage tenders, and compare supplier offers.</p>
        </div>
        <img class="requester-title-art requester-dashboard-art" src="~/images/requester-cosmetics-crop.png" asp-append-version="true" alt="" />
        <a class="btn btn-brand" asp-controller="Tenders" asp-action="Create"><i class="bi bi-plus-lg me-2" aria-hidden="true"></i>Create tender</a>
    </section>

    <section class="requester-stats" aria-label="Sourcing statistics">
        @foreach (var (label, count, icon, description) in cards)
        {
            <article class="requester-stat-card">
                <div class="requester-stat-heading"><span>@label</span><i class="bi @icon" aria-hidden="true"></i></div>
                <strong class="requester-counter" data-count="@count">@count</strong>
                <p>@description</p>
            </article>
        }
    </section>

    <section class="requester-overview requester-reveal">
        <article class="requester-panel">
            <div class="requester-panel-heading"><div><h2>Purchase request status</h2><p>Submitted requests across departments</p></div></div>
            @foreach (var status in Model.RequestStatuses)
            {
                var percent = Model.SubmittedRequestTotal == 0 ? 0 : status.Count * 100 / Model.SubmittedRequestTotal;
                <div class="requester-status-row">
                    <div><span>@status.Label</span><strong>@status.Count</strong></div>
                    <div class="requester-progress-track" role="progressbar" aria-label="@status.Label" aria-valuenow="@percent">
                        <div class="requester-progress-fill @status.Style" style="width: @percent%"></div>
                    </div>
                </div>
            }
        </article>
        <article class="requester-panel requester-approval-panel">
            <div class="requester-panel-heading"><div><h2>Approval summary</h2><p>Purchase requests across departments</p></div></div>
            <div class="requester-approval-circle" style="--approval-percent: @Model.ApprovalPercent">
                <div class="requester-approval-inner">
                    <strong class="requester-approval-count" data-count="@Model.ApprovalPercent">@Model.ApprovalPercent%</strong>
                    <span>Approved</span>
                </div>
            </div>
            <p class="requester-approval-caption"><strong>@Model.ApprovedRequestTotal of @Model.SubmittedRequestTotal requests</strong><br />approved or converted to tenders</p>
            <a class="requester-text-link" asp-controller="Requests" asp-action="Index">Review incoming requests</a>
        </article>
    </section>

    <section class="requester-panel requester-table-panel requester-reveal">
        <div class="requester-panel-heading requester-heading-between">
            <div><h2>Recent purchase requests</h2><p>Latest submitted requests and their current status</p></div>
            <a class="requester-text-link" asp-controller="Requests" asp-action="Index">Incoming requests</a>
        </div>
        <form class="sourcing-search" method="get" asp-action="Index" role="search">
            <div>
                <input class="form-control" name="search" type="search" value="@search" aria-label="Search purchase requests" placeholder="Search requests" />
                <button class="btn btn-brand" type="submit">Search</button>
                @if (!string.IsNullOrEmpty(search))
                {
                    <a class="btn btn-outline-secondary" asp-action="Index">Clear</a>
                }
            </div>
        </form>
        <div class="d-flex justify-content-end mb-2">
            <button type="button" class="btn btn-sm btn-outline-secondary" id="recentRequestsToggle" aria-controls="recentRequestResults" aria-expanded="true">Hide table</button>
        </div>
        <div id="recentRequestResults" aria-live="polite">
        @if (Model.RecentRequests.Count == 0)
        {
            <div class="requester-empty-state"><i class="bi bi-inbox" aria-hidden="true"></i><p>No purchase requests found.</p></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table requester-table align-middle mb-0">
                    <thead><tr><th scope="col">Request ID</th><th scope="col">Title</th><th scope="col">Date</th><th scope="col">Priority</th><th scope="col">Status</th><th scope="col"><span class="visually-hidden">Action</span></th></tr></thead>
                    <tbody>
                    @foreach (var row in Model.RecentRequests)
                    {
                        var statusClass = row.Status.ToLowerInvariant().Replace(" ", "-");
                        var priorityClass = row.Priority.ToLowerInvariant();
                        <tr>
                            <td class="requester-request-number">@row.Reference</td>
                            <td class="requester-request-title">@row.Title</td>
                            <td>@row.Date.ToString("dd MMM yyyy")</td>
                            <td><span class="requester-priority priority-@priorityClass">@row.Priority</span></td>
                            <td><span class="badge badge-status requester-status status-@statusClass">@row.Status</span></td>
                            <td class="text-end"><a class="requester-view-link" asp-controller="Requests" asp-action="Review" asp-route-id="@row.Id" data-request-review aria-label="View @row.Reference"><i class="bi bi-eye" aria-hidden="true"></i></a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        </div>
    </section>
</div>
<partial name="../Requests/_ReviewModal" />
