@model TenderSystem.Areas.Sourcing.Models.EvaluationTrackingViewModel
@using TenderSystem.Infrastructure
@{
    ViewData["Title"] = "Evaluation Tracking";
    ViewData["PageSubtitle"] = "Track technical and financial evaluation progress, committee assignments, reports, and manager review.";
    var selectedTenderOption = Model.Tenders.FirstOrDefault(tender => tender.Id == Model.SelectedTenderId);
}

@section Styles {
    <link rel="stylesheet" href="~/css/requester.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/evaluation-tracking.css" asp-append-version="true" />
}

<main class="evaluation-tracking-page">
    <header class="tracking-header">
        <div>
            <span class="tracking-eyebrow">Sourcing workspace</span>
            <h1 class="page-title">Evaluation Tracking</h1>
            <p>Follow each tender’s evaluation progress from submitted bids through manager review.</p>
        </div>
    </header>

    <section class="tracking-stats" aria-label="Evaluation summary statistics">
        <article><span class="tracking-stat-icon"><i class="bi bi-megaphone" aria-hidden="true"></i></span><div><span>Active evaluation tenders</span><strong>@Model.Statistics.ActiveTenderCount</strong></div></article>
        <article><span class="tracking-stat-icon"><i class="bi bi-hourglass-split" aria-hidden="true"></i></span><div><span>Eligible bids</span><strong>@Model.Statistics.EligibleBidCount</strong></div></article>
        <article><span class="tracking-stat-icon"><i class="bi bi-check2-circle" aria-hidden="true"></i></span><div><span>Completed</span><strong>@Model.Statistics.CompletedBidEvaluations</strong></div></article>
        <article><span class="tracking-stat-icon"><i class="bi bi-arrow-repeat" aria-hidden="true"></i></span><div><span>In progress</span><strong>@Model.Statistics.InProgressBidEvaluations</strong></div></article>
        <article><span class="tracking-stat-icon"><i class="bi bi-clock" aria-hidden="true"></i></span><div><span>Pending</span><strong>@Model.Statistics.PendingBidEvaluations</strong></div></article>
        <article><span class="tracking-stat-icon"><i class="bi bi-file-earmark-check" aria-hidden="true"></i></span><div><span>Reports awaiting manager</span><strong>@Model.Statistics.ReportsAwaitingManagerReview</strong></div></article>
    </section>

    @if (TempData["EvaluationTrackingMessage"] is string successMessage)
    {
        <div class="tracking-notice tracking-notice-success" role="status"><i class="bi bi-check-circle" aria-hidden="true"></i>@successMessage</div>
    }
    @if (TempData["EvaluationTrackingError"] is string errorMessage)
    {
        <div class="tracking-notice tracking-notice-warning" role="alert"><i class="bi bi-exclamation-circle" aria-hidden="true"></i>@errorMessage</div>
    }

    <section class="tracking-panel tracking-tender-picker" aria-labelledby="tracking-tender-title">
        <div class="tracking-section-heading">
            <div><span class="tracking-step">01</span><div><h2 id="tracking-tender-title">Select a tender</h2><p>Choose a tender with evaluation activity to see its progress.</p></div></div>
        </div>
        @if (Model.Tenders.Count == 0)
        {
            <div class="tracking-empty"><i class="bi bi-inbox" aria-hidden="true"></i><div><strong>No evaluation activity yet</strong><p>Tenders appear here when they enter evaluation or have saved evaluation records.</p></div></div>
        }
        else
        {
            <form method="get" asp-area="Sourcing" asp-controller="Evaluation" asp-action="Index" class="tracking-tender-form">
                <label id="tracking-tender-label" class="form-label">Tender</label>
                <div class="tracking-tender-search-picker" data-tracking-tender-picker>
                    <input type="hidden" name="tenderId" value="@Model.SelectedTenderId" data-tracking-tender-value />
                    <button type="button" class="form-select tracking-tender-search-trigger" data-tracking-tender-trigger
                            aria-labelledby="tracking-tender-label" aria-haspopup="listbox" aria-expanded="false" aria-controls="tracking-tender-options">
                        <span data-tracking-tender-current>
                            @if (selectedTenderOption is not null)
                            {
                                <strong>@selectedTenderOption.Title</strong>
                                <small>@selectedTenderOption.TenderNumber · @selectedTenderOption.SubmittedBids submitted bids</small>
                            }
                            else
                            {
                                <strong class="is-placeholder">Choose a tender</strong>
                                <small>Search by tender name or number</small>
                            }
                        </span>
                        <i class="bi bi-chevron-down" aria-hidden="true"></i>
                    </button>
                    <div class="tracking-tender-search-menu" data-tracking-tender-menu hidden>
                        <div data-voice-search-scope="filter">
<div class="tracking-tender-search-box">
                            <i class="bi bi-search" aria-hidden="true"></i>
                            <input type="search" placeholder="Search tenders…" aria-label="Search tenders by name or number"
                                   data-tracking-tender-search autocomplete="off" data-voice-search-input />
                                <partial name="_SourcingVoiceSearchControls" />
                            </div>
                            <div class="form-text" role="status" aria-live="polite" data-voice-search-status></div>
                        </div>
                        <div id="tracking-tender-options" class="tracking-tender-search-options" role="listbox" aria-labelledby="tracking-tender-label" data-tracking-tender-options>
                            @foreach (var item in Model.Tenders)
                            {
                                var isSelected = Model.SelectedTenderId == item.Id;
                                <button type="button" class="tracking-tender-search-option @(isSelected ? "is-selected" : "")"
                                        role="option" aria-selected="@isSelected.ToString().ToLowerInvariant()" tabindex="-1"
                                        data-tracking-tender-option data-value="@item.Id"
                                        data-search="@item.TenderNumber @item.Title @item.Status">
                                    <span><strong>@item.Title</strong><small>@item.TenderNumber · @item.SubmittedBids submitted bids</small></span>
                                    <span class="tracking-tender-option-status">@item.Status</span>
                                </button>
                            }
                            <p class="tracking-tender-no-results" data-tracking-tender-empty hidden>No tenders match your search.</p>
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn btn-brand"><i class="bi bi-arrow-right-circle me-2" aria-hidden="true"></i>View progress</button>
            </form>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.Notice))
    {
        <div class="tracking-notice" role="status"><i class="bi bi-info-circle" aria-hidden="true"></i>@Model.Notice</div>
    }

    @if (Model.SelectedTender is not null)
    {
        <section class="tracking-tender-overview" aria-labelledby="selected-tender-heading">
            <div><span class="tracking-eyebrow">@Model.SelectedTender.TenderNumber</span><h2 id="selected-tender-heading">@Model.SelectedTender.Title</h2></div>
            <dl>
                <div><dt>Tender status</dt><dd><partial name="_StatusBadge" model="Model.SelectedTender.Status" /></dd></div>
                <div><dt>Submission deadline</dt><dd>@Model.SelectedTender.Deadline.ToString("dd MMM yyyy, HH:mm 'UTC'")</dd></div>
                <div><dt>Submitted bids</dt><dd>@Model.SelectedTender.SubmittedBidCount</dd></div>
                <div><dt>Eligible bids</dt><dd>@Model.SelectedTender.EligibleBidCount</dd></div>
            </dl>
        </section>

        <section class="tracking-outcome-banner" aria-label="Tender award outcome">
            @if (Model.SelectedTender.Status == Statuses.TenderStatus.Awarded
                && Model.SelectedTender.AwardedSupplierName is not null)
            {
                <span class="tracking-outcome-icon"><i class="bi bi-trophy" aria-hidden="true"></i></span>
                <div><span class="tracking-eyebrow">Final award recorded</span><strong>@Model.SelectedTender.AwardedSupplierName</strong><p>This supplier is the recorded winner. Other submitted offers were not selected.</p></div>
                <aside class="d-flex flex-wrap align-items-center gap-2" aria-label="Supplier result notifications">
                    <partial name="_StatusBadge" model="Model.SelectedTender.Status" />
                    @if (Model.SupplierResultsSent)
                    {
                        <span class="badge badge-status"><i class="bi bi-check2" aria-hidden="true"></i> Results sent</span>
                    }
                    else if (Model.CanManageSupplierResults)
                    {
                        <button type="button" class="btn btn-brand btn-sm" data-bs-toggle="modal" data-bs-target="#confirmSupplierResults">
                            <i class="bi bi-bell" aria-hidden="true"></i> Send supplier results
                        </button>
                    }
                </aside>
            }
            else if (Model.LatestReport?.ManagerSelectedSupplier is not null && Model.SelectedTender.Status == Statuses.TenderStatus.AwaitingCommitteeDecision)
            {
                <span class="tracking-outcome-icon"><i class="bi bi-award" aria-hidden="true"></i></span>
                <div><span class="tracking-eyebrow">Manager recommendation</span><strong>@Model.LatestReport.ManagerSelectedSupplier</strong><p>The manager sent this recommendation to the Top Committee. No final winner has been recorded yet.</p></div>
                <partial name="_StatusBadge" model="Model.SelectedTender.Status" />
            }
            else if (Model.SelectedTender.Status == Statuses.TenderStatus.Cancelled || Model.SelectedTender.Status == Statuses.TenderStatus.Rejected)
            {
                <span class="tracking-outcome-icon"><i class="bi bi-slash-circle" aria-hidden="true"></i></span>
                <div><span class="tracking-eyebrow">Tender closed without an award</span><strong>No winning offer recorded</strong><p>The tender was closed or rejected before an award was made.</p></div>
                <partial name="_StatusBadge" model="Model.SelectedTender.Status" />
            }
            else
            {
                <span class="tracking-outcome-icon"><i class="bi bi-hourglass" aria-hidden="true"></i></span>
                <div><span class="tracking-eyebrow">Final result</span><strong>No winner recorded yet</strong><p>Evaluation rankings are recommendations. A winning supplier appears here only after the authorized decision is saved.</p></div>
                <partial name="_StatusBadge" model="Model.SelectedTender.Status" />
            }
        </section>

        @if (Model.CanManageSupplierResults && !Model.SupplierResultsSent)
        {
            <div class="modal fade requester-details-modal" id="confirmSupplierResults" tabindex="-1"
                 aria-labelledby="confirmSupplierResultsTitle" aria-describedby="confirmSupplierResultsMessage">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h2 class="modal-title" id="confirmSupplierResultsTitle">Send supplier results?</h2>
                            <button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body" id="confirmSupplierResultsMessage">
                            <p><strong>@Model.SelectedTender.AwardedSupplierName</strong> will be notified that their offer won.</p>
                            <p class="mb-0">The other suppliers who submitted offers will receive a thank-you message letting them know their offers were not selected.</p>
                        </div>
                        <form class="modal-footer" asp-action="SendSupplierResults" method="post">
                            <input type="hidden" name="tenderId" value="@Model.SelectedTender.Id" />
                            <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Cancel</button>
                            <button class="btn btn-brand" type="submit">Send results</button>
                        </form>
                    </div>
                </div>
            </div>
        }

        @if (Model.SelectedTender.TechnicalCriteriaCount == 0)
        {
            <div class="tracking-notice tracking-notice-warning" role="note"><i class="bi bi-exclamation-circle" aria-hidden="true"></i>No technical evaluation criteria are configured for this tender. Technical completion cannot be established from the current data.</div>
        }

        <section id="evaluation-stages" class="tracking-panel" aria-labelledby="stage-progress-heading">
            <div class="tracking-section-heading">
                <div><span class="tracking-step">02</span><div><h2 id="stage-progress-heading">Evaluation stages</h2><p>Progress uses saved technical and financial evaluations, report status, and manager decisions.</p></div></div>
            </div>
            <div class="tracking-stage-list">
                @for (var stageIndex = 0; stageIndex < Model.Stages.Count; stageIndex++)
                {
                    var stage = Model.Stages[stageIndex];
                    var stageTone = stage.Status is "Completed" or "Sent" or "Approved" ? "is-complete" : stage.Status is "In Progress" or "Pending" or "Ready" or "Returned" ? "is-active" : "is-neutral";
                    int? progressPercent = stage.TotalCount > 0 ? Math.Min(100, (int)Math.Round(stage.CompletedCount * 100d / stage.TotalCount)) : null;
                    <article class="tracking-stage-row @stageTone">
                        <div class="tracking-stage-marker" aria-hidden="true"><span>@((stageIndex + 1).ToString("00"))</span></div>
                        <div class="tracking-stage-content">
                            <div class="tracking-stage-heading-row">
                                <div><h3>@stage.Name</h3><p class="tracking-stage-owner">@stage.Responsible</p></div>
                                <partial name="_StatusBadge" model="stage.Status" />
                            </div>
                            <p class="tracking-stage-details">@stage.Details</p>
                            @if (progressPercent.HasValue)
                            {
                                <div class="tracking-stage-progress-summary">
                                <div class="tracking-stage-progress-label"><span>Progress</span><strong>@stage.CompletedCount of @stage.TotalCount completed <span>(@(progressPercent.Value)%)</span></strong></div>
                                <div class="tracking-stage-progress" role="progressbar" aria-label="@stage.Name completion" aria-valuenow="@progressPercent.Value" aria-valuemin="0" aria-valuemax="100"><span style="width:@(progressPercent.Value)%"></span></div>
                                </div>
                            }
                            @if (stage.LastUpdated.HasValue)
                            {
                            <time class="tracking-updated" datetime="@stage.LastUpdated.Value.ToString("O")"><i class="bi bi-clock-history" aria-hidden="true"></i> Updated @stage.LastUpdated.Value.ToString("dd MMM yyyy, HH:mm 'UTC'")</time>
                            }
                            @if (stage.Name == "Unified evaluation report" && Model.CanSendReportToManager)
                            {
                            <form asp-area="Sourcing" asp-controller="Evaluation"
                                  asp-action="SendToManager" method="post" class="tracking-stage-action">
                                <input type="hidden" name="tenderId" value="@Model.SelectedTender!.Id" />
                                <button type="submit" class="btn btn-brand">
                                    <i class="bi bi-send-check me-2" aria-hidden="true"></i>
                                    Send full report to Sourcing Manager
                                </button>
                            </form>
                            }
                            else if (stage.Name == "Unified evaluation report"
                                && Model.SelectedTender!.Status == Statuses.TenderStatus.AwaitingManagerReview)
                            {
                            <span class="tracking-handoff-sent tracking-stage-action">
                                <i class="bi bi-check-circle me-1" aria-hidden="true"></i>
                                Sent to the Manager review queue
                            </span>
                            }
                        </div>
                    </article>
                }
            </div>
        </section>

        <section class="tracking-panel" aria-labelledby="criteria-heading">
            <div class="tracking-section-heading">
                <div><span class="tracking-step">03</span><div><h2 id="criteria-heading">Saved evaluation criteria</h2><p>These question names, maximum scores, and weights come from this tender’s saved setup.</p></div></div>
            </div>
            <div class="d-flex flex-wrap gap-2 mb-3" aria-label="Saved technical and financial total weights">
                <span class="badge badge-status">Technical total: @Model.SelectedTender.TechnicalWeight.ToString("0.##")%</span>
                <span class="badge badge-status">Financial total: @Model.SelectedTender.FinancialWeight.ToString("0.##")%</span>
            </div>
            @if (Model.EvaluationCriteria.Count == 0)
            {
                <div class="tracking-empty"><i class="bi bi-list-check" aria-hidden="true"></i><div><strong>No evaluation questions are saved</strong><p>Scoring progress will remain based on criteria that are actually recorded for this tender.</p></div></div>
            }
            else
            {
                <div class="tracking-table-scroll" tabindex="0" role="region" aria-label="Saved technical and financial evaluation questions">
                    <table class="table tracking-table">
                        <thead><tr><th scope="col">Type</th><th scope="col">Question</th><th scope="col">Weight</th><th scope="col">Maximum score</th></tr></thead>
                        <tbody>
                            @foreach (var criterion in Model.EvaluationCriteria)
                            {
                                <tr>
                                    <td data-label="Type">@(criterion.Type == Statuses.CriterionType.Technical ? "Technical" : "Financial")</td>
                                    <th scope="row" data-label="Question">@criterion.Name</th>
                                    <td data-label="Weight">@criterion.WeightPercent.ToString("0.##")%</td>
                                    <td data-label="Maximum score">@criterion.MaxScore</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="tracking-panel" aria-labelledby="committee-heading">
            <div class="tracking-section-heading">
                <div><span class="tracking-step">04</span><div><h2 id="committee-heading">Assigned committee members</h2><p>Member activity is derived from saved evaluations and approval records.</p></div></div>
            </div>
            @if (Model.CommitteeMembers.Count == 0)
            {
                <div class="tracking-empty"><i class="bi bi-people" aria-hidden="true"></i><div><strong>No committee assignments found</strong><p>Committee assignments have not been recorded for this tender.</p></div></div>
            }
            else
            {
                <div class="tracking-table-scroll" tabindex="0" role="region" aria-label="Committee member progress">
                    <table class="table tracking-table tracking-committee-table">
                        <colgroup><col style="width:30%" /><col style="width:25%" /><col style="width:45%" /></colgroup>
                        <thead><tr><th scope="col">Committee member</th><th scope="col">Role</th><th scope="col">Activity</th></tr></thead>
                        <tbody>
                            @foreach (var member in Model.CommitteeMembers)
                            {
                                <tr><th scope="row">@member.Name</th><td>@member.Role</td><td>@member.Activity</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="tracking-panel" aria-labelledby="bid-tracking-heading">
            <div class="tracking-section-heading tracking-heading-with-count">
                <div><span class="tracking-step">05</span><div><h2 id="bid-tracking-heading">Offer evaluation tracking</h2><p>Follow offer review progress. Price comparison happens separately on Compare Offers.</p></div></div>
                <span class="tracking-match-count">@Model.MatchingBidCount matching offers</span>
            </div>
            <form method="get" asp-area="Sourcing" asp-controller="Evaluation" asp-action="Index" class="tracking-filters">
                <input type="hidden" name="tenderId" value="@Model.SelectedTenderId" />
                <div>
                    <label asp-for="Filters.SupplierSearch" class="form-label">Search supplier</label>
                    <div class="tracking-supplier-picker" data-tracking-supplier-picker>
                        <input asp-for="Filters.SupplierSearch" type="hidden" data-tracking-supplier-value />
                        <button type="button" class="form-select tracking-supplier-trigger" data-tracking-supplier-trigger
                                aria-labelledby="Filters_SupplierSearch-label" aria-haspopup="listbox" aria-expanded="false" aria-controls="tracking-supplier-options">
                            <span data-tracking-supplier-current>
                                @if (!string.IsNullOrWhiteSpace(Model.Filters.SupplierSearch))
                                {
                                    <strong>@Model.Filters.SupplierSearch</strong><small>Selected supplier</small>
                                }
                                else
                                {
                                    <strong>All suppliers</strong><small>Select or search a supplier name</small>
                                }
                            </span>
                            <i class="bi bi-chevron-down" aria-hidden="true"></i>
                        </button>
                        <div class="tracking-supplier-menu" data-tracking-supplier-menu hidden>
                            <div data-voice-search-scope="filter">
<div class="tracking-supplier-search-box">
                                <i class="bi bi-search" aria-hidden="true"></i>
                                <input type="search" placeholder="Search supplier names…" aria-label="Search supplier names"
                                       data-tracking-supplier-search autocomplete="off" data-voice-search-input />
                                <partial name="_SourcingVoiceSearchControls" />
                            </div>
                            <div class="form-text" role="status" aria-live="polite" data-voice-search-status></div>
                        </div>
                            <div id="tracking-supplier-options" class="tracking-supplier-options" role="listbox" data-tracking-supplier-options>
                                <button type="button" class="tracking-supplier-option @(string.IsNullOrWhiteSpace(Model.Filters.SupplierSearch) ? "is-selected" : "")"
                                        role="option" aria-selected="@string.IsNullOrWhiteSpace(Model.Filters.SupplierSearch).ToString().ToLowerInvariant()" tabindex="-1"
                                        data-tracking-supplier-option data-value="" data-label="All suppliers" data-search="all suppliers">
                                    <strong>All suppliers</strong><small>No supplier filter</small>
                                </button>
                                @foreach (var supplier in Model.AvailableSuppliers)
                                {
                                    var isSupplierSelected = string.Equals(Model.Filters.SupplierSearch, supplier, StringComparison.OrdinalIgnoreCase);
                                    <button type="button" class="tracking-supplier-option @(isSupplierSelected ? "is-selected" : "")"
                                            role="option" aria-selected="@isSupplierSelected.ToString().ToLowerInvariant()" tabindex="-1"
                                            data-tracking-supplier-option data-value="@supplier" data-label="@supplier" data-search="@supplier">
                                        <strong>@supplier</strong>
                                    </button>
                                }
                                <p class="tracking-supplier-no-results" data-tracking-supplier-empty hidden>No suppliers match your search.</p>
                            </div>
                        </div>
                    </div>
                </div>
                <div><label asp-for="Filters.EvaluationStatus" class="form-label">Evaluation status</label><select asp-for="Filters.EvaluationStatus" class="form-select"><option value="">All statuses</option><option>Pending</option><option>In Progress</option><option>Completed</option><option>Awaiting compliance</option></select></div>
                <div><label asp-for="Filters.CommitteeMemberId" class="form-label">Committee member</label><select asp-for="Filters.CommitteeMemberId" class="form-select"><option value="">All members</option>@foreach (var member in Model.CommitteeMembers){<option value="@member.UserId">@member.Name · @member.Role</option>}</select></div>
                <div><label asp-for="Filters.ReportStatus" class="form-label">Report status</label><select asp-for="Filters.ReportStatus" class="form-select"><option value="">All report statuses</option>@foreach (var status in Model.Bids.Select(bid => bid.ReportStatus).Distinct()){<option value="@status">@status</option>}</select></div>
                <div class="tracking-filter-actions"><button type="submit" class="btn btn-brand"><i class="bi bi-funnel me-2" aria-hidden="true"></i>Filter</button><a class="btn btn-outline-secondary" asp-area="Sourcing" asp-controller="Evaluation" asp-action="Index" asp-route-tenderId="@Model.SelectedTenderId">Clear</a></div>
            </form>

            @if (Model.Bids.Count == 0)
            {
                <div class="tracking-empty"><i class="bi bi-search" aria-hidden="true"></i><div><strong>No offers match these filters</strong><p>Clear or adjust a filter to show submitted offers for this tender.</p></div></div>
            }
            else
            {
                <div class="tracking-table-scroll" tabindex="0" role="region" aria-label="Offer evaluation progress">
                    <table class="table tracking-table tracking-bid-table">
                        <colgroup><col style="width:15%" /><col style="width:10%" /><col style="width:17%" /><col style="width:17%" /><col style="width:11%" /><col style="width:12%" /><col style="width:18%" /></colgroup>
                        <thead><tr><th scope="col">Supplier and offer</th><th scope="col">Submitted</th><th scope="col">Technical review</th><th scope="col">Financial review</th><th scope="col">Overall progress</th><th scope="col">Final decision</th><th scope="col">More information</th></tr></thead>
                        <tbody>
                            @foreach (var bid in Model.Bids)
                            {
                                <tr>
                                    <th scope="row"><strong>@bid.SupplierName</strong><small>Offer #@bid.BidId</small></th>
                                    <td data-label="Submitted">@bid.SubmittedAt.ToString("dd MMM yyyy")</td>
                                    <td data-label="Technical review">
                                        <span>@bid.TechnicalStatus</span>
                                        @if (bid.TechnicalRequiredCriteria > 0)
                                        {
                                            <small>@bid.TechnicalCompletedMembers of @bid.RequiredCommitteeMembers members completed all criteria</small>
                                        }
                                        @if (bid.TechnicalAveragePoints.HasValue && Model.SelectedTender.TechnicalWeight > 0)
                                        {
                                            <small class="tracking-score-summary">Average: @bid.TechnicalAveragePoints.Value.ToString("0.##") / @Model.SelectedTender.TechnicalWeight.ToString("0.##") points (@bid.TechnicalPercentage?.ToString("0.#")%)</small>
                                        }
                                    </td>
                                    <td data-label="Financial review">
                                        <span>@bid.FinancialStatus</span>
                                        @if (bid.RequiredCommitteeMembers > 0)
                                        {
                                            <small>@bid.FinancialReadyMembers of @bid.RequiredCommitteeMembers marked Ready</small>
                                        }
                                        @if (bid.FinancialAveragePoints.HasValue && Model.SelectedTender.FinancialWeight > 0)
                                        {
                                            <small class="tracking-score-summary">Average: @bid.FinancialAveragePoints.Value.ToString("0.##") / @Model.SelectedTender.FinancialWeight.ToString("0.##") points (@bid.FinancialPercentage?.ToString("0.#")%)</small>
                                        }
                                    </td>
                                    <td data-label="Overall progress"><partial name="_StatusBadge" model="bid.OverallStatus" /></td>
                                    <td data-label="Final decision"><partial name="_StatusBadge" model="bid.OfferOutcome" /></td>
                                    <td data-label="More information">
                                        <details class="tracking-bid-details">
                                            <summary><i class="bi bi-card-text" aria-hidden="true"></i><span>Offer and decision details</span><i class="bi bi-chevron-right" aria-hidden="true"></i></summary>
                                            <div class="tracking-bid-detail-panel">
                                                <h3>@bid.SupplierName <small>Offer #@bid.BidId</small></h3>
                                                <div class="tracking-bid-detail-grid">
                                                    <div><span>Offer status</span><strong>@bid.BidStatus</strong></div>
                                                    <div><span>Compliance result</span><strong>@(bid.ComplianceResult ?? "Not reviewed")</strong></div>
                                                    <div><span>Technical review</span><strong>@bid.TechnicalStatus</strong>@if (bid.TechnicalAveragePoints.HasValue){<small>Average @bid.TechnicalAveragePoints.Value.ToString("0.##") / @Model.SelectedTender.TechnicalWeight points · @bid.TechnicalPercentage?.ToString("0.#")%</small>}<small>@bid.TechnicalCompletedMembers of @bid.RequiredCommitteeMembers committee members completed all criteria</small>@if (bid.TechnicalLastUpdated.HasValue){<small>Last scored @bid.TechnicalLastUpdated.Value.ToString("dd MMM yyyy")</small>}</div>
                                                    <div><span>Financial review</span><strong>@bid.FinancialStatus</strong>@if (bid.FinancialAveragePoints.HasValue){<small>Average @bid.FinancialAveragePoints.Value.ToString("0.##") / @Model.SelectedTender.FinancialWeight points · @bid.FinancialPercentage?.ToString("0.#")%</small>}<small>@bid.FinancialReadyMembers of @bid.RequiredCommitteeMembers marked Ready</small>@if (bid.FinancialLastUpdated.HasValue){<small>Last evaluated @bid.FinancialLastUpdated.Value.ToString("dd MMM yyyy")</small>}</div>
                                                    <div><span>Report</span><strong>@bid.ReportStatus</strong></div>
                                                    <div><span>Final decision</span><strong>@bid.OfferOutcome</strong></div>
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(bid.RejectionReason) || !string.IsNullOrWhiteSpace(bid.EligibilityNote))
                                                {
                                                    <div class="tracking-bid-detail-notes"><h4>Review notes</h4>
                                                        @if (!string.IsNullOrWhiteSpace(bid.RejectionReason))
                                                        {
                                                            <p><strong>Rejection reason:</strong> @bid.RejectionReason</p>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(bid.EligibilityNote))
                                                        {
                                                            <p><strong>@(bid.IsEligible ? "Committee notes:" : "Eligibility:")</strong> @bid.EligibilityNote</p>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                        </details>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </section>

        <section class="tracking-panel" aria-labelledby="report-heading">
            <div class="tracking-section-heading">
                <div><span class="tracking-step">06</span><div><h2 id="report-heading">Unified evaluation report</h2><p>Latest report status and manager decision history.</p></div></div>
            </div>
            @if (Model.LatestReport is null)
            {
                <div class="tracking-empty tracking-report-readiness"><i class="bi bi-file-earmark-plus" aria-hidden="true"></i><div><strong>Final report is not ready to send yet</strong><p>@Model.ReportReadinessMessage</p><span class="tracking-ready-count">Ready confirmations: @Model.ReadyConfirmationsCompleted of @Model.ReadyConfirmationsRequired</span></div></div>
            }
            else
            {
                <div class="tracking-report-header"><div><span class="tracking-eyebrow">Report #@Model.LatestReport.Id</span><h3>Prepared by @Model.LatestReport.PreparedBy</h3><p>Created @Model.LatestReport.CreatedAt.ToString("dd MMM yyyy, HH:mm 'UTC'") · @(Model.LatestReport.SubmittedAt.HasValue ? $"Submitted {Model.LatestReport.SubmittedAt.Value:dd MMM yyyy, HH:mm 'UTC'}" : "Not submitted")</p></div><partial name="_StatusBadge" model="Model.LatestReport.StatusLabel" /></div>
                <details class="tracking-report-modal">
                    <summary><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Read the full report</summary>
                    <div class="tracking-report-modal-content">
                        @await Component.InvokeAsync("EvaluationResultsReport", new { tenderId = Model.SelectedTender!.Id })
                    </div>
                </details>
                <div class="tracking-manager-decision">
                    <strong>Sourcing Manager review</strong>
                    <partial name="_StatusBadge" model="Model.LatestReport.ManagerStatus" />
                    <span>@(Model.LatestReport.ManagerDecisionAt?.ToString("dd MMM yyyy, HH:mm 'UTC'") ?? "No decision date")</span>
                    @if (!string.IsNullOrWhiteSpace(Model.LatestReport.ManagerSelectedSupplier))
                    {
                        <p>Manager-selected offer: @Model.LatestReport.ManagerSelectedSupplier</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.LatestReport.ManagerComment))
                    {
                        <p>@Model.LatestReport.ManagerComment</p>
                    }
                </div>
                <div class="tracking-report-handoff">
                    <div><strong>Clarification history</strong><span>@Model.ClarificationThreadCount thread(s) linked to this tender and its offers. The Manager review page includes their questions and replies.</span></div>
                    @if (Model.CanSendReportToManager)
                    {
                        <form asp-area="Sourcing" asp-controller="Evaluation" asp-action="SendToManager" method="post">
                            <input type="hidden" name="tenderId" value="@Model.SelectedTender.Id" />
                            <button type="submit" class="btn btn-brand"><i class="bi bi-send-check me-2" aria-hidden="true"></i>Send full report to Sourcing Manager</button>
                        </form>
                    }
                    else if (Model.SelectedTender.Status == Statuses.TenderStatus.AwaitingManagerReview)
                    {
                        <span class="tracking-handoff-sent"><i class="bi bi-check-circle me-1" aria-hidden="true"></i>Sent to the Manager review queue</span>
                    }
                </div>
                <p class="tracking-footnote">Sending makes the existing unified report available in Manager → Reports. It includes committee scores and notes, all submitted offer details, exclusions and compliance reasons; clarification threads are loaded into the same review page.</p>
            }
        </section>
    }
</main>

@section Scripts {
    <script src="~/js/voice-search.js" asp-append-version="true" defer></script>
    <script src="~/js/evaluation-tracking.js" asp-append-version="true" defer></script>
    <script>
        (() => {
            document.addEventListener('click', event => {
                const summary = event.target.closest('.tracking-report-modal > summary, .tracking-report-details > summary, .tracking-bid-details > summary');
                if (!summary || summary.closest('.tracking-bootstrap-modal') || !window.bootstrap?.Modal) return;
                event.preventDefault();
                const details = summary.parentElement;
                const source = details.querySelector(':scope > .tracking-report-modal-content, :scope > pre, :scope > .tracking-bid-detail-panel');
                if (!source) return;
                const modal = document.createElement('div');
                modal.className = 'modal fade tracking-bootstrap-modal';
                modal.tabIndex = -1;
                modal.setAttribute('aria-hidden', 'true');
                modal.innerHTML = `<div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5"></h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"></div></div></div>`;
                modal.querySelector('.modal-title').textContent = summary.textContent.trim();
                modal.querySelector('.modal-body').innerHTML = source.innerHTML;
                modal.querySelectorAll('details.tracking-report-details').forEach(item => item.classList.remove('tracking-report-details'));
                document.body.append(modal);
                modal.addEventListener('hidden.bs.modal', () => modal.remove(), { once: true });
                bootstrap.Modal.getOrCreateInstance(modal).show();
            });
        })();
    </script>
}
