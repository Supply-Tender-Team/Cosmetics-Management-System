@using TenderSystem.Infrastructure
@model TenderSystem.Areas.Sourcing.Models.CompliancePageViewModel

@{
    ViewData["Title"] = "Compliance Check";
    ViewData["PageSubtitle"] = "Review submitted offers and record your decision. Compliance is assessed manually by the Sourcing Officer.";
    var selectedTenderOption = Model.Tenders.FirstOrDefault(tender => tender.Id == Model.SelectedTenderId);
}

@section Styles {
    <link rel="stylesheet" href="~/css/compliance.css" asp-append-version="true" />
}

<div class="compliance-page">
    <partial name="_PageHeader" />
    <partial name="_Toast" />

    <section class="compliance-surface compliance-tender-picker" aria-labelledby="tender-picker-title">
        <div class="compliance-section-heading">
            <span class="compliance-step">01</span>
            <div>
                <h2 id="tender-picker-title">Choose a tender</h2>
                <p>Select a tender with submitted offers to begin the review.</p>
            </div>
        </div>

        @if (Model.Tenders.Count == 0)
        {
            ViewData["EmptyStateTitle"] = "No offers are ready for review";
            ViewData["EmptyStateMessage"] = "Submitted offers will appear here when they are available.";
            ViewData["EmptyStateIcon"] = "bi-inbox";
            <partial name="_EmptyState" />
        }
        else
        {
            <form asp-area="Sourcing" asp-controller="Compliance" asp-action="Index" method="get" class="compliance-tender-form">
                <span id="compliance-tender-label" class="form-label">Tender</span>
                <div class="compliance-tender-controls">
                    <div class="compliance-tender-search-picker" data-compliance-tender-picker>
                        <input type="hidden" name="tenderId" value="@Model.SelectedTenderId" data-compliance-tender-value />
                        <button type="button" class="form-select compliance-tender-search-trigger" data-compliance-tender-trigger
                                aria-labelledby="compliance-tender-label" aria-haspopup="listbox" aria-expanded="false" aria-controls="compliance-tender-list">
                            <span data-compliance-tender-current>
                                @if (selectedTenderOption is not null)
                                {
                                    <span class="compliance-tender-current-title">@selectedTenderOption.Title</span>
                                    <small>@selectedTenderOption.CreatedAt.ToLocalTime().ToString("dd MMM yyyy") · @selectedTenderOption.Status</small>
                                }
                                else
                                {
                                    <span class="compliance-tender-placeholder">Choose a tender</span>
                                    <small>Search by tender name</small>
                                }
                            </span>
                            <i class="bi bi-chevron-down" aria-hidden="true"></i>
                        </button>
                        <div class="compliance-tender-menu" data-compliance-tender-menu hidden>
                            <div data-voice-search-scope="filter">
<div class="compliance-tender-search-wrap">
                                <i class="bi bi-search" aria-hidden="true"></i>
                                <input type="search" class="compliance-tender-search" placeholder="Search tenders…"
                                       aria-label="Search tenders by name" data-compliance-tender-search autocomplete="off" data-voice-search-input />
                                <partial name="_SourcingVoiceSearchControls" />
                            </div>
                            <div class="form-text" role="status" aria-live="polite" data-voice-search-status></div>
                        </div>
                            <div class="compliance-tender-options" id="compliance-tender-list" role="listbox" aria-labelledby="compliance-tender-label" data-compliance-tender-options>
                        @foreach (var tender in Model.Tenders)
                        {
                            var selected = Model.SelectedTenderId == tender.Id;
                            <button type="button" class="compliance-tender-option @(selected ? "is-selected" : "")"
                                    role="option" aria-selected="@selected.ToString().ToLowerInvariant()" tabindex="-1"
                                    data-compliance-tender-option data-value="@tender.Id" data-search="@tender.Title">
                                <span class="compliance-tender-option-title">@tender.Title</span>
                                <span class="compliance-tender-option-meta"><small>@tender.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</small><small>@tender.Status</small></span>
                            </button>
                        }
                                <p class="compliance-tender-no-results" data-compliance-tender-empty hidden>No tenders match your search.</p>
                            </div>
                        </div>
                    </div>
                    <button class="btn btn-brand" type="submit">
                        <i class="bi bi-arrow-right-circle me-2" aria-hidden="true"></i>Load offers
                    </button>
                </div>
            </form>
        }
    </section>

    @if (Model.SelectedTender is not null)
    {
        var compliantOfferCount = Model.Bids.Count(bid => bid.Status == Statuses.BidStatus.Compliant);
        var offersAwaitingReview = Model.Bids.Count(bid => bid.Status is Statuses.BidStatus.Submitted or Statuses.BidStatus.UnderReview);
        var canSendToCommittee = compliantOfferCount > 0 && offersAwaitingReview == 0;
        <section class="compliance-tender-overview" aria-labelledby="selected-tender-title">
            <div class="compliance-tender-title">
                <span class="compliance-eyebrow">Selected tender</span>
                <h2 id="selected-tender-title">@Model.SelectedTender.Title</h2>
                <p>@Model.SelectedTender.TenderNumber</p>
            </div>
            <div class="compliance-tender-meta">
                <div>
                    <span class="compliance-meta-label">Tender status</span>
                    <partial name="_StatusBadge" model="Model.SelectedTender.Status" />
                </div>
                <div>
                    <span class="compliance-meta-label">Submission deadline</span>
                    <strong>@Model.SelectedTender.SubmissionDeadline.ToString("dd MMM yyyy, HH:mm 'UTC'")</strong>
                </div>
                <div>
                    <span class="compliance-meta-label">Offers in review</span>
                    <strong>@Model.Bids.Count</strong>
                </div>
            </div>
        </section>

        <div class="compliance-review-grid">
        <section class="compliance-send-guidance @(canSendToCommittee ? "is-ready" : "is-waiting")" aria-label="Send compliant offers to the evaluation committee">
            <div class="compliance-send-copy">
                <span class="compliance-send-icon" aria-hidden="true"><i class="bi @(canSendToCommittee ? "bi-people-fill" : "bi-hourglass-split")"></i></span>
                <div>
                    <strong>@(canSendToCommittee ? "Compliance review is complete" : "Finish the compliance review first")</strong>
                    <p>
                        @if (canSendToCommittee)
                        {
                            <text>@compliantOfferCount compliant offer(s) will be shared with the assigned evaluation committee. Non-compliant offers are excluded.</text>
                        }
                        else if (offersAwaitingReview > 0)
                        {
                            <text>@offersAwaitingReview offer(s) still need a final compliance decision. The committee button will be available when the review is complete and at least one offer is compliant.</text>
                        }
                        else
                        {
                            <text>No compliant offers are ready to send. Record a Compliant decision for an offer to continue.</text>
                        }
                    </p>
                </div>
            </div>
            <button class="btn btn-brand compliance-send-button" type="button" disabled="@(!canSendToCommittee)"
                    data-bs-toggle="modal" data-bs-target="#confirmComplianceCommitteeSend">
                <i class="bi bi-send-check me-2" aria-hidden="true"></i>Send to evaluation committee
            </button>
        </section>

        @if (canSendToCommittee)
        {
            <div class="modal fade" id="confirmComplianceCommitteeSend" tabindex="-1" aria-labelledby="confirmComplianceCommitteeSendTitle" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content compliance-send-modal">
                        <div class="modal-header">
                            <h2 class="modal-title" id="confirmComplianceCommitteeSendTitle">Send compliant offers?</h2>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <p>Send <strong>@Model.SelectedTender.TenderNumber · @Model.SelectedTender.Title</strong> and its <strong>@compliantOfferCount compliant offer(s)</strong> to the assigned evaluation committee?</p>
                            <p class="mb-0 text-muted">The committee will receive the evaluation brief and can begin its review.</p>
                        </div>
                        <form asp-area="Sourcing" asp-controller="Tenders" asp-action="SendToCommittee" asp-route-id="@Model.SelectedTender.Id" method="post" class="modal-footer">
                            <button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal">Not now</button>
                            <button class="btn btn-brand" type="submit"><i class="bi bi-send-check me-2" aria-hidden="true"></i>Send to committee</button>
                        </form>
                    </div>
                </div>
            </div>
        }

        <section class="compliance-surface compliance-terms" aria-labelledby="tender-terms-title">
            <div class="compliance-section-heading">
                <span class="compliance-section-icon" aria-hidden="true"><i class="bi bi-file-earmark-text"></i></span>
                <div>
                    <h2 id="tender-terms-title">Tender terms and conditions</h2>
                    <p>Review the tender’s original terms before recording a decision.</p>
                </div>
            </div>
            <details class="compliance-content-modal"><summary><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Read tender terms</summary><div class="compliance-modal-content">
            @if (!string.IsNullOrWhiteSpace(Model.SelectedTender.Description))
            {
                <p class="compliance-tender-description">@Model.SelectedTender.Description</p>
            }
            @if (string.IsNullOrWhiteSpace(Model.SelectedTender.Terms))
            {
                <div class="compliance-requirements-empty">No tender terms were entered for this tender.</div>
            }
            else
            {
                <div class="compliance-terms-text">@Model.SelectedTender.Terms</div>
            }
            </div></details>
        </section>

        <section class="compliance-surface" aria-labelledby="requirements-title">
            <div class="compliance-section-heading">
                <span class="compliance-section-icon" aria-hidden="true"><i class="bi bi-list-check"></i></span>
                <div>
                    <h2 id="requirements-title">Possible requirements found in tender terms</h2>
                    <p>Review tender-specific requirements here. Admin already checks supplier registration and tax documents.</p>
                </div>
            </div>

            <details class="compliance-content-modal"><summary><i class="bi bi-list-check" aria-hidden="true"></i> View detected requirements</summary><div class="compliance-modal-content">
            @if (string.IsNullOrWhiteSpace(Model.SelectedTender.Terms))
            {
                <div class="compliance-requirements-empty">This tender has no terms text to review.</div>
            }
            else if (Model.Requirements.Count == 0)
            {
                <div class="compliance-requirements-empty">No recognizable requirement wording was extracted. Review the full tender terms above manually.</div>
            }
            else
            {
                <div class="compliance-requirements-note">
                    This is a text search, not an automatic compliance decision. A file name does not prove that its contents meet a requirement.
                </div>
                <div class="compliance-requirements-list">
                    @for (var index = 0; index < Model.Requirements.Count; index++)
                    {
                        var requirement = Model.Requirements[index];
                        <article class="compliance-requirement-card">
                            <div class="compliance-requirement-heading">
                                <div>
                                    <span class="compliance-eyebrow">Potential requirement @(index + 1)</span>
                                    <h3>@requirement.Name</h3>
                                </div>
                                <span class="compliance-requirement-classification @(requirement.ReviewClassification == "Needs Manual Review" ? "is-review" : "is-explicit")">
                                    @requirement.ReviewClassification
                                </span>
                            </div>
                            <blockquote class="compliance-requirement-source">@requirement.SourceText</blockquote>
                            <div class="compliance-requirement-evidence">
                                <strong>Files that may be related</strong>
                                @if (Model.SelectedBid is null)
                                {
                                    <span>Select a bid to see its uploaded files.</span>
                                }
                                else if (requirement.RelatedDocuments.Count == 0)
                                {
                                    <span>No matching file name or type found. This is not proof that a required document is missing.</span>
                                }
                                else
                                {
                                    <span>
                                        @foreach (var document in requirement.RelatedDocuments)
                                        {
                                            <a asp-area="Sourcing" asp-controller="Offers" asp-action="OfferDocument"
                                               asp-route-documentId="@document.Id" asp-route-tenderId="@Model.SelectedTenderId"
                                               target="_blank" rel="noopener noreferrer">@document.FileName</a>
                                            @if (document != requirement.RelatedDocuments[^1])
                                            {
                                                <text>, </text>
                                            }
                                        }
                                    </span>
                                }
                            </div>
                            <label class="compliance-manual-status">
                                <span>Your quick check (not saved)</span>
                                <select class="form-select" aria-label="Temporary assessment for @requirement.Name">
                                    <option value="">Not reviewed</option>
                                    <option value="Met">Met</option>
                                    <option value="Not Met">Not Met</option>
                                    <option value="Needs Clarification">Needs Clarification</option>
                                </select>
                            </label>
                        </article>
                    }
                </div>
                <p class="compliance-temporary-note">These per-requirement selections are temporary on this page and are not saved. The overall decision and reason below are saved to the existing compliance review history.</p>
            }
            </div></details>
        </section>
        </div>

        <section class="compliance-surface" aria-labelledby="bids-title">
            <div class="compliance-section-heading">
                <span class="compliance-step">02</span>
                <div>
                    <h2 id="bids-title">Submitted offers</h2>
                    <p>Choose an offer, then record its result in the decision form below.</p>
                </div>
            </div>

            @if (Model.Bids.Count == 0)
            {
                ViewData["EmptyStateTitle"] = "No submitted offers for this tender";
                ViewData["EmptyStateMessage"] = "Offers appear here after suppliers submit them.";
                ViewData["EmptyStateIcon"] = "bi-inbox";
                <partial name="_EmptyState" />
            }
            else
            {
                <div class="compliance-offer-list" role="list">
                    @foreach (var bid in Model.Bids)
                    {
                        <article class="compliance-offer-row" role="listitem">
                            <div class="compliance-offer-supplier">
                                <span class="compliance-eyebrow">Offer · #@bid.Id</span>
                                <h3>@bid.SupplierName</h3>
                            </div>
                            <div class="compliance-offer-data"><span>Submitted</span><strong>@bid.SubmittedAt.ToString("dd MMM yyyy, HH:mm 'UTC'")</strong></div>
                            <div class="compliance-offer-data"><span>Latest compliance</span>
                                @if (string.IsNullOrWhiteSpace(bid.LatestComplianceResult))
                                {
                                    <strong class="compliance-no-review">Not reviewed</strong>
                                }
                                else
                                {
                                    <partial name="_StatusBadge" model="bid.LatestComplianceResult" />
                                }
                            </div>
                            <a class="btn btn-outline-brand btn-sm compliance-offer-review-button"
                               asp-area="Sourcing" asp-controller="Compliance" asp-action="Index"
                               asp-route-tenderId="@Model.SelectedTenderId" asp-route-bidId="@bid.Id" asp-fragment="decision-title">
                                Review <i class="bi bi-arrow-up-right ms-1" aria-hidden="true"></i>
                            </a>
                        </article>
                    }
                </div>
            }
        </section>

        @if (Model.SelectedBid is not null)
        {
            <section class="compliance-selected-bid" aria-labelledby="selected-bid-title">
                <div class="compliance-selected-heading">
                    <div>
                        <span class="compliance-eyebrow">Offer under review</span>
                        <h2 id="selected-bid-title">@Model.SelectedBid.SupplierName</h2>
                        <p>Bid #@Model.SelectedBid.Id · Submitted @Model.SelectedBid.SubmittedAt.ToString("dd MMM yyyy, HH:mm 'UTC'")</p>
                    </div>
                    <partial name="_StatusBadge" model="Model.SelectedBid.Status" />
                </div>

                <section class="compliance-surface compliance-item-coverage" aria-labelledby="item-coverage-title">
                    <div class="compliance-section-heading">
                        <span class="compliance-section-icon" aria-hidden="true"><i class="bi bi-list-check"></i></span>
                        <div>
                            <h3 id="item-coverage-title">Requested item coverage</h3>
                            <p>Compare the original request directly with the supplier’s response. The status only checks item and quantity coverage; specifications still need your judgment.</p>
                        </div>
                    </div>
                    @if (Model.SelectedBid.ItemCoverage.Count == 0)
                    {
                        <div class="compliance-requirements-empty">No request items are linked to this tender.</div>
                    }
                    else
                    {
                        <div class="compliance-table-wrap">
                            <table class="table compliance-coverage-table">
                                <colgroup><col style="width:15%" /><col style="width:14%" /><col style="width:21%" /><col style="width:32%" /><col style="width:18%" /></colgroup>
                                <thead><tr><th scope="col">Item</th><th scope="col">Requested quantity</th><th scope="col">Required specifications</th><th scope="col">Supplier response</th><th scope="col">Coverage check</th></tr></thead>
                                <tbody>
                                    @foreach (var item in Model.SelectedBid.ItemCoverage)
                                    {
                                        <tr>
                                            <th scope="row">@item.ItemName</th>
                                            <td>@item.RequestedQuantity.ToString("N2") @item.Unit</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.RequestedSpecifications) ? "No specific requirements" : item.RequestedSpecifications)</td>
                                            <td>
                                                @if (item.OfferedQuantity.HasValue)
                                                {
                                                    <strong>@item.OfferedQuantity.Value.ToString("N2") @item.Unit</strong>
                                                    <span class="d-block">@(string.IsNullOrWhiteSpace(item.OfferedSpecifications) ? "No specifications provided" : item.OfferedSpecifications)</span>
                                                }
                                                else
                                                {
                                                    <span>No matching item in offer</span>
                                                }
                                            </td>
                                            <td><span class="compliance-coverage-status">@item.Status</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    <div class="compliance-evidence-grid">
                        <section class="compliance-evidence-card" aria-labelledby="supplier-tax-title">
                            <div class="compliance-section-heading">
                                <span class="compliance-section-icon" aria-hidden="true"><i class="bi bi-building-check"></i></span>
                                <div>
                                    <h4 id="supplier-tax-title">Supplier registration and tax</h4>
                                    <p>Confirm the supplier identity documents are present and current.</p>
                                </div>
                            </div>
                            <dl class="compliance-evidence-facts">
                                <div><dt>Tax number</dt><dd>@(string.IsNullOrWhiteSpace(Model.SelectedBid.SupplierTaxNumber) ? "Not provided" : Model.SelectedBid.SupplierTaxNumber)</dd></div>
                                <div><dt>Commercial registration</dt><dd>@(string.IsNullOrWhiteSpace(Model.SelectedBid.CommercialRegNumber) ? "Not provided" : Model.SelectedBid.CommercialRegNumber)</dd></div>
                                <div><dt>Supplier approval</dt><dd><partial name="_StatusBadge" model="Model.SelectedBid.SupplierStatus" /></dd></div>
                            </dl>
                            @if (Model.SelectedBid.SupplierDocuments.Count == 0)
                            {
                                <p class="compliance-evidence-empty">No supplier registration or tax files are available.</p>
                            }
                            else
                            {
                                <ul class="compliance-evidence-files">
                                    @foreach (var document in Model.SelectedBid.SupplierDocuments)
                                    {
                                        <li>
                                            <span><strong>@document.DocType</strong><small>Uploaded @document.UploadedAt.ToString("dd MMM yyyy") · @(document.ExpiryDate.HasValue ? $"Expires {document.ExpiryDate.Value:dd MMM yyyy}" : "No expiry date recorded")</small></span>
                                            @if (document.IsExpired)
                                            {
                                                <span class="compliance-evidence-expired">Expired</span>
                                            }
                                            @if (document.CanPreview)
                                            {
                                                <a asp-area="Sourcing" asp-controller="Compliance" asp-action="SupplierDocument" asp-route-tenderId="@Model.SelectedTenderId" asp-route-bidId="@Model.SelectedBid.Id" asp-route-documentId="@document.Id" asp-route-inline="true" target="_blank" rel="noopener noreferrer">Open securely <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a>
                                            }
                                            else
                                            {
                                                <a asp-area="Sourcing" asp-controller="Compliance" asp-action="SupplierDocument" asp-route-tenderId="@Model.SelectedTenderId" asp-route-bidId="@Model.SelectedBid.Id" asp-route-documentId="@document.Id" asp-route-inline="false">Download securely <i class="bi bi-download" aria-hidden="true"></i></a>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </section>

                        <section class="compliance-evidence-card" aria-labelledby="guarantees-title">
                            <div class="compliance-section-heading">
                                <span class="compliance-section-icon" aria-hidden="true"><i class="bi bi-shield-check"></i></span>
                                <div>
                                    <h4 id="guarantees-title">Offer guarantees</h4>
                                    <p>Check the reference, expiry, and attached proof against the tender terms.</p>
                                </div>
                            </div>
                            @if (Model.SelectedBid.Guarantees.Count == 0)
                            {
                                <p class="compliance-evidence-empty">No guarantee was submitted with this offer. Check whether the tender requires one.</p>
                            }
                            else
                            {
                                <div class="compliance-guarantee-list">
                                    @foreach (var guarantee in Model.SelectedBid.Guarantees)
                                    {
                                        <article class="compliance-guarantee-card">
                                            <div class="compliance-guarantee-heading">
                                                <strong>@(guarantee.GuaranteeType == "BankGuarantee" ? "Bank guarantee" : guarantee.GuaranteeType == "JudicialGuarantee" ? "Judicial guarantee" : guarantee.GuaranteeType)</strong>
                                                @if (guarantee.IsExpired)
                                                {
                                                    <span class="compliance-evidence-expired">Expired</span>
                                                }
                                            </div>
                                            <dl class="compliance-evidence-facts">
                                                <div><dt>Reference</dt><dd>@(string.IsNullOrWhiteSpace(guarantee.ReferenceNumber) ? "Not provided" : guarantee.ReferenceNumber)</dd></div>
                                                <div><dt>Amount</dt><dd>@guarantee.Amount.ToString("N2") @guarantee.Currency</dd></div>
                                                <div><dt>Expires</dt><dd>@(guarantee.ExpiresAt?.ToString("dd MMM yyyy") ?? "No expiry date recorded")</dd></div>
                                            </dl>
                                            @if (guarantee.Documents.Count == 0)
                                            {
                                                <p class="compliance-evidence-empty">No guarantee file is attached.</p>
                                            }
                                            else
                                            {
                                                <ul class="compliance-evidence-files">
                                                    @foreach (var document in guarantee.Documents)
                                                    {
                                                        <li><span><strong>@document.FileName</strong><small>@document.DocType · @document.UploadedAt.ToString("dd MMM yyyy")</small></span><a asp-area="Sourcing" asp-controller="Offers" asp-action="OfferDocument" asp-route-documentId="@document.Id" asp-route-tenderId="@Model.SelectedTenderId" target="_blank" rel="noopener noreferrer">Open securely <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i></a></li>
                                                    }
                                                </ul>
                                            }
                                        </article>
                                    }
                                </div>
                            }
                        </section>
                    </div>
                    <section class="compliance-offer-terms" aria-labelledby="offer-terms-title">
                        <h4 id="offer-terms-title">Other offer conditions to verify</h4>
                        <dl class="compliance-offer-terms-grid">
                            <div><dt>Delivery period</dt><dd>@Model.SelectedBid.DeliveryDays days</dd></div>
                            <div><dt>Offer validity</dt><dd>@Model.SelectedBid.ValidityDays days</dd></div>
                            <div><dt>Payment terms</dt><dd>@(string.IsNullOrWhiteSpace(Model.SelectedBid.PaymentTerms) ? "Not provided" : Model.SelectedBid.PaymentTerms)</dd></div>
                        </dl>
                        <p>Check these values against the tender terms above. A value shown here is supplier-provided and is not automatically approved.</p>
                    </section>
                    <a class="btn btn-outline-brand align-self-start mt-3" asp-area="Sourcing" asp-controller="Offers" asp-action="Compare" asp-route-tenderId="@Model.SelectedTenderId">
                        <i class="bi bi-layout-text-sidebar-reverse me-2" aria-hidden="true"></i>Read more: full comparison, prices, tax, guarantees and sample images
                    </a>
                </section>
                <div class="compliance-detail-grid compliance-lower-grid">
                    <section class="compliance-surface" aria-labelledby="history-title">
                        <div class="compliance-section-heading">
                            <span class="compliance-section-icon" aria-hidden="true"><i class="bi bi-clock-history"></i></span>
                            <div>
                                <h3 id="history-title">Previous reviews</h3>
                                <p>Earlier decisions are retained as review history.</p>
                            </div>
                        </div>

                        <details class="compliance-history-modal"><summary><i class="bi bi-clock-history" aria-hidden="true"></i> View previous decisions</summary><div class="compliance-modal-content">
                        @if (Model.SelectedBid.Reviews.Count == 0)
                        {
                            ViewData["EmptyStateTitle"] = "No previous review";
                            ViewData["EmptyStateMessage"] = "Your decision will appear here after it is saved.";
                            ViewData["EmptyStateIcon"] = "bi-clock";
                            <partial name="_EmptyState" />
                        }
                        else
                        {
                            <ol class="compliance-history-list">
                                @foreach (var review in Model.SelectedBid.Reviews)
                                {
                                    <li>
                                        <div class="compliance-history-heading">
                                            <partial name="_StatusBadge" model="review.Result" />
                                            <time datetime="@review.CheckedAt.ToString("O")">@review.CheckedAt.ToString("dd MMM yyyy, HH:mm 'UTC'")</time>
                                        </div>
                                        <strong>@review.ReviewerName</strong>
                                        @if (!string.IsNullOrWhiteSpace(review.Reason))
                                        {
                                            <p>@review.Reason</p>
                                        }
                                    </li>
                                }
                            </ol>
                        }
                        </div></details>
                    </section>

                    <section class="compliance-surface compliance-decision" aria-labelledby="decision-title">
                        <div class="compliance-section-heading">
                            <span class="compliance-step">03</span>
                            <div>
                                <h3 id="decision-title">Record your decision</h3>
                                <p>Use the checks below as your decision basis. The system does not approve an offer automatically.</p>
                            </div>
                        </div>

                        <div class="compliance-decision-checklist">
                            <strong>Before accepting or rejecting this offer</strong>
                            <ul>
                                <li>Confirm every requested item is included and its quantity matches the request.</li>
                                <li>Compare the supplier’s proposed specifications with the requested specifications in Compare Offers.</li>
                                <li>Review the tender’s mandatory terms and check that required documents or guarantees have supporting evidence.</li>
                                <li>Check delivery, payment, and offer validity against the tender terms whenever they are specified.</li>
                            </ul>
                            <p>Price, tax amounts, guarantee details, and sample images are available in Compare Offers for reference.</p>
                        </div>

                        <form asp-area="Sourcing" asp-controller="Compliance" asp-action="Save" method="post">
                            <input asp-for="Decision.TenderId" type="hidden" />
                            <input asp-for="Decision.BidId" type="hidden" />
                            <div asp-validation-summary="ModelOnly" class="compliance-validation-summary" role="alert"></div>

                            <fieldset class="compliance-result-fieldset">
                                <legend>Overall compliance result</legend>
                                <div class="compliance-result-options">
                                    <label class="compliance-result-option" for="result-compliant">
                                        <input id="result-compliant" name="Decision.Result" type="radio" value="@Statuses.ComplianceResult.Compliant"
                                               checked="@(Model.Decision.Result == Statuses.ComplianceResult.Compliant ? "checked" : null)" />
                                        <span class="compliance-result-mark"><i class="bi bi-check2" aria-hidden="true"></i></span>
                                        <span><strong>Compliant</strong><small>Meets the reviewed requirements</small></span>
                                    </label>
                                    <label class="compliance-result-option" for="result-non-compliant">
                                        <input id="result-non-compliant" name="Decision.Result" type="radio" value="@Statuses.ComplianceResult.NonCompliant"
                                               checked="@(Model.Decision.Result == Statuses.ComplianceResult.NonCompliant ? "checked" : null)" />
                                        <span class="compliance-result-mark"><i class="bi bi-x-lg" aria-hidden="true"></i></span>
                                        <span><strong>Non-Compliant</strong><small>Does not meet a requirement</small></span>
                                    </label>
                                    <label class="compliance-result-option" for="result-pending">
                                        <input id="result-pending" name="Decision.Result" type="radio" value="@Statuses.ComplianceResult.PendingClarification"
                                               checked="@(Model.Decision.Result == Statuses.ComplianceResult.PendingClarification ? "checked" : null)" />
                                        <span class="compliance-result-mark"><i class="bi bi-question-lg" aria-hidden="true"></i></span>
                                        <span><strong>Pending Clarification</strong><small>More information is needed</small></span>
                                    </label>
                                </div>
                                <span asp-validation-for="Decision.Result" class="text-danger"></span>
                            </fieldset>

                            <div class="mt-4">
                                <label asp-for="Decision.Reason" class="form-label">Reason for this decision <span class="text-danger">(required)</span></label>
                                <textarea asp-for="Decision.Reason" class="form-control" rows="4" maxlength="1000"
                                          placeholder="State which requirement was met, missed, or needs clarification."></textarea>
                                <span asp-validation-for="Decision.Reason" class="text-danger"></span>
                            </div>

                            <button type="submit" class="btn btn-brand compliance-save-button">
                                <i class="bi bi-check2-circle me-2" aria-hidden="true"></i>Save compliance decision
                            </button>
                        </form>
                    </section>
                </div>
            </section>
        }
    }
</div>

@section Scripts {
    <script src="~/js/voice-search.js" asp-append-version="true" defer></script>
    <script src="~/js/compliance-tender-picker.js" asp-append-version="true" defer></script>
    <script>
        (() => {
            document.addEventListener('click', event => {
                const summary = event.target.closest('.compliance-content-modal > summary, .compliance-offer-modal > summary, .compliance-history-modal > summary');
                if (!summary || summary.closest('.compliance-bootstrap-modal') || !window.bootstrap?.Modal) return;
                event.preventDefault();
                const details = summary.parentElement;
                const source = details.querySelector(':scope > .compliance-modal-content');
                if (!source) return;
                const modal = document.createElement('div');
                modal.className = 'modal fade compliance-bootstrap-modal';
                if (summary.closest('.compliance-history-modal')) modal.classList.add('compliance-history-bootstrap-modal');
                modal.tabIndex = -1;
                modal.setAttribute('aria-hidden', 'true');
                modal.innerHTML = `<div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl"><div class="modal-content"><div class="modal-header"><h2 class="modal-title fs-5"></h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div><div class="modal-body"></div></div></div>`;
                modal.querySelector('.modal-title').textContent = summary.textContent.trim();
                modal.querySelector('.modal-body').innerHTML = source.innerHTML;
                document.body.append(modal);
                modal.addEventListener('hidden.bs.modal', () => modal.remove(), { once: true });
                bootstrap.Modal.getOrCreateInstance(modal).show();
            });
        })();
    </script>
}
