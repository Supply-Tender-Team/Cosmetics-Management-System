@model TenderSystem.Areas.Evaluation.Models.UnifiedReportViewModel
@{
    ViewData["Title"] = "Evaluation report";
}
@section Styles {
    <link rel="stylesheet" href="~/css/evaluation-feedback.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/evaluation-report.css" asp-append-version="true" />
}
<div class="evaluation-report">
    <header class="report-header">
        <div>
            <span class="report-eyebrow">Evaluation Committee</span>
            <h1 class="page-title">Evaluation report</h1>
            <p class="text-muted mb-0">One clear comparison of the committee’s results.</p>
        </div>
        @if(Model.TenderId.HasValue && Model.CanOpenOffers)
        {
            <a class="btn btn-outline-secondary report-navigation" asp-controller="Evaluation" asp-action="Offers" asp-route-id="@Model.TenderId">Back to offers</a>
        }
        else if(Model.TenderId.HasValue)
        {
            <a class="btn btn-outline-secondary report-navigation" asp-controller="Evaluation" asp-action="Index">Back to evaluation</a>
        }
    </header>
    <details class="report-picker" open="@(!Model.TenderId.HasValue)">
        <summary>@(Model.TenderId.HasValue ? "Change tender" : "Choose a tender")</summary>
        <form method="get" asp-action="Index" class="report-picker-form">
            <div class="flex-grow-1">
                <label class="form-label" for="report-tender">Assigned tender</label>
                <select class="form-select" id="report-tender" name="id" required>
                    <option value="">Select a tender</option>
                    @foreach(var tender in Model.Tenders)
                    {
                        <option value="@tender.Id" selected="@(Model.TenderId == tender.Id)">@tender.TenderNumber — @tender.Title</option>
                    }
                </select>
            </div>
            <button class="btn btn-brand" type="submit">View report</button>
        </form>
    </details>
    @if(Model.Tenders.Count == 0)
    {
        <div class="report-panel report-empty"><i class="bi bi-file-earmark-text" aria-hidden="true"></i><h2>No reports yet</h2><p class="text-muted mb-0">Your assigned tenders will appear here after Sourcing shares them with the committee.</p></div>
    }
    @if(TempData["ReportSaved"] is string message){<partial name="~/Areas/Evaluation/Views/Shared/_ActionFeedback.cshtml" model="message" />}
    @if(Model.TenderId.HasValue)
    {
        <partial name="~/Areas/Evaluation/Views/Report/_ReportContent.cshtml" model="Model" />
    }
</div>

@section Scripts { <script src="~/js/evaluation-feedback.js" asp-append-version="true"></script> }
