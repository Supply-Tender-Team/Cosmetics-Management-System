@model TenderSystem.Areas.Evaluation.Models.EvaluationFormViewModel
@{
    ViewData["Title"] = "Offer evaluation";
    var savedOfferCount = Model.ComparisonOffers.Count(o => o.HasSavedEvaluation);
    var readyOfferCount = Model.ComparisonOffers.Count(o => o.IsReady);
    var selectedIndex = Model.Members.FindIndex(m => m.IsSelected);
    var viewingOther = selectedIndex >= 0 && !Model.Members[selectedIndex].IsCurrentUser;
    var previousMember = Model.Members.Count > 1 ? Model.Members[(selectedIndex + Model.Members.Count - 1) % Model.Members.Count] : null;
    var nextMember = Model.Members.Count > 1 ? Model.Members[(selectedIndex + 1) % Model.Members.Count] : null;
    var nextOffer = Model.ComparisonOffers.FirstOrDefault(o => o.Id != Model.Input.BidId && !o.HasSavedEvaluation);
    var lowestOffers = Model.ComparisonOffers.Where(o => o.IsLowestPrice == true).ToList();
}
@section Styles {
    <link rel="stylesheet" href="~/css/evaluation-feedback.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/evaluation-workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/evaluation-assistant.css" asp-append-version="true" />
}
<div class="evaluation-workspace">
    <header class="ev-heading">
        <div>
            <a class="btn btn-outline-secondary" asp-controller="Evaluation" asp-action="Offers" asp-route-id="@Model.TenderId">All offers for @Model.TenderNumber</a>
            <h1 class="page-title mt-2">Offer evaluation</h1>
            <p class="text-muted mb-0">Choose an offer, then open your form or view a committee member's assessment.</p>
        </div>

    </header>

    <section class="ev-selected" aria-labelledby="selected-offer-title">
        <div><span class="ev-eyebrow">You are evaluating this offer</span><h2 id="selected-offer-title">@Model.CompanyName</h2><span>@Model.TenderNumber &middot; Offer #@Model.Input.BidId</span></div>
        <div class="ev-selected-price"><strong>@Model.TotalPrice.ToString("N2") @Model.Currency</strong><span>@Model.DeliveryDays-day delivery</span></div>
        <div><span class="badge badge-status">Passed compliance</span><p class="small mt-2 mb-0">@(Model.IsLowestPrice.HasValue ? (Model.IsLowestPrice.Value ? "Lowest eligible price (including ties)" : "A lower eligible price is available") : "Price comparison unavailable")</p></div>
    </section>

    <section class="ev-panel mb-4" aria-label="Your offer progress">
        <div class="ev-section-heading"><h2>Your offers</h2><span>@savedOfferCount / @Model.ComparisonOffers.Count saved</span></div>
        <nav class="ev-offer-nav" aria-label="Switch offer">
        @foreach (var offer in Model.ComparisonOffers)
        {
            <a class="ev-offer-link @(offer.Id == Model.Input.BidId ? "ev-offer-selected" : "")" asp-action="Edit" asp-route-id="@offer.Id" aria-current="@(offer.Id == Model.Input.BidId ? "page" : null)">
                <strong>@offer.CompanyName</strong><span>@(offer.IsReady ? "View · Locked" : offer.HasSavedEvaluation ? "Edit · Saved" : "Evaluate")</span>
                <span>@offer.TotalPrice.ToString("N2") @offer.Currency</span>
                @if (offer.IsLowestPrice == true)
                {
                    <span class="ev-lowest-price">✓ Lowest eligible price@(lowestOffers.Count > 1 ? " · Tied" : "")</span>
                }
            </a>
        }
        </nav>
        @if (savedOfferCount == Model.ComparisonOffers.Count && savedOfferCount > 0)
        { <p class="mt-3 mb-0">All your offers are saved. Return to <a asp-controller="Evaluation" asp-action="Offers" asp-route-id="@Model.TenderId">All offers</a> to confirm Ready.</p> }
    </section>

    @if (TempData["EvaluationSaved"] is string message)
    {
        <partial name="~/Areas/Evaluation/Views/Shared/_ActionFeedback.cshtml" model="message" />
    }
    @if (Model.ConfigurationMessage != null)
    {
        <div class="alert alert-warning">@Model.ConfigurationMessage</div>
    }
    <div class="row g-4">
        <aside class="col-lg-4 col-xl-3">
            <partial name="~/Areas/Evaluation/Views/Assessments/_OfferAssistant.cshtml" model="Model" />
        </aside>
        <div class="col-lg-8 col-xl-9" data-assessment-panel>
            <section class="ev-member-switcher ev-panel mb-4" aria-label="Browse committee assessments">
                <div class="ev-switcher-heading"><span class="ev-eyebrow">Committee assessments · @(selectedIndex + 1) of @Model.Members.Count</span><span class="ev-access-tag">@(viewingOther ? "Read-only · Other member" : Model.IsReadOnly ? "Your assessment · Locked" : "Your assessment · Editable")</span></div>
                <div class="ev-switcher-controls">
                    @if (previousMember != null) { <a class="ev-switch-arrow" data-member-nav asp-action="Edit" asp-route-id="@Model.Input.BidId" asp-route-evaluatorId="@previousMember.UserId" aria-label="Previous member: @previousMember.Name"><span aria-hidden="true">←</span><small>Previous member</small></a> }
                    <div class="ev-switcher-person"><h2>@Model.EvaluatorName</h2><p>@Model.CompanyName</p><small>Use the arrows to view another member’s assessment.</small></div>
                    @if (nextMember != null) { <a class="ev-switch-arrow" data-member-nav asp-action="Edit" asp-route-id="@Model.Input.BidId" asp-route-evaluatorId="@nextMember.UserId" aria-label="Next member: @nextMember.Name"><span aria-hidden="true">→</span><small>Next member</small></a> }
                </div>
                @if (viewingOther) { <a class="btn btn-brand mt-3" data-member-nav asp-action="Edit" asp-route-id="@Model.Input.BidId">Back to my assessment</a> }
            </section>
            @if (Model.IsSubmitted)
            {
                <p class="alert alert-info">The committee report has been sent to the Sourcing Officer. This form is read-only.</p>
            }
            @if (Model.ReadyAt.HasValue)
            {
                <p class="alert alert-info">This assessment was confirmed Ready at @Model.ReadyAt.Value.ToString("yyyy-MM-dd HH:mm") UTC and is locked.</p>
            }
            <details class="ev-panel mb-4">
                <summary>Review specifications, costs and attachments</summary>
                <p class="mt-3 text-muted">@Model.TechnicalSummary</p>
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead><tr><th scope="col">Item / specifications</th><th scope="col">Required / offered quantity</th><th scope="col">Unit price</th><th scope="col">Tax</th><th scope="col">Shipping</th><th scope="col">Installation</th></tr></thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr><th scope="row">@item.Name<span class="d-block fw-normal">Required: @item.RequiredSpecifications</span><span class="d-block fw-normal">Offered: @item.OfferedSpecifications</span></th><td>@item.RequiredQuantity.ToString("0.##") / @item.Quantity.ToString("0.##")</td><td>@item.UnitPrice.ToString("N2")</td><td>@item.TaxAmount.ToString("N2")</td><td>@item.ShippingCost.ToString("N2")</td><td>@item.InstallationCost.ToString("N2")</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="small text-muted">Amounts in @Model.Currency. Cost breakdown is already included in the supplier total.</p>
                <h3>Attachments</h3>
                @if (Model.Documents.Count == 0)
                {
                    <p class="text-muted mb-0">No attachments were provided.</p>
                }
                else
                {
                    <p class="text-muted">@Model.Documents.Count attachment(s). Open a category to review its files.</p>
                    @foreach (var group in Model.Documents.GroupBy(d => string.IsNullOrWhiteSpace(d.DocType) ? "Other attachments" : d.DocType))
                    {
                        <details class="ev-attachment-group">
                            <summary>@group.Key <span>(@group.Count())</span></summary>
                            <div class="ev-attachment-grid">
                            @foreach (var document in group)
                            {
                                <article class="ev-attachment">
                                    @if (document.IsImage)
                                    {
                                        <a asp-action="PreviewImage" asp-route-id="@document.Id" target="_blank" rel="noopener" aria-label="Open image @document.FileName in a new tab"><img src="@Url.Action("PreviewImage", new { id = document.Id })" alt="@document.FileName" loading="lazy" /></a>
                                    }
                                    else { <i class="bi bi-file-earmark-text" aria-hidden="true"></i> }
                                    <strong>@document.FileName</strong><small>@((document.SizeBytes / 1024m).ToString("0.#")) KB</small>
                                    <a class="btn btn-outline-secondary" asp-action="Download" asp-route-id="@document.Id">Download<span class="visually-hidden"> @document.FileName</span></a>
                                </article>
                            }
                            </div>
                        </details>
                    }

                }
            </details>
            <form method="post" asp-action="Save" data-evaluation-form data-editable="@(!Model.IsReadOnly ? "true" : "false")">
                <input type="hidden" asp-for="Input.BidId" />
                <div asp-validation-summary="All" class="text-danger" role="alert"></div>
                <fieldset disabled="@Model.IsReadOnly">
                    @foreach (var type in new[] { "Technical", "Financial" })
                    {
                        if (!Model.Input.Scores.Any(c => c.Type == type)) { continue; }
                        var weight = type == "Technical" ? Model.TechnicalWeight : Model.FinancialWeight;
                        var points = type == "Technical" ? Model.TechnicalPoints : Model.FinancialPoints;
                        var overallFinancial = type == "Financial" && Model.IsOverallFinancialAssessment;
                        <section class="ev-panel mb-4">
                            <div class="ev-section-heading"><h2>@type assessment</h2><span class="ev-weight">@weight.ToString("0.##") points</span></div>
                            @if (overallFinancial)
                            {
                                <p class="text-muted">Enter your overall financial score from 0 to 5. Financial weight: @weight.ToString("0.##")%.</p>
                                <details class="ev-price-reference mb-3">
                                    <summary><span aria-hidden="true">✦</span> Price reference <span class="ev-reference-toggle" aria-hidden="true">⌄</span></summary>
                                    <div class="ev-reference-content">
                                    <strong>Lowest eligible price@(lowestOffers.Count > 1 ? " · Tied" : "")</strong>
                                    @if (lowestOffers.Count > 0)
                                    {
                                        @foreach (var offer in lowestOffers)
                                        {
                                            <span class="d-block">@offer.CompanyName · @offer.TotalPrice.ToString("N2") @offer.Currency</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="d-block">Comparison unavailable. Prices must be eligible and comparable in one currency.</span>
                                    }
                                    <small class="d-block mt-2">Price is guidance only. You decide the financial score.</small>
                                    </div>
                                </details>
                                <details class="mb-3"><summary>How points are calculated</summary><p class="small mt-2">Your score ÷ 5 × @weight.ToString("0.##"). Example only: 4/5 earns @((weight * 4 / 5).ToString("0.##")) out of @weight.ToString("0.##") points.</p></details>
                            }
                            else
                            {
                                <p class="text-muted">Questions and weights are set by Sourcing. Enter a score for each question using the offer evidence.</p>
                            }
                            @for (var i = 0; i < Model.Input.Scores.Count; i++)
                            {
                                if (Model.Input.Scores[i].Type != type) { continue; }
                                <div class="ev-criterion">
                                    <input type="hidden" asp-for="Input.Scores[i].CriterionId" />
                                    <div class="ev-criterion-title"><label class="form-label ev-question" asp-for="Input.Scores[i].Score">@(overallFinancial ? "Overall financial score" : Model.Input.Scores[i].Name)</label><span class="ev-weight">@Model.Input.Scores[i].WeightPercent.ToString("0.##") points</span></div>
                                    <div class="ev-assessment-fields">
                                        <div class="ev-field ev-score-field">
                                            <label class="ev-field-label" asp-for="Input.Scores[i].Score">Score <small>/ @Model.Input.Scores[i].MaxScore</small></label>
                                            <input class="form-control" asp-for="Input.Scores[i].Score" type="number" min="0" max="@Model.Input.Scores[i].MaxScore" step="0.01" required />
                                            <span asp-validation-for="Input.Scores[i].Score" class="text-danger"></span>
                                        </div>
                                        <div class="ev-field ev-notes-field">
                                            <label class="form-label ev-field-label" asp-for="Input.Scores[i].Notes">Notes <small>Optional</small></label>
                                            <textarea class="form-control" asp-for="Input.Scores[i].Notes" rows="3" maxlength="1000" placeholder="Evidence or reason for your score"></textarea>
                                            <span asp-validation-for="Input.Scores[i].Notes" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>
                            }
                            <div class="ev-score-note">Saved @type.ToLowerInvariant() score: <strong>@(points.HasValue ? points.Value.ToString("0.##") + " / " + weight.ToString("0.##") : "Not fully scored")</strong><small class="d-block">Score ÷ maximum score × question weight. Price alone does not assign financial points.</small></div>
                        </section>
                    }
                    <section class="ev-panel mb-4">
                        <label asp-for="Input.FinancialNotes" class="form-label">Financial assessment notes <small>Optional</small></label>
                        <textarea class="form-control" asp-for="Input.FinancialNotes" rows="3" maxlength="1000"></textarea>
                        <span asp-validation-for="Input.FinancialNotes" class="text-danger"></span>
                    </section>
                </fieldset>
                @if (!Model.IsReadOnly)
                {
                    <div class="ev-panel ev-save-bar">
                        @if (nextOffer != null)
                        {
                            <a class="btn btn-outline-secondary mb-3" asp-action="Edit" asp-route-id="@nextOffer.Id">Next offer: @nextOffer.CompanyName</a>
                        }
                        <div class="d-flex gap-2 flex-wrap">
                            <button class="btn btn-outline-secondary" type="submit" asp-action="SaveDraft" formnovalidate disabled="@(Model.ConfigurationMessage != null)">Save Draft</button>
                            <button class="btn btn-brand" type="submit" asp-action="Save" disabled="@(Model.ConfigurationMessage != null || Model.FinancialMessage != null)">Save changes</button>
                        </div>
                        <p class="small text-muted mb-0 mt-2">Save Draft accepts unanswered questions. Save changes requires a complete form but keeps it editable.</p>
                        <p class="small text-muted mb-0" id="draft-note">Ready is confirmed once on All offers, after saving every offer. The report is sent only after all four recommendation choices are confirmed and one offer is selected.</p>
                    </div>
                }
            </form>
        </div>
    </div>
</div>

<dialog class="ev-dialog" id="ev-leave-form" aria-labelledby="ev-leave-title" aria-describedby="ev-leave-description">
    <div class="ev-dialog-head"><h2 id="ev-leave-title">Unsaved changes</h2></div>
    <div class="ev-dialog-body"><p id="ev-leave-description">Your changes have not been saved. Stay here to save them, or leave without saving.</p></div>
    <div class="ev-dialog-foot"><button type="button" class="btn btn-outline-secondary" data-ev-stay>Keep editing</button><button type="button" class="btn btn-brand" data-ev-leave>Leave without saving</button></div>
</dialog>
@section Scripts { <script src="~/js/evaluation-offer-assistant.js" asp-append-version="true"></script> <script src="~/js/evaluation-feedback.js" asp-append-version="true"></script><script src="~/js/evaluation-assessment.js" asp-append-version="true"></script> }
