@model TenderSystem.Areas.Evaluation.Models.EvaluationFormViewModel
<details class="ev-ai-disclosure" open><summary>✦ AI offer insights <small>Advisory</small></summary>
<section class="ev-ai-card" aria-labelledby="ev-ai-title" data-offer-assistant
    data-analyze-url="@Url.Action("Analyze", "OfferAssistant", new { area = "Evaluation", id = Model.TenderId })"
    data-current-url="@Url.Action("Current", "OfferAssistant", new { area = "Evaluation", id = Model.TenderId })">
    @Html.AntiForgeryToken()
    <header class="ev-ai-heading"><span class="ev-ai-spark" aria-hidden="true">✦</span><div><span class="ev-eyebrow">AI · Offer insights</span><h2 id="ev-ai-title">A second perspective</h2></div></header>
    <p class="ev-ai-scope">@Model.TenderNumber</p>
    <p>Compare this tender’s eligible offers against its requirements and weighted questions.</p>
    <button type="button" class="btn btn-brand w-100" data-advice-generate aria-describedby="ev-ai-availability">Analyze tender offers</button>
    <p id="ev-ai-availability" class="ev-ai-availability" role="status">Ready to compare the eligible offers.</p>
    <button type="button" class="btn btn-outline-secondary w-100" data-advice-cancel hidden>Cancel analysis</button>
    <div data-advice-result aria-live="polite"></div>
    <p class="ev-ai-preview-note">Your analysis will bring together a suggested offer, supporting reasons and points to review.</p>
    <details class="ev-ai-about"><summary>How this works</summary><p>Analysis uses eligible submitted offers, requirements and dynamic criteria. File names are included; file contents, pictures and scans are not read. Expand the result to compare alternatives.</p><p>AI advice does not fill scores, select your vote, confirm Ready or send the committee report.</p></details>
    <p class="ev-ai-disclaimer">Assistant only. The committee evaluates and decides.</p>
</section>

</details>
