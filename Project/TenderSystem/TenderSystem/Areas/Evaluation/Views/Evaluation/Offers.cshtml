@model TenderSystem.Areas.Evaluation.Models.EvaluationOffersViewModel
@{
    ViewData["Title"] = "Compare offers";
}
@section Styles {
    <link rel="stylesheet" href="~/css/evaluation-feedback.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/evaluation-workspace.css" asp-append-version="true" />
}
@section Scripts { <script src="~/js/evaluation-feedback.js" asp-append-version="true"></script> <script src="~/js/evaluation-recommendations.js" asp-append-version="true"></script> }
<div class="evaluation-workspace ev-offers-page">
    @if (TempData["EvaluationSaved"] is string message) { <partial name="~/Areas/Evaluation/Views/Shared/_ActionFeedback.cshtml" model="message" /> }
    <header class="ev-heading">
        <div>
            <h1 class="page-title mt-2">Choose an offer to evaluate</h1>
            <p class="text-muted mb-0">@Model.TenderNumber &middot; @Model.Title</p>
        </div>
        <span class="badge badge-status">@Model.Offers.Count eligible offers</span>
    </header>
    <section class="ev-panel mb-4">
        <div class="ev-brief-row">
            <div><h2>Review, then evaluate</h2><p class="text-muted mb-0">Read the tender requirements and weighted questions, then evaluate each offer below.</p></div>
            <a class="btn btn-brand ev-brief-button" asp-controller="Evaluation" asp-action="Brief" asp-route-id="@Model.TenderId"><i class="bi bi-file-earmark-text" aria-hidden="true"></i> Tender brief and criteria</a>
        </div>
    </section>
    <section class="ev-panel">
        <h2>Supplier comparison</h2>
        @if (Model.Offers.Count == 0)
        {
            <p class="text-muted py-3 mb-0" role="status">No eligible offers are available for this tender yet.</p>
        }
        else
        {
            <p class="text-muted">Only Compliant or Accepted offers are listed. Scores come from the committee’s entries against the saved technical and financial criteria. Price is optional guidance and never assigns a financial score automatically.</p>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th scope="col">Supplier</th><th scope="col">Supplier total</th><th scope="col">Delivery</th><th scope="col">Validity</th><th scope="col">Evaluation</th></tr></thead>
                    <tbody>
                        @foreach (var offer in Model.Offers)
                        {
                            <tr>
                                <th scope="row">@offer.CompanyName<span class="d-block small fw-normal">Offer #@offer.Id</span></th>
                                <td>@offer.TotalPrice.ToString("N2") @offer.Currency</td>
                                <td>@offer.DeliveryDays days</td><td>@offer.ValidityDays days</td>
                                <td><a class="btn @(offer.IsReady || offer.HasSavedEvaluation ? "btn-outline-secondary" : "btn-brand")" asp-controller="Assessments" asp-action="Edit" asp-route-id="@offer.Id">@(offer.IsReady ? "View" : offer.HasSavedEvaluation ? "Edit" : "Evaluate")<span class="visually-hidden"> for @offer.CompanyName</span></a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
    @if (Model.Recommendation != null) { <partial name="_Recommendation" model="Model.Recommendation" /> }
    <partial name="~/Areas/Evaluation/Views/Shared/_ConfirmDialog.cshtml" />
</div>
