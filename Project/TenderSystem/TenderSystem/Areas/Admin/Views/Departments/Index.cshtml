@model TenderSystem.Areas.Admin.Models.DepartmentsPageViewModel
@{
    ViewData["Title"] = "Departments Management";
}

@section Styles {
    <link rel="stylesheet" href="~/css/departments.css" asp-append-version="true" />
}

<div class="departments-page">
    <div class="department-heading d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="page-title mb-1">Departments Management</h1>
            <p class="text-muted mb-0">Manage company departments, add new ones, update information, or deactivate them.</p>
        </div>
        <button type="button" class="btn btn-brand department-add" data-bs-toggle="modal" data-bs-target="#departmentModal" data-department-add>Add Department</button>
    </div>

    @if (TempData["DepartmentSuccess"] is string success)
    {
        <div class="alert department-alert" role="status">@success</div>
    }
    @if (TempData["DepartmentError"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <section class="department-panel p-3 p-md-4">
        <form method="get" asp-action="Index" class="row g-3 align-items-end department-filters">
            <div class="col-12 col-md-7">
                <label for="departmentSearch" class="form-label">Search by name or code</label>
                <input id="departmentSearch" type="search" name="search" value="@Model.Search" class="form-control" placeholder="Search departments" />
            </div>
            <div class="col-8 col-md-3">
                <label for="departmentStatus" class="form-label">Status</label>
                <select id="departmentStatus" name="status" class="form-select">
                    <option value="All" selected="@(Model.Status == "All")">All</option>
                    <option value="Active" selected="@(Model.Status == "Active")">Active</option>
                    <option value="Inactive" selected="@(Model.Status == "Inactive")">Inactive</option>
                </select>
            </div>
            <div class="col-4 col-md-2"><button class="btn btn-outline-brand w-100" type="submit">Apply</button></div>
        </form>

        @if (Model.Departments.Count == 0)
        {
            <div class="department-empty text-center"><p class="mb-2">No departments found</p><span>Try a different search or status filter.</span></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle department-table mb-0">
                    <thead><tr><th scope="col">#</th><th scope="col">Name</th><th scope="col">Code</th><th scope="col">Members Count</th><th scope="col">Status</th><th scope="col">Actions</th></tr></thead>
                    <tbody>
                    @for (var i = 0; i < Model.Departments.Count; i++)
                    {
                        var department = Model.Departments[i];
                        <tr>
                            <td>@(i + 1)</td>
                            <td class="fw-semibold">@department.Name</td>
                            <td>@department.Code</td>
                            <td>@department.MembersCount</td>
                            <td><span class="department-status @(department.IsActive ? "is-active" : "is-inactive")">@(department.IsActive ? "Active" : "Inactive")</span></td>
                            <td>
                                <div class="d-flex flex-wrap gap-2">
                                    <button type="button" class="btn btn-sm btn-outline-brand" data-bs-toggle="modal" data-bs-target="#departmentModal"
                                            data-department-edit data-id="@department.Id" data-name="@department.Name" data-code="@department.Code">Edit</button>
                                    <form asp-action="SetActive" method="post" class="m-0" data-status-form data-action-label="@(department.IsActive ? "deactivate" : "reactivate")" data-department-name="@department.Name">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@department.Id" />
                                        <input type="hidden" name="isActive" value="@(department.IsActive ? "false" : "true")" />
                                        <input type="hidden" name="search" value="@Model.Search" />
                                        <input type="hidden" name="status" value="@Model.Status" />
                                        <button type="submit" class="btn btn-sm @(department.IsActive ? "btn-outline-secondary" : "btn-brand")">@(department.IsActive ? "Deactivate" : "Reactivate")</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

<div class="modal fade" id="departmentModal" tabindex="-1" aria-labelledby="departmentModalTitle" aria-hidden="true" data-open-on-load="@Model.OpenForm.ToString().ToLowerInvariant()">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content department-modal">
            <form asp-action="Save" method="post" id="departmentForm">
                @Html.AntiForgeryToken()
                <input asp-for="Form.Id" type="hidden" id="departmentId" />
                <input type="hidden" name="search" value="@Model.Search" />
                <input type="hidden" name="status" value="@Model.Status" />
                <div class="modal-header"><h2 class="modal-title" id="departmentModalTitle">Add Department</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                <div class="modal-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                    <div class="mb-3">
                        <label asp-for="Form.Name" class="form-label">Department Name</label>
                        <input asp-for="Form.Name" id="departmentName" class="form-control" maxlength="100" required />
                        <span asp-validation-for="Form.Name" class="text-danger"></span>
                    </div>
                    <div>
                        <label asp-for="Form.Code" class="form-label">Code</label>
                        <input asp-for="Form.Code" id="departmentCode" class="form-control" maxlength="20" required />
                        <span asp-validation-for="Form.Code" class="text-danger"></span>
                    </div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-brand">Save Department</button></div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/departments.js" asp-append-version="true"></script>
}
