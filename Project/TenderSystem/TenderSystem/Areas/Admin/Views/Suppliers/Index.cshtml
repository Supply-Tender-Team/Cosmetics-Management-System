@model TenderSystem.Areas.Admin.Models.SuppliersPageViewModel
@{
    ViewData["Title"] = "Supplier Registrations";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-chrome.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/suppliers-admin.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-modal.css" asp-append-version="true" />
    <style>
        .suppliers-page .suppliers-counts > div, .suppliers-page .suppliers-panel { transition: border-color .18s ease-out; }
        @@media (hover: hover) and (pointer: fine) {
            .suppliers-page .suppliers-counts > div:hover, .suppliers-page .suppliers-panel:hover { border-color: var(--dusty-rose); }
        }
        @@media (prefers-reduced-motion: reduce) {
            .suppliers-page .suppliers-counts > div, .suppliers-page .suppliers-panel { transition: none; }
        }

        /* Status totals use the same quiet border and shadow feedback as other static Admin cards. */
        .suppliers-page .suppliers-counts > div {
            transition: border-color .2s ease-out, box-shadow .2s ease-out;
        }
        @@media (prefers-reduced-motion: no-preference) {
            .suppliers-page .suppliers-counts > div {
                animation: suppliers-card-in .36s cubic-bezier(.2, .7, .2, 1) backwards;
                animation-delay: calc(var(--i, 0) * 45ms);
            }
            @@keyframes suppliers-card-in { from { opacity: 0; transform: translateY(10px) scale(.985); } }
        }
        @@media (hover: hover) and (pointer: fine) {
            .suppliers-page .suppliers-counts > div:hover {
                border-color: var(--dusty-rose);
                box-shadow: 0 2px 4px color-mix(in srgb, var(--deep-brown) 6%, transparent), 0 12px 26px color-mix(in srgb, var(--deep-brown) 11%, transparent);
            }
        }
        /* The current filter is identified by its label, without changing card geometry or surface. */
        .suppliers-page .suppliers-counts > div.is-current span { color: var(--burgundy); font-weight: 700; }
        @@media (prefers-reduced-motion: reduce) {
            .suppliers-page .suppliers-counts > div { animation: none; transition: none; }
        }
    </style>
}

@* data-modal-refresh: after a decision in the review modal, this block is reloaded from the same URL (filters kept). *@
<section class="suppliers-page" data-modal-refresh>
    <header class="suppliers-heading">
        <h1 class="page-title">Supplier Registrations</h1>
        <p>Review supplier information and track registration status.</p>
    </header>

    @{
        // --i drives the entrance stagger; is-current marks the card of the active Status filter.
        var statusCards = new[]
        {
            (Status: "All", Count: Model.TotalCount),
            (Status: "Pending", Count: Model.PendingCount),
            (Status: "Approved", Count: Model.ApprovedCount),
            (Status: "Rejected", Count: Model.RejectedCount),
            (Status: "Suspended", Count: Model.SuspendedCount),
        };
    }
    <div class="suppliers-counts" aria-label="Supplier status counts">
        @for (var cardIndex = 0; cardIndex < statusCards.Length; cardIndex++)
        {
            var card = statusCards[cardIndex];
            var isCurrent = Model.Status == card.Status;
            <div class="@(isCurrent ? "is-current" : null)" style="--i: @cardIndex" aria-current="@(isCurrent ? "true" : null)"><span>@card.Status</span><strong>@card.Count</strong></div>
        }
    </div>

    <div class="suppliers-panel">
        <form method="get" asp-action="Index" class="suppliers-filters">
            <div>
                <label for="supplierSearch" class="form-label">Search company or email</label>
                <div class="d-flex gap-2">
                    <input id="supplierSearch" name="search" type="search" value="@Model.Search" class="form-control" placeholder="Search suppliers" data-voice-search-input />
                    <button type="button" class="btn btn-outline-brand" aria-label="Start voice search" aria-pressed="false" data-voice-search-button><i class="bi bi-mic" aria-hidden="true"></i></button>
                </div>
                <div class="form-text" role="status" aria-live="polite" data-voice-search-status></div>
            </div>
            <div>
                <label for="supplierStatus" class="form-label">Status</label>
                <select id="supplierStatus" name="status" class="form-select">
                    <option value="All" selected="@(Model.Status == "All")">All</option>
                    <option value="Pending" selected="@(Model.Status == "Pending")">Pending</option>
                    <option value="Approved" selected="@(Model.Status == "Approved")">Approved</option>
                    <option value="Rejected" selected="@(Model.Status == "Rejected")">Rejected</option>
                    <option value="Suspended" selected="@(Model.Status == "Suspended")">Suspended</option>
                </select>
            </div>
            <button type="submit" class="btn btn-outline-brand">Apply Filters</button>
        </form>

        @if (Model.Suppliers.Count == 0)
        {
            <div class="suppliers-empty"><strong>No suppliers found</strong><p>Try a different search or status filter.</p></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0 suppliers-table">
                    <colgroup><col style="width: 22%" /><col style="width: 21%" /><col style="width: 13%" /><col style="width: 13%" /><col style="width: 18%" /><col style="width: 13%" /></colgroup>
                    <thead><tr><th scope="col">Company</th><th scope="col">Email</th><th scope="col">Registered</th><th scope="col">Status</th><th scope="col">Review information</th><th scope="col">Action</th></tr></thead>
                    <tbody>
                    @foreach (var supplier in Model.Suppliers)
                    {
                        <tr>
                            <td class="fw-semibold">@supplier.CompanyName</td>
                            <td class="suppliers-email">@supplier.Email</td>
                            <td><time datetime="@supplier.CreatedAt.ToString("O")">@supplier.CreatedAt.ToString("dd MMM yyyy")</time></td>
                            <td><span class="suppliers-status status-@supplier.Status.ToLowerInvariant()">@supplier.Status</span></td>
                            <td>
                                @if (supplier.ReviewedAt.HasValue)
                                {
                                    <span>@supplier.ReviewedAt.Value.ToString("dd MMM yyyy")</span>
                                    @if (!string.IsNullOrWhiteSpace(supplier.ReviewedBy)) { <small>by @supplier.ReviewedBy</small> }
                                }
                                else { <span class="suppliers-muted">Not reviewed</span> }
                            </td>
                            <td><a asp-action="Review" asp-route-id="@supplier.Id" class="btn btn-sm btn-outline-brand" data-admin-modal>Review</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script src="~/js/admin-modal.js" asp-append-version="true"></script>
    <script src="~/js/voice-search.js" asp-append-version="true"></script>
}
