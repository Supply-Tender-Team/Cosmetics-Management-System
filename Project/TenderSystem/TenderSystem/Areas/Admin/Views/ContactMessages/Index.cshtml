@model TenderSystem.Areas.Admin.Models.ContactMessagesPageViewModel
@using System.Globalization
@using Microsoft.AspNetCore.Html
@{
    ViewData["Title"] = "Contact Messages";

    var tabs = new[]
    {
        (Key: "all", Label: "All", Count: Model.AllCount),
        (Key: "unread", Label: "Unread", Count: Model.UnreadCount),
        (Key: "read", Label: "Read", Count: Model.ReadCount),
    };

    // Summary cards always show the whole inbox (they ignore the search box).
    var stats = new[]
    {
        (Key: "all", Label: "Total Messages", Count: Model.TotalMessages, Icon: "bi-envelope-paper-heart", Index: 0),
        (Key: "unread", Label: "Unread Messages", Count: Model.TotalUnread, Icon: "bi-envelope-fill", Index: 1),
        (Key: "read", Label: "Read Messages", Count: Model.TotalRead, Icon: "bi-envelope-open", Index: 2),
    };

    // Page numbers to show: first, last and two on each side of the current page ("0" = a gap).
    var pages = new List<int>();
    for (var p = 1; p <= Model.PageCount; p++)
    {
        if (p == 1 || p == Model.PageCount || Math.Abs(p - Model.Page) <= 2) pages.Add(p);
        else if (pages.Count > 0 && pages[^1] != 0) pages.Add(0);
    }
}

@functions {
    // Two letters for the avatar circle, e.g. "Layla Hassan" -> "LH".
    private static string Initials(string name)
    {
        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        var letters = parts.Length == 1 ? parts[0][..1] : $"{parts[0][0]}{parts[^1][0]}";
        return letters.ToUpperInvariant();
    }

    // Same sender always gets the same avatar tone (0-3).
    private static int Tone(string email) => email.ToLowerInvariant().Sum(c => c) % 4;

    // Short time label. Dates are stored in UTC.
    private static string When(DateTime utc)
    {
        var today = DateTime.UtcNow.Date;
        if (utc.Date == today) return utc.ToString("HH:mm", CultureInfo.InvariantCulture);
        if (utc.Date == today.AddDays(-1)) return "Yesterday";
        return utc.ToString(utc.Year == today.Year ? "d MMM" : "d MMM yyyy", CultureInfo.InvariantCulture);
    }

    // Wraps the searched words in <mark>. The text itself is still HTML-encoded by Append().
    private static IHtmlContent Highlight(string text, string? term)
    {
        var html = new HtmlContentBuilder();
        if (string.IsNullOrEmpty(term)) return html.Append(text);

        var position = 0;
        while (true)
        {
            var index = text.IndexOf(term, position, StringComparison.OrdinalIgnoreCase);
            if (index < 0) { html.Append(text[position..]); break; }
            html.Append(text[position..index]);
            html.AppendHtml("<mark>").Append(text.Substring(index, term.Length)).AppendHtml("</mark>");
            position = index + term.Length;
        }
        return html;
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-chrome.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/contact-admin.css" asp-append-version="true" />
    <style>
        .inbox .inbox-panel, .inbox .inbox-empty { transition: border-color .18s ease-out; }
        @@media (hover: hover) and (pointer: fine) {
            .inbox .inbox-panel:hover, .inbox .inbox-empty:hover { border-color: var(--dusty-rose); }
        }
        @@media (prefers-reduced-motion: reduce) {
            .inbox .inbox-panel, .inbox .inbox-empty { transition: none; }
        }
    </style>
}

<section class="inbox">
    <header class="inbox-header">
        <div>
            <p class="inbox-eyebrow">MS.WAND</p>
            <h1 class="page-title">Contact Us</h1>
            <p class="inbox-intro">Messages sent through the public Contact Us page. Read each one, then mark it once it has been handled.</p>
        </div>
        @if (Model.TotalUnread > 0)
        {
            <span class="inbox-unread-pill"><span class="inbox-pulse" aria-hidden="true"></span>@Model.TotalUnread unread @(Model.TotalUnread == 1 ? "message" : "messages")</span>
        }
        else if (!Model.InboxIsEmpty)
        {
            <span class="inbox-calm-pill"><i class="bi bi-check2-all" aria-hidden="true"></i>All messages read</span>
        }
    </header>

    @if (!Model.InboxIsEmpty)
    {
        <section class="inbox-stats" aria-label="Inbox summary">
            @foreach (var card in stats)
            {
                <a class="inbox-stat @(Model.Filter == card.Key && Model.Search == null ? "is-current" : "")" style="--i: @card.Index"
                   asp-action="Index" asp-route-filter="@(card.Key == "all" ? null : card.Key)" asp-route-sort="@Model.SortRoute"
                   aria-label="@card.Label: @card.Count. Show these messages">
                    <span class="inbox-stat-icon" aria-hidden="true"><i class="bi @card.Icon"></i></span>
                    <span class="inbox-stat-text">
                        <span class="inbox-stat-label">@card.Label</span>
                        <strong class="inbox-stat-number">@card.Count.ToString("#,0", CultureInfo.InvariantCulture)</strong>
                    </span>
                </a>
            }
        </section>
    }

    @if (Model.InboxIsEmpty)
    {
        <div class="inbox-empty">
            <span class="inbox-empty-icon" aria-hidden="true"><i class="bi bi-envelope-open-heart"></i></span>
            <h2>Your inbox is quiet</h2>
            <p>Messages sent from the public Contact Us page will appear here.</p>
        </div>
    }
    else
    {
        <div class="inbox-panel">
            <div class="inbox-toolbar">
                <nav class="inbox-tabs" aria-label="Filter messages">
                    @foreach (var tab in tabs)
                    {
                        var isCurrent = Model.Filter == tab.Key;
                        <a class="inbox-tab @(isCurrent ? "is-current" : "")" data-inbox-nav
                           aria-current="@(isCurrent ? "page" : null)"
                           asp-action="Index" asp-route-q="@Model.Search" asp-route-filter="@(tab.Key == "all" ? null : tab.Key)" asp-route-sort="@Model.SortRoute">
                            @tab.Label <span class="inbox-tab-count">@tab.Count</span>
                        </a>
                    }
                </nav>

                <form class="inbox-search" method="get" asp-action="Index" role="search" data-inbox-search>
                    @if (Model.Filter != "all")
                    {
                        <input type="hidden" name="filter" value="@Model.Filter" />
                    }
                    @if (Model.Sort != "newest")
                    {
                        <input type="hidden" name="sort" value="@Model.Sort" />
                    }
                    <label for="inboxSearch" class="visually-hidden">Search by sender name, email or subject</label>
                    <i class="bi bi-search inbox-search-icon" aria-hidden="true"></i>
                    <input id="inboxSearch" type="search" name="q" value="@Model.Search" maxlength="100"
                           class="form-control" placeholder="Name, email or subject" autocomplete="off" data-voice-search-input />
                    <button type="button" class="btn btn-outline-brand" aria-label="Start voice search" aria-pressed="false" data-voice-search-button><i class="bi bi-mic" aria-hidden="true"></i></button>
                    <button type="submit" class="btn btn-brand inbox-search-button">
                        <span class="inbox-spinner" aria-hidden="true"></span><span class="inbox-search-text">Search</span>
                    </button>
                </form>
                <div class="form-text" role="status" aria-live="polite" data-voice-search-status></div>
            </div>

            <div class="inbox-summary">
                <p class="inbox-summary-text" role="status">
                    @if (Model.Search != null)
                    {
                        <span>@Model.ResultCount @(Model.ResultCount == 1 ? "message" : "messages") matching “<b>@Model.Search</b>”</span>
                        <a class="inbox-clear" asp-action="Index" asp-route-filter="@Model.FilterRoute" asp-route-sort="@Model.SortRoute" data-inbox-nav>Clear search</a>
                    }
                    else
                    {
                        <span>@Model.ResultCount @(Model.ResultCount == 1 ? "message" : "messages")</span>
                    }
                    @if (Model.PageCount > 1)
                    {
                        <span class="inbox-page-note">· page @Model.Page of @Model.PageCount</span>
                    }
                </p>
                <nav class="inbox-sort" aria-label="Sort messages">
                    <span class="inbox-sort-label">Sort</span>
                    <a class="inbox-sort-option @(Model.Sort == "newest" ? "is-current" : "")" data-inbox-nav
                       aria-current="@(Model.Sort == "newest" ? "true" : null)"
                       asp-action="Index" asp-route-q="@Model.Search" asp-route-filter="@Model.FilterRoute">Newest</a>
                    <a class="inbox-sort-option @(Model.Sort == "oldest" ? "is-current" : "")" data-inbox-nav
                       aria-current="@(Model.Sort == "oldest" ? "true" : null)"
                       asp-action="Index" asp-route-q="@Model.Search" asp-route-filter="@Model.FilterRoute" asp-route-sort="oldest">Oldest</a>
                </nav>
            </div>

            @if (Model.Messages.Count == 0)
            {
                if (Model.Filter == "unread" && Model.Search == null)
                {
                    <div class="inbox-empty inbox-empty-inline is-success">
                        <span class="inbox-empty-icon" aria-hidden="true"><i class="bi bi-check2-circle"></i></span>
                        <h2>All caught up</h2>
                        <p>Every message has been read.</p>
                    </div>
                }
                else if (Model.Filter == "read" && Model.Search == null)
                {
                    <div class="inbox-empty inbox-empty-inline">
                        <span class="inbox-empty-icon" aria-hidden="true"><i class="bi bi-envelope-open"></i></span>
                        <h2>Nothing read yet</h2>
                        <p>Messages you mark as read will appear here.</p>
                    </div>
                }
                else
                {
                    <div class="inbox-empty inbox-empty-inline">
                        <span class="inbox-empty-icon" aria-hidden="true"><i class="bi bi-search-heart"></i></span>
                        <h2>No matching messages</h2>
                        <p>Try another name, email or subject, or look in a different tab.</p>
                        <a class="btn btn-outline-brand" asp-action="Index" data-inbox-nav>Show all messages</a>
                    </div>
                }
            }
            else
            {
                <ul class="inbox-list" id="inboxList">
                    @for (var i = 0; i < Model.Messages.Count; i++)
                    {
                        var message = Model.Messages[i];
                        var fullDate = message.CreatedAt.ToString("dd MMM yyyy, HH:mm", CultureInfo.InvariantCulture) + " UTC";
                        <li style="--i: @Math.Min(i, 12)">
                            <a class="inbox-row @(message.IsRead ? "is-read" : "is-unread")"
                               asp-action="Details" asp-route-id="@message.Id" asp-route-q="@Model.Search"
                               asp-route-filter="@Model.FilterRoute" asp-route-sort="@Model.SortRoute"
                               asp-route-page="@(Model.Page == 1 ? null : Model.Page.ToString())">
                                <span class="inbox-avatar tone-@Tone(message.Email)" aria-hidden="true">@Initials(message.FullName)</span>
                                <span class="inbox-main">
                                    <span class="inbox-line">
                                        <span class="inbox-sender">@Highlight(message.FullName, Model.Search)</span>
                                        <span class="inbox-email">@Highlight(message.Email, Model.Search)</span>
                                        <time class="inbox-time" datetime="@message.CreatedAt.ToString("O")" title="@fullDate">@When(message.CreatedAt)</time>
                                    </span>
                                    <span class="inbox-subject">
                                        @if (!message.IsRead)
                                        {
                                            <span class="inbox-dot" aria-hidden="true"></span>
                                            <span class="visually-hidden">Unread: </span>
                                        }
                                        @Highlight(message.Subject, Model.Search)
                                    </span>
                                    <span class="inbox-preview">@message.Preview@(message.Preview.Length >= 140 ? "…" : "")</span>
                                </span>
                                <i class="bi bi-chevron-right inbox-chevron" aria-hidden="true"></i>
                            </a>
                        </li>
                    }
                </ul>

                @if (Model.PageCount > 1)
                {
                    <nav class="inbox-pager" aria-label="Message pages">
                        @if (Model.Page > 1)
                        {
                            <a class="inbox-page-link" data-inbox-nav asp-action="Index" asp-route-q="@Model.Search" asp-route-filter="@Model.FilterRoute"
                               asp-route-sort="@Model.SortRoute" asp-route-page="@(Model.Page - 1 == 1 ? null : (Model.Page - 1).ToString())" rel="prev">
                                <i class="bi bi-chevron-left" aria-hidden="true"></i><span class="visually-hidden">Previous page</span>
                            </a>
                        }
                        @foreach (var number in pages)
                        {
                            if (number == 0)
                            {
                                <span class="inbox-page-gap" aria-hidden="true">…</span>
                            }
                            else if (number == Model.Page)
                            {
                                <span class="inbox-page-link is-current" aria-current="page"><span class="visually-hidden">Page </span>@number</span>
                            }
                            else
                            {
                                <a class="inbox-page-link" data-inbox-nav asp-action="Index" asp-route-q="@Model.Search" asp-route-filter="@Model.FilterRoute"
                                   asp-route-sort="@Model.SortRoute" asp-route-page="@(number == 1 ? null : number.ToString())">
                                    <span class="visually-hidden">Page </span>@number
                                </a>
                            }
                        }
                        @if (Model.Page < Model.PageCount)
                        {
                            <a class="inbox-page-link" data-inbox-nav asp-action="Index" asp-route-q="@Model.Search" asp-route-filter="@Model.FilterRoute"
                               asp-route-sort="@Model.SortRoute" asp-route-page="@((Model.Page + 1).ToString())" rel="next">
                                <i class="bi bi-chevron-right" aria-hidden="true"></i><span class="visually-hidden">Next page</span>
                            </a>
                        }
                    </nav>
                }
            }
        </div>
    }
</section>

@section Scripts {
    <script src="~/js/contact-admin.js" asp-append-version="true"></script>
    <script src="~/js/voice-search.js" asp-append-version="true"></script>
}
