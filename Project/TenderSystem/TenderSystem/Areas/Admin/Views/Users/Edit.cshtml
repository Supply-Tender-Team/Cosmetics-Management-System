@model TenderSystem.Areas.Admin.Models.EditUserViewModel
@{
    ViewData["Title"] = "Edit Employee";
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-chrome.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/users.css" asp-append-version="true" />
}

@* Full page (direct URL / no JavaScript). The form itself is in _EditForm.cshtml, shared with the modal. *@
<div class="users-page">
    <header class="users-heading mb-4">
        <h1 class="page-title mb-1">Edit Employee</h1>
        <p class="text-muted mb-0">Update employee information for MS.WAND.</p>
    </header>

    <div class="users-panel users-create-panel p-3 p-md-4">
        <partial name="_EditForm" model="Model" />
    </div>
</div>
@section Scripts { <script src="~/js/users-validation.js" asp-append-version="true"></script> }
