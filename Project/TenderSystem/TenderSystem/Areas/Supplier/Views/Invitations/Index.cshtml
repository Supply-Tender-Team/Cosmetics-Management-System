@model IReadOnlyList<TenderSystem.Areas.Supplier.Models.SupplierInvitationRow>
@{ ViewData["Title"] = "Invitations"; }
<link rel="stylesheet" href="~/css/supplier.css" asp-append-version="true" />
<div class="container-fluid supplier-page py-4">
    <p class="supplier-eyebrow mb-1">Supplier workspace</p>
    <h1 class="page-title mb-4">Tender invitations</h1>
    <section class="supplier-panel">
        @if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
        @if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }

        @if (Model.Count == 0)
        {
            <div class="supplier-empty">No invitations have been sent to your company yet.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th>Tender</th><th>Status</th><th>Respond by</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var invitation in Model)
                    {
                        <tr>
                            <td><strong>@invitation.TenderTitle</strong><small class="d-block text-muted">@invitation.TenderNumber</small></td>
                            <td><span class="supplier-badge">@invitation.Status</span></td>
                            <td>@invitation.ExpiresAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td>
                                <div class="d-flex flex-wrap align-items-center gap-2">
                                    <a asp-area="Supplier" asp-controller="Tenders" asp-action="Details" asp-route-id="@invitation.TenderId">View</a>
                                    @if (invitation.CanRespond)
                                    {
                                        <form asp-area="Supplier" asp-controller="Invitations" asp-action="Accept" method="post">
                                            <input type="hidden" name="InvitationId" value="@invitation.Id" />
                                            <button type="submit" class="btn btn-sm btn-brand">Accept</button>
                                        </form>
                                        <button type="button" class="btn btn-sm btn-outline-brand" data-bs-toggle="modal" data-bs-target="#declineInvitation-@invitation.Id">Decline</button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            @foreach (var invitation in Model.Where(x => x.CanRespond))
            {
                <div class="modal fade" id="declineInvitation-@invitation.Id" tabindex="-1" aria-labelledby="declineInvitationTitle-@invitation.Id" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <form asp-area="Supplier" asp-controller="Invitations" asp-action="Decline" method="post">
                                <div class="modal-header">
                                    <h2 class="modal-title fs-5" id="declineInvitationTitle-@invitation.Id">Decline invitation</h2>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <p>Tell us why you are declining <strong>@invitation.TenderTitle</strong>.</p>
                                    <input type="hidden" name="InvitationId" value="@invitation.Id" />
                                    <label for="declineReason-@invitation.Id" class="form-label">Reason for declining</label>
                                    <textarea id="declineReason-@invitation.Id" name="DeclineReason" class="form-control" rows="4" maxlength="500" required></textarea>
                                    <div class="form-text">Please enter a reason (maximum 500 characters).</div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn btn-brand">Send</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
    </section>
</div>
