@model IReadOnlyList<TenderSystem.Areas.Supplier.Models.SupplierInvitationRow>
@{
    ViewData["Title"] = "Tender invitations";
    var currentTime = DateTime.UtcNow;
    var pendingCount = Model.Count(invitation => invitation.CanRespond);
    var expiringSoonCount = Model.Count(invitation => invitation.CanRespond && invitation.ExpiresAt <= currentTime.AddDays(3));
}

@section Styles {
    <link rel="stylesheet" href="~/css/supplier.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/supplier-invitations.css" asp-append-version="true" />
}

<main class="supplier-page supplier-invitations-page">
    <header class="supplier-invitations-welcome">
        <div>
            <span class="supplier-invitations-eyebrow">Supplier workspace</span>
            <h1 class="page-title">Tender invitations</h1>
            <p>Review each tender and respond before its invitation expires.</p>
        </div>
        <div class="supplier-invitations-summary" aria-label="Invitation summary">
            <div><span>Waiting for your response</span><strong>@pendingCount</strong></div>
            <div><span>Expiring in 3 days</span><strong>@expiringSoonCount</strong></div>
        </div>
    </header>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <section class="supplier-invitations-panel" aria-labelledby="supplier-invitations-list-title">
        <header class="supplier-invitations-panel-heading">
            <div>
                <h2 id="supplier-invitations-list-title">All invitations</h2>
                <p>Your latest invitations appear first.</p>
            </div>
            <span class="supplier-invitations-total">@Model.Count total</span>
        </header>

        @if (Model.Count == 0)
        {
            <div class="supplier-invitations-empty">
                <i class="bi bi-envelope-open" aria-hidden="true"></i>
                <h3>No invitations yet</h3>
                <p>New tenders sent to your company will appear here.</p>
            </div>
        }
        else
        {
            <div class="table-responsive supplier-invitations-table-wrap">
                <table class="table supplier-invitations-table align-middle mb-0">
                    <thead>
                        <tr><th scope="col">Tender</th><th scope="col">Status</th><th scope="col">Respond by</th><th scope="col">Time left</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr>
                    </thead>
                    <tbody>
                    @foreach (var invitation in Model)
                    {
                        var isExpired = invitation.Status == TenderSystem.Infrastructure.Statuses.InvitationStatus.Pending && invitation.ExpiresAt <= currentTime;
                        var displayStatus = isExpired ? TenderSystem.Infrastructure.Statuses.InvitationStatus.Expired : invitation.Status;
                        var statusClass = displayStatus.ToLowerInvariant();
                        <tr>
                            <th scope="row" class="supplier-invitation-tender">
                                <span class="supplier-invitation-number">@invitation.TenderNumber</span>
                                <span class="d-block">@invitation.TenderTitle</span>
                            </th>
                            <td><span class="supplier-invitation-status status-@statusClass">@displayStatus</span></td>
                            <td><time datetime="@invitation.ExpiresAt.ToUniversalTime().ToString("O")">@invitation.ExpiresAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</time></td>
                            <td>
                                @if (invitation.Status == TenderSystem.Infrastructure.Statuses.InvitationStatus.Pending)
                                {
                                    <span class="supplier-invitation-countdown @(isExpired ? "is-expired" : string.Empty)"
                                          data-expiration-countdown
                                          data-deadline-utc="@invitation.ExpiresAt.ToUniversalTime().ToString("O")"
                                          aria-label="Invitation time remaining">@(isExpired ? "Expired" : "Calculating…")</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="supplier-invitation-actions">
                                <a class="btn btn-sm btn-outline-secondary" asp-area="Supplier" asp-controller="Tenders" asp-action="Details" asp-route-id="@invitation.TenderId">View tender</a>
                                @if (invitation.CanRespond)
                                {
                                    <form asp-area="Supplier" asp-controller="Invitations" asp-action="Accept" method="post">
                                        <input type="hidden" name="InvitationId" value="@invitation.Id" />
                                        <button type="submit" class="btn btn-sm btn-brand">Accept</button>
                                    </form>
                                    <button type="button" class="btn btn-sm btn-outline-brand" data-bs-toggle="modal" data-bs-target="#declineInvitation-@invitation.Id">Decline</button>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            @foreach (var invitation in Model.Where(item => item.CanRespond))
            {
                <div class="modal fade supplier-decline-modal" id="declineInvitation-@invitation.Id" tabindex="-1" aria-labelledby="declineInvitationTitle-@invitation.Id" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content">
                            <form asp-area="Supplier" asp-controller="Invitations" asp-action="Decline" method="post">
                                <div class="modal-header">
                                    <div>
                                        <span class="supplier-invitations-eyebrow">Invitation response</span>
                                        <h2 class="modal-title" id="declineInvitationTitle-@invitation.Id">Decline this invitation?</h2>
                                    </div>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <p>Your reason will be saved with this invitation.</p>
                                    <p class="supplier-decline-tender">@invitation.TenderNumber · @invitation.TenderTitle</p>
                                    <input type="hidden" name="InvitationId" value="@invitation.Id" />
                                    <label for="declineReason-@invitation.Id" class="form-label">Reason for declining</label>
                                    <textarea id="declineReason-@invitation.Id" name="DeclineReason" class="form-control" rows="4" maxlength="500" required></textarea>
                                    <div class="form-text">Enter a short reason (maximum 500 characters).</div>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Keep invitation</button>
                                    <button type="submit" class="btn btn-brand">Send decline</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
    </section>
</main>

@section Scripts {
    <script src="~/js/supplier-invitations.js" asp-append-version="true"></script>
}
