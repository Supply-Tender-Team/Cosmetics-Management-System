@model IReadOnlyList<TenderSystem.Areas.Supplier.Models.SupplierInvitationRow>
@{ ViewData["Title"] = "Tender invitations"; }

@section Styles {
    <link rel="stylesheet" href="~/css/supplier-invitations.css" asp-append-version="true" />
}

<main class="supplier-invitations-page">
    <header class="supplier-invitations-welcome">
        <div class="supplier-invitations-welcome-copy">
            <span class="supplier-invitations-eyebrow">Supplier workspace</span>
            <h1 class="page-title">Tender invitations</h1>
            <p>Review tenders sent to your company and choose how to respond.</p>
        </div>
        <img class="supplier-invitations-art" src="~/images/requester-cosmetics-crop.png" asp-append-version="true" alt="" aria-hidden="true" />
    </header>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    @if (Model.Count == 0)
    {
        <section class="supplier-invitations-empty">
            <i class="bi bi-envelope-open" aria-hidden="true"></i>
            <h2>No invitations yet</h2>
            <p>New tenders sent to your company will appear here.</p>
        </section>
    }
    else
    {
        <section class="supplier-invitations-list" aria-label="Tender invitations">
            @foreach (var invitation in Model)
            {
                <article class="supplier-invitation-card" data-expiry-utc="@(invitation.CanRespond ? invitation.ExpiresAt.ToUniversalTime().ToString("O") : string.Empty)">
                    <div class="supplier-invitation-main">
                        <div class="supplier-invitation-title-row">
                            <span class="supplier-invitation-icon" aria-hidden="true"><i class="bi bi-file-earmark-text"></i></span>
                            <div>
                                <span class="supplier-invitation-number">@invitation.TenderNumber</span>
                                <h2>@invitation.TenderTitle</h2>
                            </div>
                        </div>
                        <div class="supplier-invitation-meta">
                            <span class="supplier-invitation-status" data-invitation-status><i class="bi bi-circle-fill" aria-hidden="true"></i><span>@invitation.Status</span></span>
                            <span class="supplier-invitation-deadline"><i class="bi bi-calendar-event me-2" aria-hidden="true"></i>Respond by @invitation.ExpiresAt.ToLocalTime().ToString("dd MMM yyyy")
                                @if (invitation.CanRespond)
                                {
                                    <small class="supplier-invitation-countdown" data-countdown>Calculating time left…</small>
                                }
                            </span>
                        </div>
                    </div>
                    <div class="supplier-invitation-actions" data-response-actions>
                        <a class="btn btn-outline-brand" asp-area="Supplier" asp-controller="Tenders" asp-action="Details" asp-route-id="@invitation.TenderId">View tender</a>
                        @if (invitation.CanRespond)
                        {
                            <form asp-area="Supplier" asp-controller="Invitations" asp-action="Accept" method="post">
                                <input type="hidden" name="InvitationId" value="@invitation.Id" />
                                <button type="submit" class="btn btn-brand"><i class="bi bi-check2 me-1" aria-hidden="true"></i>Accept</button>
                            </form>
                            <button type="button" class="btn btn-decline" data-bs-toggle="modal" data-bs-target="#declineInvitation-@invitation.Id">Decline</button>
                        }
                    </div>
                </article>
            }
        </section>

        @foreach (var invitation in Model.Where(x => x.CanRespond))
        {
            <div class="modal fade" id="declineInvitation-@invitation.Id" tabindex="-1" aria-labelledby="declineInvitationTitle-@invitation.Id" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content supplier-decline-modal">
                        <form asp-area="Supplier" asp-controller="Invitations" asp-action="Decline" method="post">
                            <div class="modal-header">
                                <h2 class="modal-title fs-5" id="declineInvitationTitle-@invitation.Id">Decline invitation</h2>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <p>Tell us why you are declining <strong>@invitation.TenderTitle</strong>.</p>
                                <input type="hidden" name="InvitationId" value="@invitation.Id" />
                                <label for="declineReason-@invitation.Id" class="form-label">Reason for declining</label>
                                <textarea id="declineReason-@invitation.Id" name="DeclineReason" class="form-control" rows="4" maxlength="500" required></textarea>
                                <div class="form-text">Please enter a reason (maximum 500 characters).</div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-brand">Send</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
</main>

@section Scripts {
    <script src="~/js/supplier-invitations.js" asp-append-version="true"></script>
}
