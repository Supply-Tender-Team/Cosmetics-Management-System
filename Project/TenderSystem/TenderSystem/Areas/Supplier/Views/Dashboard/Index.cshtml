@model TenderSystem.Areas.Supplier.Models.SupplierDashboardViewModel
@{
    ViewData["Title"] = "Supplier dashboard";
}

@section Styles {
    <link rel="stylesheet" href="~/css/supplier-dashboard.css" asp-append-version="true" />
}

<main class="supplier-dashboard">
    <section class="supplier-welcome" aria-labelledby="supplier-welcome-title">
        <div class="supplier-welcome-copy">
            <span class="supplier-eyebrow">Supplier workspace</span>
            <h1 class="page-title" id="supplier-welcome-title">Welcome, @Model.SupplierName</h1>
            <p>Keep track of tender invitations and offers from one place.</p>
        </div>
        <div class="supplier-welcome-actions">
            <span class="supplier-company-status"><i class="bi bi-building-check" aria-hidden="true"></i> Company: @Model.VerificationStatus</span>
            <a class="btn btn-brand" asp-area="Supplier" asp-controller="Invitations" asp-action="Index">
                <i class="bi bi-envelope-open me-2" aria-hidden="true"></i>View invitations
            </a>
        </div>
    </section>

    <section class="supplier-dashboard-stats" aria-label="Supplier summary">
        <article class="supplier-dashboard-stat">
            <span class="supplier-dashboard-stat-icon"><i class="bi bi-envelope" aria-hidden="true"></i></span>
            <div><p>Pending invitations</p><strong>@Model.PendingInvitations</strong></div>
        </article>
        <article class="supplier-dashboard-stat">
            <span class="supplier-dashboard-stat-icon"><i class="bi bi-send-check" aria-hidden="true"></i></span>
            <div><p>Submitted offers</p><strong>@Model.SubmittedOffers</strong></div>
        </article>
        <article class="supplier-dashboard-stat">
            <span class="supplier-dashboard-stat-icon"><i class="bi bi-hourglass-split" aria-hidden="true"></i></span>
            <div><p>Under review</p><strong>@Model.OffersUnderReview</strong></div>
        </article>
        <article class="supplier-dashboard-stat">
            <span class="supplier-dashboard-stat-icon"><i class="bi bi-check2-circle" aria-hidden="true"></i></span>
            <div><p>Accepted offers</p><strong>@Model.ApprovedOffers</strong></div>
        </article>
    </section>

    <section class="supplier-dashboard-panel" aria-labelledby="supplier-recent-invitations-title">
        <header class="supplier-dashboard-panel-heading">
            <div>
                <h2 id="supplier-recent-invitations-title">Recent invitations</h2>
                <p>Review the tenders shared with your company.</p>
            </div>
            <a class="supplier-dashboard-text-link" asp-area="Supplier" asp-controller="Invitations" asp-action="Index">
                All invitations <i class="bi bi-arrow-up-right ms-1" aria-hidden="true"></i>
            </a>
        </header>

        @if (Model.RecentInvitations.Count == 0)
        {
            <div class="supplier-dashboard-empty">
                <i class="bi bi-inbox" aria-hidden="true"></i>
                <p>No invitations yet. New tenders will appear here.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table supplier-dashboard-table align-middle mb-0">
                    <thead><tr><th scope="col">Tender</th><th scope="col">Status</th><th scope="col">Respond by</th><th scope="col"><span class="visually-hidden">Action</span></th></tr></thead>
                    <tbody>
                    @foreach (var invitation in Model.RecentInvitations)
                    {
                        <tr>
                            <th scope="row"><span class="supplier-dashboard-reference">@invitation.TenderNumber</span><span class="d-block">@invitation.TenderTitle</span></th>
                            <td><span class="supplier-dashboard-badge">@invitation.Status</span></td>
                            <td>@invitation.ExpiresAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td class="text-end"><a class="supplier-dashboard-row-link" asp-area="Supplier" asp-controller="Tenders" asp-action="Details" asp-route-id="@invitation.TenderId">View tender</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="supplier-dashboard-panel" aria-labelledby="supplier-recent-offers-title">
        <header class="supplier-dashboard-panel-heading">
            <div>
                <h2 id="supplier-recent-offers-title">Recent offers</h2>
                <p>Follow the status of your submitted offers.</p>
            </div>
            <a class="supplier-dashboard-text-link" asp-area="Supplier" asp-controller="Offers" asp-action="Index">
                My offers <i class="bi bi-arrow-up-right ms-1" aria-hidden="true"></i>
            </a>
        </header>

        @if (Model.RecentOffers.Count == 0)
        {
            <div class="supplier-dashboard-empty">
                <i class="bi bi-file-earmark-text" aria-hidden="true"></i>
                <p>You have not submitted an offer yet.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table supplier-dashboard-table align-middle mb-0">
                    <thead><tr><th scope="col">Tender</th><th scope="col">Status</th><th scope="col">Offer amount</th><th scope="col">Submitted</th></tr></thead>
                    <tbody>
                    @foreach (var offer in Model.RecentOffers)
                    {
                        <tr>
                            <th scope="row"><span class="supplier-dashboard-reference">@offer.TenderNumber</span><span class="d-block">@offer.TenderTitle</span></th>
                            <td><span class="supplier-dashboard-badge">@offer.Status</span></td>
                            <td>@offer.TotalPrice.ToString("N2") @offer.Currency</td>
                            <td>@(offer.SubmittedAt?.ToLocalTime().ToString("dd MMM yyyy") ?? "Draft")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</main>
