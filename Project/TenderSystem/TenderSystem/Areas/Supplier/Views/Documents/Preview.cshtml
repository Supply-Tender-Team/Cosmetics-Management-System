@model TenderSystem.Areas.Supplier.Models.DocumentPreviewViewModel
@{ ViewData["Title"] = "Document preview"; }

@section Styles {
    <link rel="stylesheet" href="~/css/document-preview.css" asp-append-version="true" />
}

<main class="document-preview-page">
    <header class="document-preview-heading">
        <div>
            <p class="document-preview-eyebrow">@Model.Title</p>
            <h1 class="page-title">@Model.FileName</h1>
            <p class="document-preview-viewer">Opened by <strong>@Model.ViewerName</strong> · @Model.ViewedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</p>
        </div>
        <a class="btn btn-outline-secondary" href="@Model.DownloadUrl"><i class="bi bi-download me-2" aria-hidden="true"></i>Download original</a>
    </header>

    <section class="document-preview-frame" aria-label="Watermarked document preview">
        @if (Model.CanPreview && Model.IsImage)
        {
            <img class="document-preview-image" src="@Model.FileUrl" alt="Preview of @Model.FileName" />
        }
        else if (Model.CanPreview)
        {
            <iframe class="document-preview-pdf" src="@Model.FileUrl" title="Preview of @Model.FileName"></iframe>
        }
        else
        {
            <div class="document-preview-unsupported">
                <i class="bi bi-file-earmark-lock2" aria-hidden="true"></i>
                <p>This file type cannot be previewed in the browser.</p>
                <a class="btn btn-brand" href="@Model.DownloadUrl">Download original file</a>
            </div>
        }
        <div class="document-watermark" aria-hidden="true">
            @for (var index = 0; index < 9; index++)
            {
                <span class="document-watermark-mark">
                    <img src="~/images/ms-wand-tilted-blush-logo.png" alt="" />
                    <span>@Model.ViewerName</span>
                    <small>@Model.ViewedAtUtc.ToString("yyyy-MM-dd HH:mm 'UTC'")</small>
                </span>
            }
        </div>
    </section>

    <p class="document-preview-note"><i class="bi bi-shield-check me-2" aria-hidden="true"></i>This view is watermarked for your account. Document access is recorded.</p>
</main>
