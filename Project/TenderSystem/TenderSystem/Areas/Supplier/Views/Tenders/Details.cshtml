@model TenderSystem.Areas.Supplier.Models.SupplierTenderDetailsViewModel
@{ ViewData["Title"] = "Tender details"; }
<link rel="stylesheet" href="~/css/supplier.css" asp-append-version="true" />
<div class="container-fluid supplier-page py-4">
    <p class="supplier-eyebrow mb-1">Supplier workspace · @Model.TenderNumber</p>
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h1 class="page-title mb-2">@Model.Title</h1>
            <p class="text-muted mb-0">Invitation status: <span class="supplier-badge">@Model.InvitationStatus</span></p>
        </div>
        <div class="d-flex gap-2">
            <a asp-area="Supplier" asp-controller="Invitations" asp-action="Index" class="btn btn-outline-brand">Back to invitations</a>
            @if (Model.CanSubmitOffer)
            {
                <a asp-area="Supplier" asp-controller="Offers" asp-action="Create" asp-route-tenderId="@Model.Id" class="btn btn-brand">Prepare offer</a>
            }
        </div>
    </div>

    <section class="supplier-panel mb-4">
        <h2 class="h4">Tender information</h2>
        <dl class="row mb-0">
            <dt class="col-sm-4">Tender status</dt><dd class="col-sm-8">@Model.Status</dd>
            <dt class="col-sm-4">Submission deadline</dt><dd class="col-sm-8">@Model.SubmissionDeadline.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</dd>
            <dt class="col-sm-4">Invitation expires</dt><dd class="col-sm-8">@(Model.InvitationExpiresAt?.ToLocalTime().ToString("dd MMM yyyy, HH:mm") ?? "Not specified")</dd>
            <dt class="col-sm-4">Description</dt><dd class="col-sm-8">@Model.Description</dd>
            <dt class="col-sm-4">Terms</dt><dd class="col-sm-8">@Model.Terms</dd>
        </dl>
    </section>

    <section class="supplier-panel">
        <h2 class="h4 mb-3">Requested items</h2>
        @if (Model.Items.Count == 0)
        {
            <div class="supplier-empty">No item details are available for this tender.</div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th>Item</th><th>Quantity</th><th>Specifications</th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr><td>@item.ItemName</td><td>@item.Quantity.ToString("N2") @item.Unit</td><td>@item.Specifications</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
