@model TenderSystem.Areas.Supplier.Models.SupplierProfilePageViewModel
@{
    ViewData["Title"] = "Company profile";
}

@section Styles {
    <link rel="stylesheet" href="~/css/supplier.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/supplier-profile.css" asp-append-version="true" />
}

<main class="supplier-page supplier-profile-page">
    <header class="supplier-profile-welcome">
        <div>
            <span class="supplier-profile-eyebrow">Supplier workspace</span>
            <h1 class="page-title">Company profile</h1>
            <p>Keep your company information and legal documents up to date.</p>
        </div>
        <div class="supplier-profile-status">
            <span>Supplier status</span>
            <strong>@Model.SupplierStatus</strong>
        </div>
    </header>

    @if (TempData["ProfileSuccess"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }

    <div class="supplier-profile-layout">
        <section class="supplier-profile-panel" aria-labelledby="supplier-profile-details-title">
            <header class="supplier-profile-panel-heading">
                <span class="supplier-profile-panel-icon"><i class="bi bi-building" aria-hidden="true"></i></span>
                <div>
                    <h2 id="supplier-profile-details-title">Company details</h2>
                    <p>Update the information connected to your supplier account.</p>
                </div>
            </header>

            <form asp-area="Supplier" asp-controller="Profile" asp-action="Update" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="Profile.CompanyName" class="form-label"></label>
                        <input asp-for="Profile.CompanyName" class="form-control" />
                        <span asp-validation-for="Profile.CompanyName" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Profile.TaxNumber" class="form-label"></label>
                        <input asp-for="Profile.TaxNumber" class="form-control" />
                        <span asp-validation-for="Profile.TaxNumber" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Profile.CommercialRegNumber" class="form-label"></label>
                        <input asp-for="Profile.CommercialRegNumber" class="form-control" />
                        <span asp-validation-for="Profile.CommercialRegNumber" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Profile.Country" class="form-label"></label>
                        <input asp-for="Profile.Country" class="form-control" />
                        <span asp-validation-for="Profile.Country" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Profile.City" class="form-label"></label>
                        <input asp-for="Profile.City" class="form-control" />
                        <span asp-validation-for="Profile.City" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Profile.Address" class="form-label"></label>
                        <input asp-for="Profile.Address" class="form-control" />
                        <span asp-validation-for="Profile.Address" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Profile.ContactPerson" class="form-label"></label>
                        <input asp-for="Profile.ContactPerson" class="form-control" />
                        <span asp-validation-for="Profile.ContactPerson" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Profile.ContactPhone" class="form-label"></label>
                        <input asp-for="Profile.ContactPhone" class="form-control" />
                        <span asp-validation-for="Profile.ContactPhone" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Profile.Website" class="form-label"></label>
                        <input asp-for="Profile.Website" class="form-control" placeholder="https://example.com" />
                        <span asp-validation-for="Profile.Website" class="text-danger"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="Profile.Category" class="form-label"></label>
                        <input asp-for="Profile.Category" class="form-control" />
                        <span asp-validation-for="Profile.Category" class="text-danger"></span>
                    </div>
                </div>
                <div class="supplier-profile-form-actions">
                    <button type="submit" class="btn btn-brand"><i class="bi bi-check2 me-2" aria-hidden="true"></i>Save changes</button>
                </div>
            </form>
        </section>

        <section class="supplier-profile-panel" aria-labelledby="supplier-profile-documents-title">
            <header class="supplier-profile-panel-heading">
                <span class="supplier-profile-panel-icon"><i class="bi bi-file-earmark-check" aria-hidden="true"></i></span>
                <div>
                    <h2 id="supplier-profile-documents-title">Company documents</h2>
                    <p>Upload a renewed registration or tax document.</p>
                </div>
            </header>

            @if (Model.Documents.Count == 0)
            {
                <div class="supplier-profile-empty">
                    <i class="bi bi-folder2-open" aria-hidden="true"></i>
                    <p>No company documents have been uploaded yet.</p>
                </div>
            }
            else
            {
                <div class="table-responsive supplier-profile-documents-table">
                    <table class="table align-middle mb-0">
                        <thead><tr><th scope="col">Document</th><th scope="col">Expiry</th><th scope="col">Uploaded</th><th scope="col"><span class="visually-hidden">Download</span></th></tr></thead>
                        <tbody>
                        @foreach (var document in Model.Documents)
                        {
                            var isExpired = document.ExpiryDate.HasValue && document.ExpiryDate.Value.Date < DateTime.UtcNow.Date;
                            <tr>
                                <th scope="row"><span class="supplier-profile-document-type">@document.DocType</span><small class="d-block text-muted">@document.FileExtension.ToUpperInvariant()</small></th>
                                <td>
                                    @if (document.ExpiryDate.HasValue)
                                    {
                                        <span class="supplier-profile-expiry @(isExpired ? "is-expired" : "is-current")">@document.ExpiryDate.Value.ToString("dd MMM yyyy")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Not provided</span>
                                    }
                                </td>
                                <td>@document.UploadedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                                <td class="text-end"><a class="supplier-profile-download" asp-area="Supplier" asp-controller="Profile" asp-action="DownloadDocument" asp-route-id="@document.Id" aria-label="Download @document.DocType"><i class="bi bi-download" aria-hidden="true"></i></a></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }

            <form asp-area="Supplier" asp-controller="Profile" asp-action="UploadDocument" method="post" enctype="multipart/form-data" class="supplier-profile-upload-form">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <h3>Upload a document</h3>
                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="DocumentUpload.DocType" class="form-label"></label>
                        <select asp-for="DocumentUpload.DocType" class="form-select">
                            <option value="">Choose document type</option>
                            <option value="Commercial registration">Commercial registration</option>
                            <option value="Tax certificate">Tax certificate</option>
                            <option value="Other document">Other document</option>
                        </select>
                        <span asp-validation-for="DocumentUpload.DocType" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="DocumentUpload.File" class="form-label"></label>
                        <input asp-for="DocumentUpload.File" class="form-control" type="file" />
                        <span asp-validation-for="DocumentUpload.File" class="text-danger"></span>
                        <div class="form-text">Allowed file types and size follow the secure upload settings.</div>
                    </div>
                    <div class="col-12">
                        <label asp-for="DocumentUpload.ExpiryDate" class="form-label"></label>
                        <input asp-for="DocumentUpload.ExpiryDate" class="form-control" type="date" />
                        <span asp-validation-for="DocumentUpload.ExpiryDate" class="text-danger"></span>
                    </div>
                </div>
                <div class="supplier-profile-form-actions">
                    <button type="submit" class="btn btn-outline-brand"><i class="bi bi-cloud-arrow-up me-2" aria-hidden="true"></i>Upload document</button>
                </div>
            </form>
        </section>
    </div>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
