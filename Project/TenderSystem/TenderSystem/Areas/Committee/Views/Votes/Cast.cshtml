@model TenderSystem.Areas.Committee.Models.Votes.CastVotePageViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Top Committee Vote";
    var status = Model.Status;
    var voteSuccess = TempData["VoteSuccess"] as string;
    // "VoteSubmitted" is set only after a vote; a successful retry uses VoteSuccess alone.
    var wasVote = TempData["VoteSubmitted"] is string submitted && submitted == "1";
    var voteSubmitted = wasVote && voteSuccess is not null && status.MyVote is not null;
}
@* OWNER: Abdallah (helping Dana with TOP-02) - the vote page.
   Look: top-committee.css (hero, panels) + top-committee-votes.css (decision cards, progress, dialogs).
   Field names, ids and the inline scripts below are what the voting logic depends on: keep them. *@

@section Styles {
    <link rel="stylesheet" href="~/css/top-committee.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/top-committee-votes.css" asp-append-version="true" />
    <style>
        .cv-page-cast .cv-layout { grid-template-columns: minmax(0, 1fr); gap: .25rem; }
        .cv-page-cast .cv-aside { position: static; }
        .cv-page-cast .cv-member-list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .7rem; }
        .cv-page-cast .cv-member { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-content: center; gap: .3rem .8rem; min-height: 5.5rem; padding: .85rem 1rem; background: #faf7f2; border-color: #d3ccc5; }
        .cv-page-cast .cv-member-name { grid-column: 1; line-height: 1.35; overflow-wrap: anywhere; }
        .cv-page-cast .cv-member-state { grid-column: 2; grid-row: 1 / span 2; align-self: center; white-space: normal; text-align: right; }
        .cv-page-cast .cv-member-choice { grid-column: 1; }
        .cv-page-cast .cv-member-reason { grid-column: 1 / -1; margin: .15rem 0 0; padding-top: .45rem; border-top: 1px dashed var(--warm-beige); color: var(--mocha-brown); font-size: .9rem; white-space: pre-wrap; overflow-wrap: anywhere; }
        .cv-page-cast .cv-member.is-approve { background: #edf5ee; border-color: #9fbea8; }
        .cv-page-cast .cv-member.is-reject { background: #f8ecec; border-color: #d9a0a7; }
        .cv-page-cast .cv-member.is-retender { background: #fff4df; border-color: #d6b577; }
        .cv-page-cast .cv-member-state { font-weight: 600; }
        .cv-page-cast .cv-member-choice { color: #5d5652; font-size: 1rem; }
        .cv-page-cast .cv-member.is-approve .cv-member-choice { color: #27563a; }
        .cv-page-cast .cv-member.is-reject .cv-member-choice { color: #8a303b; }
        .cv-page-cast .cv-member.is-retender .cv-member-choice { color: #725016; }
        .cv-page-cast .cv-options { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .7rem; }
        .cv-page-cast .cv-option { align-items: start; min-width: 0; min-height: 8.5rem; padding: 1rem; }
        .cv-page-cast .cv-option-copy strong { display: block; line-height: 1.35; }
        .cv-page-cast .cv-option-copy small { display: block; margin-top: .3rem; }
        .cv-page-cast .cv-reason[hidden] { display: none; }
        .cv-page-cast .cv-reason-meta { display: flex; justify-content: space-between; gap: .75rem; margin-top: .4rem; color: #5d5652; font-size: .85rem; }
        .cv-page-cast .cv-reason-count { flex: none; font-variant-numeric: tabular-nums; }
        .cv-page-cast .cv-vote-form:has(#voteRetender:checked) .cv-reason-tag { display: inline-block; }
        .cv-page-cast .cv-option:has(input:focus-visible) { outline: 3px solid #70354b; outline-offset: 3px; }
        @@media (max-width: 900px) { .cv-page-cast .cv-options { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
        @@media (max-width: 640px) { .cv-page-cast .cv-options, .cv-page-cast .cv-member-list { grid-template-columns: minmax(0, 1fr); } .cv-page-cast .cv-option { min-height: 0; } .cv-page-cast .cv-member { grid-template-columns: minmax(0, 1fr); } .cv-page-cast .cv-member-state { grid-column: 1; grid-row: auto; text-align: left; } }
        @@media (prefers-reduced-motion: reduce) { .cv-page-cast .cv-member, .cv-page-cast .cv-option { transition: none; } }
    </style>
}

<div class="top-committee-page cv-page cv-page-cast">
    <a class="top-committee-back-link" asp-area="Committee" asp-controller="Votes" asp-action="Index">
        <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>Back to voting list
    </a>

    <section class="top-committee-hero top-committee-review-hero cv-enter" style="--i: 0">
        <div class="top-committee-hero-copy">
            <span class="top-committee-eyebrow"><i class="bi bi-check2-square me-2" aria-hidden="true"></i>Top Committee · Final decision</span>
            <h1 class="page-title">@status.TenderTitle</h1>
            <p>Tender @status.TenderNumber</p>
            <div class="top-committee-tags">
                @if (status.IsFinalized && status.Outcome == Statuses.ApprovalDecision.Approved)
                {
                    <span class="cv-badge is-awarded"><i class="bi bi-award" aria-hidden="true"></i>Awarded · Final decision</span>
                }
                else if (status.IsFinalized && status.Outcome == Statuses.ApprovalDecision.Rejected)
                {
                    <span class="cv-badge is-rejected"><i class="bi bi-x-circle" aria-hidden="true"></i>Rejected · Final decision</span>
                }
                else if (status.IsFinalized && status.Outcome == Statuses.ApprovalDecision.RetenderRequired)
                {
                    <span class="cv-badge is-pending"><i class="bi bi-arrow-repeat" aria-hidden="true"></i>Retender Required · Final decision</span>
                }
                else
                {
                    <span class="cv-badge is-pending"><i class="bi bi-hourglass-split" aria-hidden="true"></i>Pending final decision</span>
                }
                <span><i class="bi bi-people me-2" aria-hidden="true"></i>@status.VotesReceived of 4 votes</span>
            </div>
        </div>
        <img src="~/images/requester-cosmetics-crop.png" asp-append-version="true" alt="" aria-hidden="true" />
        <span class="top-committee-hero-seal" aria-hidden="true"><i class="bi bi-award"></i></span>
    </section>

    @if (voteSuccess is not null)
    {
        <div id="voteSuccessFallback" class="cv-notice is-success" role="status" aria-live="polite">
            <i class="bi bi-check-lg" aria-hidden="true"></i>
            <div>
                <strong class="d-block mb-1">@(wasVote ? "Your vote was recorded" : "Update recorded")</strong>
                <p class="mb-1">@voteSuccess</p>
                @if (status.MyVote is not null)
                {
                    <p class="mb-0">Your choice: <strong>@status.MyVote</strong> · Progress: <strong>@status.VotesReceived / 4</strong></p>
                }
            </div>
        </div>
    }
    @if (voteSubmitted)
    {
        <dialog id="voteSuccessDialog" class="cv-confirm cv-vote-success" aria-labelledby="voteSuccessTitle" aria-describedby="voteSuccessDescription">
            <span class="cv-vote-success-icon" aria-hidden="true"><i class="bi bi-check-lg"></i></span>
            <h2 id="voteSuccessTitle" class="h4 mb-2">Vote Submitted Successfully!</h2>
            @* The server message says whether the final decision was recorded or is on hold. *@
            <p id="voteSuccessDescription" class="text-muted mb-3">@voteSuccess</p>
            <p class="cv-vote-success-choice mb-3">Your choice: <strong>@status.MyVote</strong></p>
            <p class="mb-1">Committee progress: <strong>@status.VotesReceived of 4 votes</strong></p>
            <div class="cv-progress-track" role="progressbar" aria-label="Committee voting progress" aria-valuemin="0" aria-valuemax="4" aria-valuenow="@status.VotesReceived" aria-valuetext="@status.VotesReceived of 4 members voted">
                @for (var segment = 0; segment < 4; segment++)
                {
                    <span class="cv-progress-segment @(segment < status.VotesReceived ? "is-filled" : "")" aria-hidden="true"></span>
                }
            </div>
            <button id="voteSuccessContinue" type="button" class="btn btn-brand w-100">Continue</button>
        </dialog>
    }
    @if (TempData["VoteError"] is string voteError)
    {
        <div class="cv-notice is-error" role="alert"><i class="bi bi-exclamation-octagon" aria-hidden="true"></i><p class="mb-0">@voteError</p></div>
    }
    @if (TempData["VoteWarning"] is string voteWarning)
    {
        <div class="cv-notice is-warning" role="status"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i><p class="mb-0">@voteWarning</p></div>
    }
    @* "All": the form posts plain TenderId / Vote / Reason fields, so field errors are listed here too. *@
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="cv-error" role="alert"><strong>Please check your vote.</strong><div asp-validation-summary="All"></div></div>
    }

    <div class="cv-layout">
        <div class="cv-main">
            <section class="top-committee-panel cv-enter" style="--i: 1" aria-labelledby="recommendationTitle">
                <div class="top-committee-panel-heading">
                    <div>
                        <span class="top-committee-eyebrow">Manager-approved report</span>
                        <h2 id="recommendationTitle">Recommended supplier</h2>
                    </div>
                    <span class="cv-heading-icon" aria-hidden="true"><i class="bi bi-award"></i></span>
                </div>
                @if (!status.IsMember)
                {
                    <div class="cv-supplier is-muted">
                        <span class="cv-supplier-icon" aria-hidden="true"><i class="bi bi-lock"></i></span>
                        <p class="text-muted mb-0">The recommended supplier is visible to current Top Committee members only.</p>
                    </div>
                }
                else if (status.RecommendedSupplier is null)
                {
                    <div class="cv-supplier is-muted">
                        <span class="cv-supplier-icon" aria-hidden="true"><i class="bi bi-dash-circle"></i></span>
                        <p class="text-muted mb-0">No valid recommendation is available.</p>
                    </div>
                }
                else
                {
                    <div class="cv-supplier">
                        <span class="cv-supplier-icon" aria-hidden="true"><i class="bi bi-building-check"></i></span>
                        <div class="cv-supplier-copy">
                            <strong>@status.RecommendedSupplier</strong>
                            <span>Offer total: <b>@status.RecommendedPrice?.ToString("#,0.00", CultureInfo.InvariantCulture) @status.RecommendedCurrency</b></span>
                        </div>
                    </div>
                }
            </section>

            @if (status.DecisionBlockedReason is not null)
            {
                @* All four votes are in, but the decision could not be recorded. Votes are kept; a member can retry. *@
                <div class="cv-notice is-warning" role="status">
                    <i class="bi bi-pause-circle" aria-hidden="true"></i>
                    <div>
                        <p class="mb-2"><strong>The final decision is not recorded yet.</strong> @status.DecisionBlockedReason</p>
                        <p class="mb-2">Your vote is saved. Ask the Sourcing Manager to resolve the issue before retrying.</p>
                        @if (status.CanRetryFinalize)
                        {
                            <form asp-area="Committee" asp-controller="Votes" asp-action="RetryFinalize" method="post" class="m-0" data-cv-once>
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="tenderId" value="@status.TenderId" />
                                <button type="submit" class="btn btn-sm btn-outline-brand"><i class="bi bi-arrow-clockwise me-1" aria-hidden="true"></i>Retry final decision</button>
                            </form>
                        }
                    </div>
                </div>
            }

            @if (!status.CanVote)
            {
                <div class="cv-notice is-muted" role="status"><i class="bi bi-info-circle" aria-hidden="true"></i><p class="mb-0">@status.BlockReason</p></div>
            }
            else
            {
                <section class="top-committee-panel cv-panel-static cv-enter" style="--i: 2" aria-labelledby="voteTitle">
                    <div class="top-committee-panel-heading">
                        <div>
                            <span class="top-committee-eyebrow">Committee member</span>
                            <h2 id="voteTitle">Your vote</h2>
                        </div>
                        <span class="cv-heading-icon" aria-hidden="true"><i class="bi bi-check2-square"></i></span>
                    </div>
                    <p class="cv-rule"><i class="bi bi-info-circle" aria-hidden="true"></i><span>You can vote only once. A vote cannot be changed after it is submitted. To ask the Sourcing Manager a question, use a clarification request instead of voting.</span></p>
                    <a class="btn btn-sm btn-outline-brand mb-3" asp-area="Shared" asp-controller="Clarifications" asp-action="Create"><i class="bi bi-chat-dots me-1" aria-hidden="true"></i>Request further details</a>

                    <form id="realVoteForm" class="cv-vote-form" asp-area="Committee" asp-controller="Votes" asp-action="Cast" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="TenderId" value="@Model.Form.TenderId" />
                        <p id="voteFormError" class="cv-error" role="alert" hidden></p>

                        <fieldset class="cv-options">
                            <legend>Decision</legend>
                            <label class="cv-option is-approve" for="voteApprove">
                                <input class="form-check-input" type="radio" id="voteApprove" name="Vote" value="Approve" checked="@(Model.Form.Vote == "Approve")" />
                                <span class="cv-option-icon" aria-hidden="true"><i class="bi bi-hand-thumbs-up"></i></span>
                                <span class="cv-option-copy">
                                    <strong>Approve the recommended supplier</strong>
                                    <small>Vote for the supplier named in the manager-approved report.</small>
                                </span>
                            </label>
                            <label class="cv-option is-reject" for="voteReject">
                                <input class="form-check-input" type="radio" id="voteReject" name="Vote" value="Reject" checked="@(Model.Form.Vote == "Reject")" />
                                <span class="cv-option-icon" aria-hidden="true"><i class="bi bi-hand-thumbs-down"></i></span>
                                <span class="cv-option-copy">
                                    <strong>Reject the tender</strong>
                                    <small>A rejection reason of 10–1000 characters is required.</small>
                                </span>
                            </label>
                            <label class="cv-option" for="voteRetender">
                                <input class="form-check-input" type="radio" id="voteRetender" name="Vote" value="Retender" checked="@(Model.Form.Vote == "Retender")" />
                                <span class="cv-option-icon" aria-hidden="true"><i class="bi bi-arrow-repeat"></i></span>
                                <span class="cv-option-copy">
                                    <strong>Require a retender</strong>
                                    <small>A reason of 10–1000 characters is required. Sourcing must create any successor tender manually.</small>
                                </span>
                            </label>
                        </fieldset>

                        <div id="voteReasonGroup" class="cv-reason" hidden="@(Model.Form.Vote != "Reject" && Model.Form.Vote != "Retender")">
                            <label for="voteReason" class="form-label">Reason <span class="text-muted fw-normal">(required for Reject or Retender: 10–1000 characters)</span><span class="cv-reason-tag" aria-hidden="true">Required</span></label>
                            <textarea id="voteReason" name="Reason" class="form-control" rows="4" maxlength="1000" aria-describedby="voteReasonHelp voteReasonError">@Model.Form.Reason</textarea>
                            <div class="cv-reason-meta"><small id="voteReasonHelp">Your reason is shown to the other authorized committee members.</small><output id="voteReasonCount" class="cv-reason-count" for="voteReason">0 / 1000</output></div>
                            <p id="voteReasonError" class="cv-error mt-2 mb-0" role="alert" hidden></p>
                        </div>

                        <div class="cv-form-actions">
                            <button type="submit" class="btn btn-brand">Submit vote</button>
                        </div>
                    </form>
                </section>
                @* Keep the modal outside the animated panel so its top-layer hit target and focus are independent of that panel. *@
                <dialog id="voteConfirm" class="cv-confirm" aria-labelledby="voteConfirmTitle" aria-describedby="voteConfirmText">
                        <div class="cv-confirm-head">
                            <span class="cv-confirm-icon" aria-hidden="true"><i class="bi bi-shield-check"></i></span>
                            <h3 id="voteConfirmTitle">Confirm your vote</h3>
                        </div>
                        <div class="cv-confirm-body">
                            <p id="voteConfirmText" class="mb-3"></p>
                            <p class="text-muted small mb-0">This vote is recorded under your signed-in account and cannot be changed.</p>
                        </div>
                        <div class="cv-confirm-foot">
                            <button id="voteCancel" type="button" class="btn btn-outline-secondary">Cancel</button>
                            <button id="voteConfirmSubmit" type="button" class="btn btn-brand">Confirm vote</button>
                        </div>
                </dialog>
            }
        </div>

        <aside class="cv-aside">
            <section class="top-committee-panel cv-panel-static cv-enter" style="--i: 2" aria-labelledby="progressTitle">
                <div class="top-committee-panel-heading">
                    <div>
                        <span class="top-committee-eyebrow">Committee</span>
                        <h2 id="progressTitle">Voting progress</h2>
                    </div>
                    <span class="top-committee-count">@(status.VotesReceived * 25)%</span>
                </div>
                <p class="cv-progress-label"><span><strong>@status.VotesReceived / 4</strong> votes received</span></p>
                <div class="cv-progress-track" role="progressbar" aria-label="Committee voting progress" aria-valuemin="0" aria-valuemax="4" aria-valuenow="@status.VotesReceived" aria-valuetext="@status.VotesReceived of 4 members voted">
                    @for (var segment = 0; segment < 4; segment++)
                    {
                        <span class="cv-progress-segment @(segment < status.VotesReceived ? "is-filled" : "")" aria-hidden="true"></span>
                    }
                </div>
                @if (status.MemberProgress.Count > 0)
                {
                    <ul class="cv-member-list" aria-label="Committee member voting status">
                        @foreach (var member in status.MemberProgress)
                        {
                            var choiceClass = member.Vote == Statuses.VoteType.Approve ? "is-approve" : member.Vote == Statuses.VoteType.Reject ? "is-reject" : member.Vote == Statuses.VoteType.Retender ? "is-retender" : "";
                            <li class="cv-member @choiceClass">
                                <span class="cv-member-name fw-semibold">@member.DisplayName @if (member.IsCurrentUser) { <small class="text-muted fw-normal">(You)</small> }</span>
                                <span class="cv-member-state @(member.HasVoted ? "is-voted" : "")">@if (member.HasVoted) { <i class="bi bi-check-circle-fill" aria-hidden="true"></i> } @(member.HasVoted ? "Vote recorded" : "Awaiting Vote")</span>
                                @if (member.HasVoted) { <strong class="cv-member-choice">@member.Vote</strong> }
                                @if (!string.IsNullOrWhiteSpace(member.Reason))
                                {
                                    <p class="cv-member-reason">@member.Reason</p>
                                }
                            </li>
                        }
                    </ul>
                }
                @if (status.MyVote is not null)
                {
                    <div id="ownVoteSummary" class="cv-own-vote" role="status" tabindex="-1">
                        <strong class="d-block mb-1"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Already Voted</strong>
                        <p class="mb-0">Your saved choice: <strong>@status.MyVote</strong>
                        @if (status.MyVotedAt is DateTime votedAt)
                        {
                            <span class="text-muted">(@votedAt.ToString("dd MMM yyyy, HH:mm", CultureInfo.InvariantCulture) UTC)</span>
                        }
                        </p>
                        @if (!string.IsNullOrEmpty(status.MyComment))
                        {
                            <p class="mb-0 mt-1">Your saved reason: @status.MyComment</p>
                        }
                    </div>
                }
                @if (status.IsFinalized)
                {
                    <p class="cv-final-line">
                        Final decision: <strong>@(status.Outcome == Statuses.ApprovalDecision.Approved ? "Awarded" : status.Outcome == Statuses.ApprovalDecision.RetenderRequired ? "Retender Required" : "Rejected")</strong>.
                        <a asp-area="Committee" asp-controller="Votes" asp-action="Result" asp-route-id="@status.TenderId">View the decision report</a>
                    </p>
                }
            </section>
        </aside>
    </div>
</div>

@section Scripts {
    <script>
        // Double-submit guard for one-click forms (Retry final decision).
        document.querySelectorAll('form[data-cv-once]').forEach(form => {
            form.addEventListener('submit', event => {
                if (form.dataset.cvSubmitting === '1') { event.preventDefault(); return; }
                form.dataset.cvSubmitting = '1';
                const button = form.querySelector('button[type="submit"]');
                if (button) { button.disabled = true; button.setAttribute('aria-busy', 'true'); button.textContent = 'Submitting…'; }
            });
        });
    </script>
    @if (status.CanVote)
    {
        <script>
            (() => {
                const form = document.getElementById('realVoteForm');
                const dialog = document.getElementById('voteConfirm');
                const reason = document.getElementById('voteReason');
                const reasonGroup = document.getElementById('voteReasonGroup');
                const reasonCount = document.getElementById('voteReasonCount');
                const reasonError = document.getElementById('voteReasonError');
                const formError = document.getElementById('voteFormError');
                const confirmButton = document.getElementById('voteConfirmSubmit');
                const submitButton = form.querySelector('button[type="submit"]');
                const voteRadios = form.querySelectorAll('input[name="Vote"]');
                let submitting = false;

                function updateReason() {
                    const vote = form.querySelector('input[name="Vote"]:checked')?.value;
                    const needsReason = vote === 'Reject' || vote === 'Retender';
                    reasonGroup.hidden = !needsReason;
                    reason.disabled = !needsReason;
                    reasonCount.value = `${reason.value.length} / 1000`;
                }
                reason.addEventListener('input', updateReason);
                updateReason();

                // Choosing a vote clears the selection error right away.
                // (The Submit handler below still checks everything again, and so does the server.)
                voteRadios.forEach(radio => radio.addEventListener('change', () => {
                    formError.hidden = true;
                    formError.textContent = '';
                    voteRadios.forEach(item => item.removeAttribute('aria-invalid'));
                    // Approve needs no reason, so an old "reason required" message is not needed any more.
                    if (radio.value === 'Approve') {
                        reasonError.hidden = true;
                        reason.removeAttribute('aria-invalid');
                    }
                    updateReason();
                }));

                form.addEventListener('submit', event => {
                    if (submitting) { event.preventDefault(); return; }
                    const selected = form.querySelector('input[name="Vote"]:checked');
                    const text = reason.value.trim();
                    formError.hidden = true;
                    reasonError.hidden = true;
                    reason.removeAttribute('aria-invalid');
                    voteRadios.forEach(radio => radio.removeAttribute('aria-invalid'));
                    if (!selected) {
                        event.preventDefault();
                        formError.textContent = 'Choose Approve, Reject or Retender before submitting.';
                        formError.hidden = false;
                        voteRadios.forEach(radio => radio.setAttribute('aria-invalid', 'true'));
                        document.getElementById('voteApprove').focus();
                        return;
                    }
                    if (selected.value === 'Reject' && (text.length < 10 || text.length > 1000)) {
                        event.preventDefault();
                        reasonError.textContent = 'A rejection reason must be 10–1000 characters.';
                        reasonError.hidden = false;
                        reason.setAttribute('aria-invalid', 'true');
                        reason.focus();
                        return;
                    }
                    if (selected.value === 'Retender' && (text.length < 10 || text.length > 1000)) {
                        event.preventDefault();
                        reasonError.textContent = 'A retender reason must be 10–1000 characters.';
                        reasonError.hidden = false;
                        reason.setAttribute('aria-invalid', 'true');
                        reason.focus();
                        return;
                    }
                    if (typeof dialog.showModal !== 'function') return;
                    event.preventDefault();
                    document.getElementById('voteConfirmText').textContent = selected.value === 'Reject'
                        ? 'Submit your Reject vote? If any member rejects, the tender will close permanently after all four votes.'
                        : selected.value === 'Retender'
                            ? 'Submit your Retender vote? If no member rejects and a retender is requested, the current tender will close after all four votes. The Sourcing Officer must review the result and create any successor tender manually.'
                            : 'Submit your Approve vote for the recommended supplier?';
                    dialog.showModal();
                    document.getElementById('voteCancel').focus();
                });

                document.getElementById('voteCancel').addEventListener('click', () => dialog.close());
                dialog.addEventListener('close', () => {
                    if (!submitting) submitButton.focus();
                });
                confirmButton.addEventListener('click', () => {
                    if (submitting) return;
                    submitting = true;
                    confirmButton.disabled = true;
                    confirmButton.textContent = 'Submitting…';
                    submitButton.disabled = true;
                    submitButton.textContent = 'Submitting…';
                    form.submit();
                });
            })();
        </script>
    }
    @if (voteSubmitted)
    {
        <script>
            (() => {
                const dialog = document.getElementById('voteSuccessDialog');
                if (!dialog || typeof dialog.showModal !== 'function') return;
                dialog.showModal();
                document.getElementById('voteSuccessFallback').hidden = true;
                let closing = false;
                function closeSuccess() {
                    if (closing) return;
                    closing = true;
                    const finish = () => {
                        dialog.close();
                        document.getElementById('ownVoteSummary')?.focus();
                    };
                    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) finish();
                    else {
                        dialog.classList.add('is-closing');
                        window.setTimeout(finish, 180);
                    }
                }
                document.getElementById('voteSuccessContinue').addEventListener('click', closeSuccess);
                dialog.addEventListener('cancel', event => { event.preventDefault(); closeSuccess(); });
            })();
        </script>
    }
}
