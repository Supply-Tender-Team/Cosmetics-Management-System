@model string
@{
    ViewData["Title"] = "Voting unavailable";
}
@* OWNER: Abdallah (helping Dana with TOP-02) - shown instead of a 404/403 when the committee itself is not
   ready (not exactly four eligible members). Display only: nothing here changes who may vote. *@

@section Styles {
    <link rel="stylesheet" href="~/css/top-committee.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/top-committee-votes.css" asp-append-version="true" />
}

<div class="top-committee-page cv-page">
    <a class="top-committee-back-link" asp-area="Committee" asp-controller="Dashboard" asp-action="Index">
        <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>Back to dashboard
    </a>

    <section class="top-committee-hero">
        <div class="top-committee-hero-copy">
            <span class="top-committee-eyebrow"><i class="bi bi-check2-square me-2" aria-hidden="true"></i>MS.WAND · Top Committee</span>
            <h1 class="page-title">Voting is not available right now</h1>
        </div>
    </section>

    <div class="cv-notice is-warning" role="status">
        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
        <span>@Model</span>
    </div>
</div>
