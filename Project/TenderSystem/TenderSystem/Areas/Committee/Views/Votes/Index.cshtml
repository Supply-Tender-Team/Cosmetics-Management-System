@model TenderSystem.Areas.Committee.Models.Votes.VotingListViewModel
@using System.Globalization
@{
    ViewData["Title"] = "Top Committee Voting";
    // Display only; the vote page and CastVoteAsync re-check everything on the server.
    var needsMyVote = Model.Awaiting.Count(t => Model.CommitteeComplete && t.ReportReady && !t.PausedByClarification && !t.IVoted);
}
@* OWNER: Abdallah (helping Dana with TOP-02) - the voting list (/Committee/Votes).
   Shows the fixed committee's recorded choices and Reject/Retender reasons to eligible members.
   Look: top-committee.css (hero, stats, panels) + top-committee-votes.css (voting pieces). *@

@section Styles {
    <link rel="stylesheet" href="~/css/top-committee.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/top-committee-votes.css" asp-append-version="true" />
    <style>
        .cv-page .cv-member-list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .7rem; }
        .cv-page .cv-member { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-content: center; gap: .3rem .8rem; min-height: 5.5rem; padding: .85rem 1rem; background: #faf7f2; border-color: #d3ccc5; }
        .cv-page .cv-member-name { grid-column: 1; line-height: 1.35; overflow-wrap: anywhere; }
        .cv-page .cv-member-state { grid-column: 2; grid-row: 1 / span 2; align-self: center; white-space: normal; text-align: right; }
        .cv-page .cv-member-choice { grid-column: 1; }
        .cv-page .cv-member-reason { grid-column: 1 / -1; margin: .15rem 0 0; padding-top: .45rem; border-top: 1px dashed var(--warm-beige); color: var(--mocha-brown); font-size: .9rem; white-space: pre-wrap; overflow-wrap: anywhere; }
        .cv-page .cv-member.is-approve { background: #edf5ee; border-color: #9fbea8; }
        .cv-page .cv-member.is-reject { background: #f8ecec; border-color: #d9a0a7; }
        .cv-page .cv-member.is-retender { background: #fff4df; border-color: #d6b577; }
        .cv-page .cv-member-state { font-weight: 600; }
        .cv-page .cv-member-choice { color: #5d5652; font-size: 1rem; }
        .cv-page .cv-member.is-approve .cv-member-choice { color: #27563a; }
        .cv-page .cv-member.is-reject .cv-member-choice { color: #8a303b; }
        .cv-page .cv-member.is-retender .cv-member-choice { color: #725016; }
        @@media (max-width: 640px) { .cv-page .cv-member-list, .cv-page .cv-member { grid-template-columns: minmax(0, 1fr); } .cv-page .cv-member-state { grid-column: 1; grid-row: auto; text-align: left; } }
        @@media (prefers-reduced-motion: reduce) { .cv-page .cv-member { transition: none; } }
    </style>
}

@section Scripts {
    <script src="~/js/top-committee.js" asp-append-version="true"></script>
}

<div class="top-committee-page cv-page">
    <a class="top-committee-back-link" asp-area="Committee" asp-controller="Dashboard" asp-action="Index">
        <i class="bi bi-arrow-left me-2" aria-hidden="true"></i>Back to dashboard
    </a>

    <section class="top-committee-hero cv-enter" style="--i: 0">
        <div class="top-committee-hero-copy">
            <span class="top-committee-eyebrow"><i class="bi bi-check2-square me-2" aria-hidden="true"></i>MS.WAND · Top Committee</span>
            <h1 class="page-title">Final decision voting</h1>
            <p>Tenders waiting for the committee's vote, and the decisions already recorded.</p>
        </div>
        <img src="~/images/sourcing-studio-tenders.jpg" asp-append-version="true" alt="" aria-hidden="true" />
        <span class="top-committee-hero-seal" aria-hidden="true"><i class="bi bi-award"></i></span>
    </section>

    @if (!Model.CommitteeComplete)
    {
        <div class="cv-notice is-warning" role="status">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
            <span>The Top Committee currently has @Model.EligibleMembers active members instead of 4. Voting is paused until the Admin fixes the committee accounts.</span>
        </div>
    }

    <section class="top-committee-stats cv-enter" style="--i: 1" aria-label="Voting overview">
        <article class="top-committee-stat-card">
            <span class="top-committee-stat-icon" aria-hidden="true"><i class="bi bi-hourglass-split"></i></span>
            <div><span>Awaiting committee decision</span><strong class="committee-counter" data-count="@Model.Awaiting.Count">@Model.Awaiting.Count</strong></div>
        </article>
        <article class="top-committee-stat-card">
            <span class="top-committee-stat-icon" aria-hidden="true"><i class="bi bi-pencil-square"></i></span>
            <div><span>Your vote is needed</span><strong class="committee-counter" data-count="@needsMyVote">@needsMyVote</strong></div>
        </article>
        <article class="top-committee-stat-card">
            <span class="top-committee-stat-icon" aria-hidden="true"><i class="bi bi-patch-check"></i></span>
            <div><span>Completed decisions</span><strong class="committee-counter" data-count="@Model.Decided.Count">@Model.Decided.Count</strong></div>
        </article>
    </section>

    <section class="top-committee-panel cv-enter" style="--i: 2" aria-labelledby="awaitingTitle">
        <div class="top-committee-panel-heading">
            <div>
                <span class="top-committee-eyebrow">Open votes</span>
                <h2 id="awaitingTitle">Awaiting committee decision</h2>
                <p>Each tender needs all four committee members to vote before the final decision is recorded.</p>
            </div>
            <span class="top-committee-count">@Model.Awaiting.Count</span>
        </div>

        @if (Model.Awaiting.Count == 0)
        {
            <div class="top-committee-empty">
                <span aria-hidden="true"><i class="bi bi-inbox"></i></span>
                <strong>No tenders are waiting for a decision.</strong>
                <p>Tenders appear here when the Sourcing Manager forwards them to the Top Committee.</p>
            </div>
        }
        else
        {
            <ul class="cv-list">
                @{ var awaitingIndex = 0; }
                @foreach (var tender in Model.Awaiting)
                {
                    // Display only; the vote page and CastVoteAsync re-check everything on the server.
                    var canVoteNow = Model.CommitteeComplete && tender.ReportReady && !tender.PausedByClarification && !tender.IVoted;
                    <li class="cv-item @(canVoteNow ? "is-action" : "")" style="--j: @(awaitingIndex++)">
                        <div>
                            <p class="cv-number">@tender.TenderNumber</p>
                            <h3 class="cv-title">@tender.Title</h3>
                            <ul class="cv-meta">
                                <li class="cv-pill"><i class="bi bi-people" aria-hidden="true"></i>@tender.VotesReceived of 4 votes</li>
                                <li class="cv-pill @(tender.IVoted ? "is-soft" : canVoteNow ? "is-strong" : "is-blocked")"><i class="bi @(tender.IVoted ? "bi-check-circle" : canVoteNow ? "bi-pencil-square" : "bi-lock")" aria-hidden="true"></i>@(tender.IVoted ? "You voted" : canVoteNow ? "Your vote is needed" : "Voting unavailable")</li>
                                <li class="cv-pill">@tender.StatusText</li>
                            </ul>
                            <div class="cv-progress-track" role="progressbar" aria-label="Committee voting progress" aria-valuemin="0" aria-valuemax="4" aria-valuenow="@tender.VotesReceived" aria-valuetext="@tender.VotesReceived of 4 members voted">
                                @for (var segment = 1; segment <= 4; segment++) { <span class="cv-progress-segment @(segment <= tender.VotesReceived ? "is-filled" : "")" aria-hidden="true"></span> }
                            </div>
                            @if (tender.MemberProgress.Count > 0)
                            {
                                    <ul class="cv-member-list" aria-label="Committee member recorded votes">
                                        @foreach (var member in tender.MemberProgress)
                                        {
                                            var choiceClass = member.Vote == Statuses.VoteType.Approve ? "is-approve" : member.Vote == Statuses.VoteType.Reject ? "is-reject" : member.Vote == Statuses.VoteType.Retender ? "is-retender" : "";
                                            <li class="cv-member @choiceClass">
                                                <span class="cv-member-name fw-semibold">@member.DisplayName @if (member.IsCurrentUser) { <small class="text-muted fw-normal">(You)</small> }</span>
                                                <span class="cv-member-state @(member.HasVoted ? "is-voted" : "")">@if (member.HasVoted) { <i class="bi bi-check-circle-fill" aria-hidden="true"></i> } @(member.HasVoted ? "Vote recorded" : "Awaiting Vote")</span>
                                                @if (member.HasVoted) { <strong class="cv-member-choice">@member.Vote</strong> }
                                                @if (!string.IsNullOrWhiteSpace(member.Reason))
                                                {
                                                    <p class="cv-member-reason">@member.Reason</p>
                                                }
                                            </li>
                                        }
                                    </ul>
                            }
                        </div>
                        <div class="cv-actions">
                            <a class="btn cv-btn-go @(canVoteNow ? "btn-brand" : "btn-outline-brand")"
                               asp-area="Committee" asp-controller="Votes" asp-action="Cast" asp-route-id="@tender.TenderId">
                                @(canVoteNow ? "Open and vote" : "View voting")<i class="bi bi-arrow-right ms-2" aria-hidden="true"></i>
                            </a>
                        </div>
                    </li>
                }
            </ul>
        }
    </section>

    <section class="top-committee-panel cv-enter" style="--i: 3" aria-labelledby="decidedTitle">
        <div class="top-committee-panel-heading">
            <div>
                <span class="top-committee-eyebrow">Recorded</span>
                <h2 id="decidedTitle">Completed decisions</h2>
                <p>Final decisions recorded after all four members voted.</p>
            </div>
            <span class="top-committee-count">@Model.Decided.Count</span>
        </div>

        @if (Model.Decided.Count == 0)
        {
            <div class="top-committee-empty">
                <span aria-hidden="true"><i class="bi bi-journal-check"></i></span>
                <strong>No final decisions yet.</strong>
                <p>When all four members have voted, the decision is recorded and listed here.</p>
            </div>
        }
        else
        {
            <ul class="cv-list">
                @{ var decidedIndex = 0; }
                @foreach (var tender in Model.Decided)
                {
                    <li class="cv-item is-decided @(tender.Outcome == Statuses.ApprovalDecision.Approved ? "is-awarded" : "")" style="--j: @(decidedIndex++)">
                        <div>
                            <p class="cv-number">@tender.TenderNumber</p>
                            <h3 class="cv-title">@tender.Title</h3>
                            <ul class="cv-meta">
                                <li class="cv-pill @(tender.Outcome == Statuses.ApprovalDecision.Approved ? "is-awarded" : tender.Outcome == Statuses.ApprovalDecision.RetenderRequired ? "is-pending" : "is-rejected")"><i class="bi @(tender.Outcome == Statuses.ApprovalDecision.Approved ? "bi-award" : tender.Outcome == Statuses.ApprovalDecision.RetenderRequired ? "bi-arrow-repeat" : "bi-x-circle")" aria-hidden="true"></i>@(tender.Outcome == Statuses.ApprovalDecision.Approved ? "Awarded" : tender.Outcome == Statuses.ApprovalDecision.RetenderRequired ? "Retender Required" : "Rejected") · Final decision</li>
                                <li class="cv-pill"><i class="bi bi-calendar3" aria-hidden="true"></i><time datetime="@tender.DecidedAt.ToString("O")">@tender.DecidedAt.ToString("dd MMM yyyy", CultureInfo.InvariantCulture)</time></li>
                            </ul>
                            <div class="cv-progress-track" role="progressbar" aria-label="Committee voting progress" aria-valuemin="0" aria-valuemax="4" aria-valuenow="4" aria-valuetext="4 of 4 members voted">
                                @for (var segment = 1; segment <= 4; segment++) { <span class="cv-progress-segment is-filled" aria-hidden="true"></span> }
                            </div>
                        </div>
                        <div class="cv-actions">
                            <a class="btn btn-outline-brand cv-btn-go" asp-area="Committee" asp-controller="Votes" asp-action="Result" asp-route-id="@tender.TenderId">View decision report<i class="bi bi-arrow-right ms-2" aria-hidden="true"></i></a>
                        </div>
                    </li>
                }
            </ul>
            @if (Model.Decided.Count >= TenderSystem.Areas.Committee.Services.CommitteeVotingService.DecidedListSize)
            {
                <p class="cv-list-note">Showing the @Model.Decided.Count most recent decisions.</p>
            }
        }
    </section>
</div>
