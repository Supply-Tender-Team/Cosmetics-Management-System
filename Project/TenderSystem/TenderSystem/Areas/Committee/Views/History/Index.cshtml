@model TenderSystem.Areas.Committee.Models.TopCommitteeBidHistoryViewModel
@{
    ViewData["Title"] = "Bid History";
}

@section Styles {
    <link rel="stylesheet" href="~/css/top-committee.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/top-committee-history.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/top-committee.js" asp-append-version="true"></script>
    <script>
        (() => {
            const closeDialog = dialog => {
                if (typeof dialog.close === "function") dialog.close();
                else dialog.removeAttribute("open");
            };

            document.querySelectorAll("[data-history-summary-open]").forEach(button => {
                button.addEventListener("click", () => {
                    const dialog = document.getElementById(button.dataset.historySummaryOpen);
                    if (!dialog) return;
                    if (typeof dialog.showModal === "function") dialog.showModal();
                    else dialog.setAttribute("open", "");
                });
            });

            document.querySelectorAll("[data-history-summary-close]").forEach(button => {
                button.addEventListener("click", () => closeDialog(button.closest("dialog")));
            });

            document.querySelectorAll(".top-history-summary-dialog").forEach(dialog => {
                dialog.addEventListener("click", event => {
                    if (event.target === dialog) closeDialog(dialog);
                });
            });
        })();
    </script>
}

<main class="top-committee-page">
    <section class="top-committee-hero committee-reveal">
        <div class="top-committee-hero-copy">
            <span class="top-committee-eyebrow"><i class="bi bi-clock-history me-2"></i>Committee archive</span>
            <h1 class="page-title">Bid history</h1>
            <p>Look back at completed tenders, supplier bids and the decisions recorded for each tender.</p>
        </div>
        <img src="~/images/requester-cosmetics-crop.png" asp-append-version="true" alt="" aria-hidden="true" />
        <span class="top-committee-hero-seal" aria-hidden="true"><i class="bi bi-archive"></i></span>
    </section>

    <section class="top-committee-stats top-history-stats committee-reveal" aria-label="Bid history summary">
        <article class="top-committee-stat-card top-history-stat-card is-total">
            <span class="top-committee-stat-icon"><i class="bi bi-clipboard2-check"></i></span>
            <div><span>Completed decisions</span><strong>@Model.CompletedTenderCount</strong><small>All Top Committee outcomes</small></div>
        </article>
        <article class="top-committee-stat-card top-history-stat-card is-awarded">
            <span class="top-committee-stat-icon"><i class="bi bi-award"></i></span>
            <div><span>Approved / awarded</span><strong>@Model.AwardedTenderCount</strong><small>Supplier selected</small></div>
        </article>
        <article class="top-committee-stat-card top-history-stat-card is-rejected">
            <span class="top-committee-stat-icon"><i class="bi bi-x-circle"></i></span>
            <div><span>Rejected</span><strong>@Model.RejectedTenderCount</strong><small>Closed by the committee</small></div>
        </article>
        <article class="top-committee-stat-card top-history-stat-card is-retender">
            <span class="top-committee-stat-icon"><i class="bi bi-arrow-repeat"></i></span>
            <div><span>Retender required</span><strong>@Model.RetenderTenderCount</strong><small>New cycle needed</small></div>
        </article>
    </section>

    <section class="top-committee-panel committee-reveal">
        <div class="top-committee-panel-heading">
            <div><span class="top-committee-eyebrow">Search the archive</span><h2>Find a tender or supplier</h2><p>Search by tender, purchase request or supplier name.</p></div>
        </div>
        <form method="get" asp-area="Committee" asp-controller="History" asp-action="Index" class="top-history-filter">
            <label class="top-history-search">
                <span class="visually-hidden">Search tender history</span>
                <i class="bi bi-search" aria-hidden="true"></i>
                <input class="form-control" type="search" name="search" value="@Model.Search" placeholder="Tender number, title, request or supplier" />
            </label>
            <label class="top-history-outcome">
                <span class="visually-hidden">Filter by outcome</span>
                <select class="form-select" name="outcome">
                    <option value="">All outcomes</option>
                    <option value="@TenderSystem.Infrastructure.Statuses.TenderStatus.Awarded" selected="@(Model.Outcome == TenderSystem.Infrastructure.Statuses.TenderStatus.Awarded)">Awarded</option>
                    <option value="@TenderSystem.Infrastructure.Statuses.TenderStatus.Rejected" selected="@(Model.Outcome == TenderSystem.Infrastructure.Statuses.TenderStatus.Rejected)">Rejected</option>
                    <option value="@TenderSystem.Infrastructure.Statuses.TenderStatus.RetenderRequired" selected="@(Model.Outcome == TenderSystem.Infrastructure.Statuses.TenderStatus.RetenderRequired)">Retender required</option>
                </select>
            </label>
            <button class="btn btn-brand" type="submit"><i class="bi bi-funnel me-2"></i>Filter</button>
            @if (!string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.Outcome))
            {
                <a class="btn btn-outline-secondary" asp-area="Committee" asp-controller="History" asp-action="Index">Clear</a>
            }
        </form>
    </section>

    <section class="top-history-list" aria-label="Past tenders">
        @if (Model.Tenders.Count == 0)
        {
            <div class="top-committee-panel top-committee-empty committee-reveal">
                <span><i class="bi bi-inbox"></i></span>
                <strong>No past tenders found</strong>
                <p>Completed tender decisions will appear here. Try changing the search or outcome filter.</p>
            </div>
        }
        else
        {
            @foreach (var tender in Model.Tenders)
            {
                var statusLabel = tender.TenderStatus switch
                {
                    TenderSystem.Infrastructure.Statuses.TenderStatus.Awarded => "Approved / awarded",
                    TenderSystem.Infrastructure.Statuses.TenderStatus.Rejected => "Rejected",
                    TenderSystem.Infrastructure.Statuses.TenderStatus.RetenderRequired => "Retender required",
                    _ => tender.TenderStatus
                };
                var statusClass = tender.TenderStatus switch
                {
                    TenderSystem.Infrastructure.Statuses.TenderStatus.Awarded => "is-awarded",
                    TenderSystem.Infrastructure.Statuses.TenderStatus.Rejected => "is-rejected",
                    TenderSystem.Infrastructure.Statuses.TenderStatus.RetenderRequired => "is-retender",
                    _ => "is-other"
                };
                var statusIcon = tender.TenderStatus switch
                {
                    TenderSystem.Infrastructure.Statuses.TenderStatus.Awarded => "bi-check-circle",
                    TenderSystem.Infrastructure.Statuses.TenderStatus.Rejected => "bi-x-circle",
                    TenderSystem.Infrastructure.Statuses.TenderStatus.RetenderRequired => "bi-arrow-repeat",
                    _ => "bi-info-circle"
                };
                <article class="top-committee-panel top-history-card @statusClass committee-reveal">
                    <header class="top-history-heading">
                        <div>
                            <span class="top-committee-package-number">@tender.TenderNumber</span>
                            <h2>@tender.TenderTitle</h2>
                            <p>@tender.RequestNumber · @tender.RequestTitle · @tender.DepartmentName</p>
                        </div>
                        <span class="top-history-status @statusClass">
                            <i class="bi @statusIcon me-1"></i>
                            @statusLabel
                        </span>
                    </header>

                    <div class="top-history-facts">
                        <div><span>Completed</span><strong>@tender.CompletedAt.ToLocalTime().ToString("dd MMM yyyy")</strong></div>
                        <div><span>Offers received</span><strong>@tender.Bids.Count</strong></div>
                        <div><span>Selected supplier</span><strong>@(tender.AwardedSupplier ?? "No award")</strong></div>
                    </div>

                    <div class="top-history-columns">
                        <section class="top-history-section">
                            <h3><i class="bi bi-receipt me-2"></i>Supplier bids</h3>
                            @if (tender.Bids.Count == 0)
                            {
                                <p class="top-committee-muted">No submitted bids were recorded for this tender.</p>
                            }
                            else
                            {
                                <div class="table-responsive top-committee-table-wrap">
                                    <table class="table top-committee-table align-middle mb-0">
                                        <thead><tr><th>Supplier</th><th>Bid amount</th><th>Status</th><th>Submitted</th></tr></thead>
                                        <tbody>
                                            @foreach (var bid in tender.Bids)
                                            {
                                                <tr>
                                                    <td><strong>@bid.SupplierName</strong>@if (bid.IsAwarded) { <span class="top-history-winner ms-2"><i class="bi bi-award-fill me-1"></i>Selected</span> }</td>
                                                    <td>@bid.TotalPrice.ToString("N2") @bid.Currency</td>
                                                    <td><span class="top-committee-status">@bid.Status</span></td>
                                                    <td>@(bid.SubmittedAt?.ToLocalTime().ToString("dd MMM yyyy") ?? "—")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </section>

                        <section class="top-history-section">
                            <h3><i class="bi bi-journal-check me-2"></i>Decision history</h3>
                            @if (tender.Decisions.Count == 0)
                            {
                                <p class="top-committee-muted">No decision comments were recorded.</p>
                            }
                            else
                            {
                                <div class="top-history-decisions">
                                    @foreach (var decision in tender.Decisions)
                                    {
                                        var decisionClass = decision.Stage switch
                                        {
                                            "Top Committee" => "is-final",
                                            "Sourcing Manager" => "is-manager",
                                            _ => "is-vote"
                                        };
                                        <article class="top-history-decision @decisionClass">
                                            <div class="top-history-decision-heading">
                                                <div><strong>@decision.Stage</strong><span>@decision.DecidedBy</span></div>
                                                <span class="top-history-decision-badge">@decision.Decision</span>
                                            </div>
                                            <small>@decision.DecidedAt.ToLocalTime().ToString("dd MMM yyyy · h:mm tt")</small>
                                            @if (!string.IsNullOrWhiteSpace(decision.SelectedSupplier))
                                            {
                                                <p><i class="bi bi-building me-1"></i>Selected bid: <strong>@decision.SelectedSupplier</strong></p>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(decision.Comment) && decision.Stage == "Sourcing Manager")
                                            {
                                                var summaryId = $"manager-summary-{tender.TenderId}-{decision.DecidedAt.Ticks}";
                                                <div class="top-history-summary-preview">
                                                    <span><i class="bi bi-file-earmark-text me-1"></i>Manager summary</span>
                                                    <button type="button" class="top-history-summary-button" data-history-summary-open="@summaryId">
                                                        View full summary <i class="bi bi-arrow-up-right ms-1"></i>
                                                    </button>
                                                </div>
                                                <dialog id="@summaryId" class="top-history-summary-dialog" aria-labelledby="@summaryId-title">
                                                    <div class="top-history-summary-dialog-card">
                                                        <header class="top-history-summary-dialog-header">
                                                            <div>
                                                                <span class="top-committee-eyebrow">Sourcing Manager</span>
                                                                <h3 id="@summaryId-title">Manager summary</h3>
                                                                <small>@decision.DecidedAt.ToLocalTime().ToString("dd MMM yyyy · h:mm tt")</small>
                                                            </div>
                                                            <button type="button" class="top-history-summary-close" data-history-summary-close aria-label="Close manager summary">
                                                                <i class="bi bi-x-lg"></i>
                                                            </button>
                                                        </header>
                                                        @{
                                                            var summaryLines = decision.Comment
                                                                .Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries)
                                                                .Select(line => line.Trim())
                                                                .ToList();
                                                            var offerLines = summaryLines
                                                                .Where(line => line.StartsWith("•"))
                                                                .ToList();
                                                            var detailLines = summaryLines
                                                                .Where(line => line != "Top Committee summary"
                                                                    && line != "Offers:"
                                                                    && !line.StartsWith("•"))
                                                                .ToList();
                                                        }
                                                        <div class="top-history-summary-dialog-body">
                                                            <div class="top-history-summary-content">
                                                                <div class="top-history-summary-line is-heading">Top Committee summary</div>

                                                                <div class="top-history-summary-details">
                                                                    @foreach (var line in detailLines)
                                                                    {
                                                                        var separator = line.IndexOf(':');
                                                                        if (separator > 0)
                                                                        {
                                                                            var detailClass = line.StartsWith("Manager note:") ? "is-note" : "";
                                                                            <div class="top-history-summary-line is-detail @detailClass">
                                                                                <span>@line[..separator]</span>
                                                                                <strong>@line[(separator + 1)..].Trim()</strong>
                                                                            </div>
                                                                        }
                                                                    }
                                                                </div>

                                                                @if (offerLines.Count > 0)
                                                                {
                                                                    <div class="top-history-summary-line is-heading">Offers</div>
                                                                    <div class="table-responsive top-history-summary-table-wrap">
                                                                        <table class="top-history-summary-table">
                                                                            <thead>
                                                                                <tr>
                                                                                    <th>Supplier</th>
                                                                                    <th>Status</th>
                                                                                    <th>Price</th>
                                                                                    <th>Delivery</th>
                                                                                    <th>Technical</th>
                                                                                    <th>Financial</th>
                                                                                    <th>Total</th>
                                                                                </tr>
                                                                            </thead>
                                                                            <tbody>
                                                                                @foreach (var offerLine in offerLines)
                                                                                {
                                                                                    var offerParts = offerLine.TrimStart('•', ' ')
                                                                                        .Split('|', StringSplitOptions.TrimEntries);
                                                                                    if (offerParts.Length >= 7)
                                                                                    {
                                                                                        var selected = offerParts.Length > 7
                                                                                            && offerParts[7].Contains("COMMITTEE SELECTED", StringComparison.OrdinalIgnoreCase);
                                                                                        <tr class="@(selected ? "is-selected" : "")">
                                                                                            <td><strong>@offerParts[0]</strong>@if (selected) { <span class="top-history-selected-offer">Selected</span> }</td>
                                                                                            <td>@offerParts[1]</td>
                                                                                            <td>@offerParts[2]</td>
                                                                                            <td>@offerParts[3]</td>
                                                                                            <td>@offerParts[4]</td>
                                                                                            <td>@offerParts[5]</td>
                                                                                            <td><strong>@offerParts[6]</strong></td>
                                                                                        </tr>
                                                                                    }
                                                                                    else
                                                                                    {
                                                                                        <tr><td colspan="7">@offerLine</td></tr>
                                                                                    }
                                                                                }
                                                                            </tbody>
                                                                        </table>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                </dialog>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(decision.Comment))
                                            {
                                                <p class="top-history-comment">@decision.Comment</p>
                                            }
                                        </article>
                                    }
                                </div>
                            }
                        </section>
                    </div>
                </article>
            }
        }
    </section>
</main>
