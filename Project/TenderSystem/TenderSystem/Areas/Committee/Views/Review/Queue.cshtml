@model TenderSystem.Areas.Committee.Models.TopCommitteeReviewQueueViewModel
@{
    ViewData["Title"] = "Review Packages";
}

@section Styles {
    <link rel="stylesheet" href="~/css/top-committee.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/top-committee.js" asp-append-version="true"></script>
}

<main class="top-committee-page">
    <a class="top-committee-back-link" asp-area="Committee" asp-controller="Dashboard" asp-action="Index">
        <i class="bi bi-arrow-left me-2"></i>Back to dashboard
    </a>
    <section class="top-committee-hero committee-reveal">
        <div class="top-committee-hero-copy">
            <span class="top-committee-eyebrow"><i class="bi bi-folder2-open me-2"></i>Committee workspace</span>
            <h1 class="page-title">Review packages</h1>
            <p>Open a manager-approved tender package to review its request, supplier bids, evaluation report and supporting analysis.</p>
        </div>
        <img src="~/images/requester-cosmetics-crop.png" asp-append-version="true" alt="" aria-hidden="true" />
        <span class="top-committee-hero-seal" aria-hidden="true"><i class="bi bi-award"></i></span>
    </section>

    <section class="top-committee-panel committee-reveal">
        <div class="top-committee-panel-heading">
            <div><span class="top-committee-eyebrow">Awaiting final review</span><h2>Forwarded by the Sourcing Manager</h2><p>Packages are read from tenders currently awaiting Top Committee review.</p></div>
            <span class="top-committee-count">@Model.Packages.Count packages</span>
        </div>
        @if (Model.Packages.Count == 0)
        {
            <div class="top-committee-empty">
                <span><i class="bi bi-inbox"></i></span>
                <strong>No review packages yet</strong>
                <p>When the Sourcing Manager approves and forwards a high-value tender, its review package will appear here.</p>
                <a class="btn btn-outline-brand mt-2" asp-area="Committee" asp-controller="Dashboard" asp-action="Index">Return to dashboard</a>
            </div>
        }
        else
        {
            <div class="top-committee-package-grid">
                @foreach (var package in Model.Packages)
                {
                    <article class="top-committee-package-card committee-reveal">
                        <div class="top-committee-package-heading">
                            <div><span class="top-committee-package-number">@package.TenderNumber</span><h3>@package.TenderTitle</h3></div>
                            <span class="top-committee-status"><i class="bi bi-hourglass-split me-1"></i>Awaiting review</span>
                        </div>
                        <p class="top-committee-package-request">@package.RequestNumber · @package.RequestTitle</p>
                        <div class="top-committee-package-facts">
                            <span><small>Department</small><strong>@package.DepartmentName</strong></span>
                            <span><small>Supplier offers</small><strong>@package.BidCount</strong></span>
                            <span><small>Estimated value</small><strong>@package.EstimatedValue.ToString("N2") JOD</strong></span>
                        </div>
                        <div class="top-committee-recommendation-preview">
                            <span><i class="bi bi-award me-2"></i>Manager recommendation</span>
                            <strong>@(string.IsNullOrWhiteSpace(package.RecommendedSupplier) ? "No supplier named" : package.RecommendedSupplier)</strong>
                            @if (package.RecommendedPrice.HasValue) { <small>@package.RecommendedPrice.Value.ToString("N2") @package.RecommendedCurrency</small> }
                        </div>
                        <div class="top-committee-card-footer">
                            <small>Forwarded by @package.ManagerName · @package.ManagerApprovedAt.ToLocalTime().ToString("dd MMM yyyy")</small>
                            <a class="btn btn-brand" asp-area="Committee" asp-controller="Review" asp-action="Index" asp-route-id="@package.TenderId">
                                Open package <i class="bi bi-arrow-up-right ms-1"></i>
                            </a>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
</main>
