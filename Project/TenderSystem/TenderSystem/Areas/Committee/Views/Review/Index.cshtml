@model TenderSystem.Areas.Committee.Models.TopCommitteeReviewPackageViewModel
@{
    ViewData["Title"] = "Top Committee Review Package";
}

@section Styles {
    <link rel="stylesheet" href="~/css/top-committee.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/top-committee.js" asp-append-version="true"></script>
}

<main class="top-committee-page top-committee-review-page">
    <a class="top-committee-back-link" asp-area="Committee" asp-controller="Dashboard" asp-action="Index">
        <i class="bi bi-arrow-left me-2"></i>Back to dashboard
    </a>

    <section class="top-committee-hero top-committee-review-hero committee-reveal">
        <div class="top-committee-hero-copy">
            <span class="top-committee-eyebrow">Compact review package · @Model.TenderNumber · @Model.DepartmentName</span>
            <h1 class="page-title">@Model.TenderTitle</h1>
            <p>@Model.RequestNumber · @Model.RequestTitle</p>
            <div class="top-committee-tags">
                <span><i class="bi bi-hourglass-split me-2"></i>@Model.TenderStatus</span>
                <span><i class="bi bi-calendar3 me-2"></i>Needed by @Model.TargetDate.ToString("dd MMM yyyy")</span>
                <span><i class="bi bi-cash-coin me-2"></i>@Model.EstimatedValue.ToString("N2") JOD</span>
            </div>
        </div>
        <img src="~/images/requester-cosmetics-crop.png" asp-append-version="true" alt="" aria-hidden="true" />
        <span class="top-committee-hero-seal" aria-hidden="true"><i class="bi bi-award"></i></span>
    </section>

    <section class="top-committee-process-note committee-reveal">
        <span><i class="bi bi-info-circle"></i></span>
        <div>
            <strong>Review the summary, then cast your decision</strong>
            <p>The manager has forwarded the committee recommendation. If something needs clarification, route the question through the Sourcing Manager. A final rejection starts a new tender cycle.</p>
        </div>
    </section>

    <section class="top-committee-panel committee-reveal">
        <div class="top-committee-panel-heading">
            <div>
                <span class="top-committee-eyebrow">Purchase requisition</span>
                <h2>Request snapshot</h2>
                <p>The key request context behind this tender.</p>
            </div>
            <span class="top-committee-count">@Model.Priority priority</span>
        </div>
        <div class="top-committee-request-facts">
            <article><span>Request</span><strong>@Model.RequestNumber</strong></article>
            <article><span>Department</span><strong>@Model.DepartmentName</strong></article>
            <article><span>Requested by</span><strong>@Model.RequesterName</strong></article>
            <article><span>Needed by</span><strong>@Model.TargetDate.ToString("dd MMM yyyy")</strong></article>
        </div>
        <p class="top-committee-compact-reason"><strong>Reason:</strong> @Model.RequestReason</p>
    </section>

    <section class="top-committee-panel committee-reveal">
        <div class="top-committee-panel-heading">
            <div>
                <span class="top-committee-eyebrow">Sourcing Manager · @Model.ManagerApprovedAt.ToLocalTime().ToString("dd MMM yyyy")</span>
                <h2>Manager summary</h2>
                <p>Short handoff for the Top Committee after the unified report was approved.</p>
            </div>
            <span class="top-committee-approved"><i class="bi bi-check-circle-fill me-1"></i>@Model.ReportStatus</span>
        </div>
        <article class="top-committee-manager-comment">
            <span><i class="bi bi-chat-left-quote"></i></span>
            <div>
                <strong>@Model.ManagerName</strong>
                <p class="top-committee-manager-summary-text">The manager approved the unified evaluation report and forwarded the evaluation committee's selected offer for the Top Committee decision.</p>
            </div>
        </article>
        @if (!string.IsNullOrWhiteSpace(Model.ManagerNote))
        {
            <div class="top-committee-manager-note-box">
                <strong><i class="bi bi-pencil-square me-2"></i>Manager note</strong>
                <p>@Model.ManagerNote</p>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.RecommendedSupplier))
        {
            <div class="top-committee-recommended-supplier">
                <span><i class="bi bi-award me-2"></i>Manager's proposed supplier</span>
                <strong>@Model.RecommendedSupplier</strong>
                @if (Model.RecommendedPrice.HasValue)
                {
                    <span>@Model.RecommendedPrice.Value.ToString("N2") @Model.RecommendedCurrency</span>
                }
            </div>
        }
    </section>

    <section class="top-committee-panel committee-reveal">
        <div class="top-committee-panel-heading">
            <div>
                <span class="top-committee-eyebrow">Offer comparison</span>
                <h2>Evaluated offers</h2>
                <p>Only the key result for each eligible offer is shown below. Technical and financial scores combine into the total.</p>
            </div>
            <span class="top-committee-count">@Model.Bids.Count offers</span>
        </div>

        @if (Model.Bids.Count == 0)
        {
            <div class="top-committee-empty"><span><i class="bi bi-inbox"></i></span><strong>No offers attached</strong><p>No eligible supplier offers are available in this package.</p></div>
        }
        else
        {
            <div class="top-committee-compact-offer-grid">
                @foreach (var bid in Model.Bids)
                {
                    var isSelected = bid.Id == Model.ManagerSelectedBidId;
                    <article class="top-committee-compact-offer-card @(isSelected ? "is-selected" : "")">
                        <div class="top-committee-compact-offer-heading">
                            <div>
                                <span class="top-committee-eyebrow">@bid.Status</span>
                                <h3>@bid.SupplierName</h3>
                            </div>
                            @if (isSelected)
                            {
                                <span class="top-committee-recommended-tag"><i class="bi bi-award me-1"></i>Committee selected</span>
                            }
                        </div>

                        <div class="top-committee-compact-offer-facts">
                            <div><small>Total offer</small><strong>@bid.TotalPrice.ToString("N2") @bid.Currency</strong></div>
                            <div><small>Delivery</small><strong>@bid.DeliveryDays days</strong></div>
                        </div>

                        <div class="top-committee-result-grid">
                            <div><small>Technical</small><strong>@(bid.TechnicalResult?.ToString("0.##") ?? "—") <em>/ 80</em></strong></div>
                            <div><small>Financial</small><strong>@(bid.FinancialResult?.ToString("0.##") ?? "—") <em>/ 20</em></strong></div>
                            <div class="top-committee-total-result"><small>Total result</small><strong>@(bid.TotalResult?.ToString("0.##") ?? "—") <em>/ 100</em></strong></div>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <partial name="_AiTenderSummary" model="Model.TenderId" />

    <div class="top-committee-review-footer">
        <a class="btn btn-outline-brand" asp-area="Committee" asp-controller="Review" asp-action="Index"><i class="bi bi-arrow-left me-2"></i>Back to packages</a>
        <a class="btn btn-outline-brand" asp-area="Shared" asp-controller="Clarifications" asp-action="Create"><i class="bi bi-chat-dots me-2"></i>Request clarification</a>
        <a class="btn btn-brand" asp-area="Committee" asp-controller="Votes" asp-action="Cast" asp-route-id="@Model.TenderId"><i class="bi bi-check2-square me-2"></i>Open voting</a>
    </div>
</main>
