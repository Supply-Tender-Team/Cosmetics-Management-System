@model string

@{
    string status = Model ?? string.Empty;

    string background = "var(--nude-pink)";
    if (status == "New")
    {
        background = "var(--burgundy)";
    }
    else if (status == "Read")
    {
        background = "var(--nude-pink)";
    }
    else if (status == Statuses.RequestStatus.Approved
        || status == Statuses.TenderStatus.Open
        || status == Statuses.TenderStatus.Published
        || status == Statuses.TenderStatus.Awarded
        || status == Statuses.BidStatus.Accepted
        || status == Statuses.BidStatus.Compliant
        || status == Statuses.InvitationStatus.Accepted
        || status == Statuses.SupplierStatus.Approved
        || status == Statuses.ClarificationStatus.Answered
        || status == Statuses.ClarificationStatus.Resolved
        || status == Statuses.OnboardingStatus.Completed)
    {
        background = "var(--soft-pink)";
    }
    else if (status == Statuses.RequestStatus.Rejected
        || status == Statuses.TenderStatus.Cancelled
        || status == Statuses.BidStatus.Rejected
        || status == Statuses.BidStatus.NonCompliant
        || status == Statuses.InvitationStatus.Declined
        || status == Statuses.SupplierStatus.Rejected
        || status == Statuses.SupplierStatus.Suspended)
    {
        background = "var(--burgundy)";
    }

    string foreground = "var(--deep-brown)";
    if (background == "var(--burgundy)") foreground = "var(--cream-white)";
}

@if (!string.IsNullOrWhiteSpace(status))
{
    <span class="badge rounded-pill status-badge"
          style="background-color: @background; color: @foreground;">
        @status
    </span>
}
