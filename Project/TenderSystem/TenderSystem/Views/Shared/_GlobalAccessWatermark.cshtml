@* OWNER: Sara | Global page watermark component. Include from the shared dashboard layout after Wadea/Deyaa approval. *@
@inject Microsoft.AspNetCore.Identity.UserManager<TenderSystem.Data.Entities.Identity.ApplicationUser> UserManager
@{
    var currentUser = await UserManager.GetUserAsync(User);
    var viewerName = string.IsNullOrWhiteSpace(currentUser?.FullName)
        ? User.Identity?.Name ?? "Signed-in user"
        : currentUser.FullName;
    var initialTimestamp = DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm 'UTC'");
}
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="global-access-watermark" aria-hidden="true">
        @for (var index = 0; index < 12; index++)
        {
            <span class="global-access-watermark-mark">
                <img src="~/ms-wand-home/img/ms-wand-lockup.webp" alt="" />
                <span>@viewerName</span>
                <time data-access-watermark-clock>@initialTimestamp</time>
            </span>
        }
    </div>
    <style>
        .global-access-watermark { position: fixed; inset: 0; z-index: 1035; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: repeat(4, minmax(0, 1fr)); overflow: hidden; pointer-events: none; user-select: none; opacity: .14; }
        .global-access-watermark-mark { display: flex; align-items: center; justify-content: center; gap: .45rem; color: #702734; font-size: clamp(.65rem, .9vw, .9rem); font-weight: 700; transform: rotate(-28deg); white-space: nowrap; }
        .global-access-watermark-mark img { width: 3.5rem; height: auto; }
        .global-access-watermark-mark time { font-size: .8em; font-weight: 500; }
        @@media (max-width: 700px) { .global-access-watermark { grid-template-columns: repeat(2, minmax(0, 1fr)); } .global-access-watermark-mark { flex-wrap: wrap; gap: .2rem; white-space: normal; text-align: center; } .global-access-watermark-mark img { width: 2.75rem; } }
    </style>
    <script>
        (() => {
            const updateWatermarkTime = () => {
                const now = new Date();
                const text = new Intl.DateTimeFormat(undefined, {
                    year: 'numeric', month: '2-digit', day: '2-digit',
                    hour: '2-digit', minute: '2-digit', second: '2-digit',
                    hour12: false, timeZone: 'UTC', timeZoneName: 'short'
                }).format(now);
                document.querySelectorAll('[data-access-watermark-clock]').forEach(clock => clock.textContent = text);
            };
            updateWatermarkTime();
            window.setInterval(updateWatermarkTime, 1000);
        })();
    </script>
}
