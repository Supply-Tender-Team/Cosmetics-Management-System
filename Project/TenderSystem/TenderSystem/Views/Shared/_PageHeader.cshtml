@{
    string title = ViewData["Title"] as string ?? "Page";
    string? subtitle = ViewData["PageSubtitle"] as string;
    string? actionText = ViewData["PageHeaderActionText"] as string;
    string? actionUrl = ViewData["PageHeaderActionUrl"] as string;
}

<header class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div class="min-w-0">
        <h1 class="page-title mb-1">@title</h1>

        @if (!string.IsNullOrWhiteSpace(subtitle))
        {
            <p class="mb-0" style="color: var(--mocha-brown);">@subtitle</p>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(actionText)
        && !string.IsNullOrWhiteSpace(actionUrl)
        && Url.IsLocalUrl(actionUrl))
    {
        <a class="btn btn-brand flex-shrink-0" href="@actionUrl">@actionText</a>
    }
</header>