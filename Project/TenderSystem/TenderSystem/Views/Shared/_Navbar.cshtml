@{
    bool isLoggedIn = User.Identity?.IsAuthenticated == true;
}

<header class="main-navbar">

    <!-- Company logo -->
    <a class="navbar-brand"
       asp-area=""
       asp-controller="Home"
       asp-action="Index"
       aria-label="MS. WAND home">

        <img src="@Url.Content("~/images/ms-wand-tilted-blush-logo.png")"
             alt="MS. WAND"
             width="120"
             height="100" />

    </a>

    <!-- Mobile menu button -->
    <button class="navbar-toggle"
            id="navbar-toggle"
            type="button"
            aria-label="Open navigation"
            aria-controls="main-navbar-links"
            aria-expanded="false">

        <svg viewBox="0 0 24 24"
             width="24"
             height="24"
             fill="none"
             stroke="currentColor"
             stroke-width="2"
             stroke-linecap="round"
             aria-hidden="true">

            <path d="M4 6h16M4 12h16M4 18h16" />

        </svg>

    </button>

    <!-- Public website navigation -->
    <nav class="navbar-links"
         id="main-navbar-links"
         aria-label="Main navigation">

        <a asp-area=""
           asp-controller="Home"
           asp-action="Index">
            Home
        </a>

        <a asp-area=""
           asp-controller="Home"
           asp-action="About">
            About
        </a>

        <a asp-area=""
           asp-controller="Home"
           asp-action="HowItWorks">
            How It Works
        </a>

        <a asp-area=""
           asp-controller="Home"
           asp-action="Contact">
            Contact
        </a>

        @if (isLoggedIn)
        {
            <!-- Keep the team's role-based dashboard routing -->
            <a href="@DashboardRouter.UrlFor(User)">
                My Dashboard
            </a>

            <form class="logout-form"
                  asp-area=""
                  asp-controller="Account"
                  asp-action="Logout"
                  asp-antiforgery="true"
                  method="post">

                <button class="logout-button"
                        type="submit">
                    Logout
                </button>

            </form>
        }
        else
        {
            <a class="register-button"
               asp-area=""
               asp-controller="Account"
               asp-action="RegisterSupplier">
                Register
            </a>

            <a class="login-button"
               asp-area=""
               asp-controller="Account"
               asp-action="Login">
                Login
            </a>
        }

    </nav>

</header>