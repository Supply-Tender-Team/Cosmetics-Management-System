@{ var wandHome = ViewData["WandHome"] is true; }
<header class="site-header" id="site-header">
  <div class="wrap nav">
    <a class="brand" href="@(wandHome ? "#home" : Url.Action("Index", "Home") + "#home")" aria-label="MS. WAND home">
      <img class="brand__lockup" src="/ms-wand-home/img/ms-wand-lockup.webp" alt="">
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="navigation"><span></span><span></span><b class="sr-only">Menu</b></button>
    <nav id="navigation" class="nav__links" aria-label="Main navigation">
      <a href="@(wandHome ? "#home" : Url.Action("Index", "Home") + "#home")" data-spy="home">Home</a>
      <a href="@(wandHome ? "#how-it-works" : Url.Action("Index", "Home") + "#how-it-works")" data-spy="how-it-works">How It Works</a>
      <a href="@(wandHome ? "#suppliers" : Url.Action("Index", "Home") + "#suppliers")" data-spy="suppliers">Supplier Opportunities</a>
      <a asp-controller="Home" asp-action="About">About Us</a>
      <a asp-controller="Home" asp-action="Contact">Contact Us</a>
      <span class="nav__swatch" aria-hidden="true"></span>
      <span class="nav__mobile-actions">@if (User.Identity?.IsAuthenticated == true) { <a href="@DashboardRouter.UrlFor(User)">My Dashboard</a> } else { <a href="/Account/Login">Login</a> }<a class="btn btn--solid" href="/Account/RegisterSupplier">Supplier Registration</a></span>
    </nav>
    <div class="nav__actions">
      @if (User.Identity?.IsAuthenticated == true) { <a class="nav__login" href="@DashboardRouter.UrlFor(User)">My Dashboard</a> } else { <a class="nav__login" href="/Account/Login">Login</a> }
      <a class="btn btn--solid" href="/Account/RegisterSupplier">Supplier Registration</a>
    </div>
  </div>
</header>
