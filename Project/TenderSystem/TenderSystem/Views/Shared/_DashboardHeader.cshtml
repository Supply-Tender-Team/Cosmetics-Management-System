@{
    string fullName = User.FindFirst("FullName")?.Value
        ?? User.Identity?.Name
        ?? "User";

    string roleName = Roles.LabelFor(User);
}

<header class="dash-header">

    <!-- Open mobile menu / collapse desktop sidebar -->
    <button class="dashboard-menu-button"
            id="sidebarToggle"
            type="button"
            aria-controls="staff-sidebar"
            aria-expanded="true"
            aria-label="Toggle navigation">

        <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 6h16M4 12h16M4 18h16" />
        </svg>

    </button>

    <p class="dash-header-title">
        @ViewData["Title"]
    </p>

    <div class="dash-header-actions">

        <!-- Notifications popup -->
        <div class="notification-popover" id="notificationPopoverRoot">
            <button class="dashboard-icon-button notification-popover-toggle"
                    id="notificationsToggle"
                    type="button"
                    aria-label="Notifications"
                    aria-expanded="false"
                    aria-controls="notificationPopover"
                    data-notification-count-url="@Url.Action("UnreadCount", "Notifications", new { area = "Shared" })"
                    data-notification-latest-url="@Url.Action("Latest", "Notifications", new { area = "Shared" })">

                <i class="bi bi-bell" aria-hidden="true"></i>
                <span class="badge-dot" id="notifBadge" aria-live="polite" hidden></span>
            </button>

            <section class="notifications-popover-panel"
                     id="notificationPopover"
                     role="dialog"
                     aria-label="Latest notifications"
                     hidden>
                <div class="notifications-popover-heading">
                    <h2>Notifications</h2>
                    <button class="notifications-popover-close"
                            id="notificationPopoverClose"
                            type="button"
                            aria-label="Close notifications">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="notifications-popover-content"
                     id="notificationsPopoverContent"
                     aria-live="polite"
                     aria-busy="false">
                    <p class="notifications-popover-note">Open the bell to view recent notifications.</p>
                </div>

                <a class="notifications-popover-all"
                   asp-area="Shared"
                   asp-controller="Notifications"
                   asp-action="Index">
                    View all notifications
                </a>
            </section>
        </div>

        <!-- Account -->
        <div class="dropdown">

            <button class="btn user-chip dropdown-toggle"
                    type="button"
                    data-bs-toggle="dropdown"
                    aria-expanded="false"
                    aria-label="@($"Account menu: {fullName}, {roleName}")">

                <i class="bi bi-person-circle"
                   aria-hidden="true"></i>

                <span class="user-chip-text">
                    <strong>@fullName</strong>
                    <small>@roleName</small>
                </span>

            </button>

            <ul class="dropdown-menu dropdown-menu-end">

                <li>
                    <a class="dropdown-item"
                       asp-area="Shared"
                       asp-controller="Profile"
                       asp-action="Index">

                        <i class="bi bi-shield-lock"
                           aria-hidden="true"></i>

                        Profile &amp; security
                    </a>
                </li>

                <li>
                    <a class="dropdown-item"
                       asp-area=""
                       asp-controller="Home"
                       asp-action="Index">

                        <i class="bi bi-house"
                           aria-hidden="true"></i>

                        Public site
                    </a>
                </li>

                <li>
                    <hr class="dropdown-divider" />
                </li>

                <li>
                    <form asp-area=""
                          asp-controller="Account"
                          asp-action="Logout"
                          asp-antiforgery="true"
                          method="post">

                        <button class="dropdown-item" type="submit">

                            <i class="bi bi-box-arrow-right"
                               aria-hidden="true"></i>

                            Logout

                        </button>

                    </form>
                </li>

            </ul>

        </div>

    </div>

</header>