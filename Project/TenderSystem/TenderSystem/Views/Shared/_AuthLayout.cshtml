<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sourcing &amp; Tender System</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="layout-auth">
    @* LOGIN / REGISTER LAYOUT: no navbar, no footer, no sidebar. Just a centered card. *@
    <main class="auth-wrap" role="main">
        <div class="auth-card @(ViewData["AuthWide"] is true ? "auth-card-wide" : "")">
            <a class="auth-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-flower1"></i> Sourcing &amp; Tender
            </a>
            @RenderBody()
        </div>
        <a class="auth-back" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-arrow-left"></i> Back to home</a>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
