@{
    string? message = TempData["ToastMessage"] as string;
    string title = TempData["ToastTitle"] as string ?? "Notification";
    string type = (TempData["ToastType"] as string ?? "info")
        .Trim()
        .ToLowerInvariant();

    string background = "var(--cream-white)";
    if (type == "success")
        background = "var(--soft-pink)";
    else if (type == "warning")
        background = "var(--nude-pink)";
    else if (type == "danger" || type == "error")
        background = "var(--burgundy)";

    bool isError = type == "danger" || type == "error";
    string foreground = "var(--deep-brown)";
    if (isError) foreground = "var(--cream-white)";

    string toastId = "ui-toast-" + Guid.NewGuid().ToString("N");
}

@if (!string.IsNullOrWhiteSpace(message))
{
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="@toastId"
             class="toast ui-toast"
             role="@(isError ? "alert" : "status")"
             aria-live="@(isError ? "assertive" : "polite")"
             aria-atomic="true"
             style="background-color: @background; color: @foreground;">

            <div class="toast-header">
                <strong class="me-auto">@title</strong>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="toast"
                        aria-label="Close">
                </button>
            </div>

            <div class="toast-body">
                @message
            </div>
        </div>
    </div>

    <script>
        window.addEventListener("DOMContentLoaded", function () {
            var element = document.getElementById("@toastId");

            if (element && window.bootstrap && window.bootstrap.Toast) {
                window.bootstrap.Toast.getOrCreateInstance(
                    element,
                    { delay: 5000 }
                ).show();
            }
        });
    </script>
}
