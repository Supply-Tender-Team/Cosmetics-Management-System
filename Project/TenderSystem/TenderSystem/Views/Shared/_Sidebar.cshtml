@* Show the current area's menu only to roles allowed to use that area. *@
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    var isAdmin = User.IsInRole(Roles.Admin);
    var isRequester = User.IsInRole(Roles.Requester);
    var isSourcingOfficer = User.IsInRole(Roles.SourcingOfficer);
    var isEvaluationCommittee = User.IsInRole(Roles.EvaluationCommittee);
    var isSourcingManager = User.IsInRole(Roles.SourcingManager);
    var isTopCommittee = User.IsInRole(Roles.TopCommittee);
    var isSupplier = User.IsInRole(Roles.Supplier);

    var homeKey = isAdmin ? "Admin"
        : isRequester ? "Requester"
        : isSourcingOfficer ? "Sourcing"
        : isEvaluationCommittee ? "Evaluation"
        : isSourcingManager ? "Manager"
        : isTopCommittee ? "Committee"
        : isSupplier ? "Supplier"
        : "Admin";

    var areaRoleAllowed = area switch
    {
        "Admin" => isAdmin,
        "Requester" => isRequester,
        "Sourcing" => isSourcingOfficer,
        "Evaluation" => isEvaluationCommittee || isRequester || isSourcingManager || isSourcingOfficer,
        "Manager" => isSourcingManager,
        "Committee" => isTopCommittee,
        "Supplier" => isSupplier,
        _ => false
    };
    var key = areaRoleAllowed && !string.IsNullOrWhiteSpace(area) && area != "Shared" ? area : homeKey;
}

<div class="sidebar-section">Menu</div>
<partial name="@($"~/Views/Shared/Sidebars/_Sidebar{key}.cshtml")" />

@* The EVALUATION menu belongs to Evaluation Committee accounts only: only they sit on an evaluation committee (a Requester or a Manager never does). *@
@if (isEvaluationCommittee && key != "Evaluation")
{
    <div class="sidebar-section">Evaluation</div>
    <partial name="~/Views/Shared/Sidebars/_SidebarEvaluation.cshtml" />
}

<div class="sidebar-section">Everyone</div>
<partial name="~/Views/Shared/Sidebars/_SidebarShared.cshtml" />
