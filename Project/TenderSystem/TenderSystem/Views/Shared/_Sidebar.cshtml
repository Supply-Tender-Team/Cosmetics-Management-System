@* Chooses the sidebar. The menu of an AREA is shown only to the roles that area is made for. Anybody else who lands in that
   area (for example a committee member who opens /Sourcing/CommitteeBrief from a notification, or a Requester sitting on a
   committee) keeps the menu of their OWN role instead of the Sourcing Officer's menu. Shared-area pages (notifications,
   clarifications...) always use the sidebar of the signed-in user's role. Each role menu lives in Views/Shared/Sidebars/. *@
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString();
    var key = area;

    // area -> the roles whose menu it is (the Evaluation pages are open to four roles, see the Evaluation controllers)
    var areaRoles = area switch
    {
        "Admin" => new[] { Roles.Admin },
        "Requester" => new[] { Roles.Requester },
        "Sourcing" => new[] { Roles.SourcingOfficer },
        "Evaluation" => new[] { Roles.EvaluationCommittee, Roles.Requester, Roles.SourcingManager, Roles.SourcingOfficer },
        "Manager" => new[] { Roles.SourcingManager },
        "Committee" => new[] { Roles.TopCommittee },
        "Supplier" => new[] { Roles.Supplier },
        _ => Array.Empty<string>(),
    };

    if (string.IsNullOrEmpty(area) || area == "Shared" || !areaRoles.Any(User.IsInRole))
    {
        key = User.IsInRole(Roles.Admin) ? "Admin"
            : User.IsInRole(Roles.Requester) ? "Requester"
            : User.IsInRole(Roles.SourcingOfficer) ? "Sourcing"
            : User.IsInRole(Roles.EvaluationCommittee) ? "Evaluation"
            : User.IsInRole(Roles.SourcingManager) ? "Manager"
            : User.IsInRole(Roles.TopCommittee) ? "Committee"
            : User.IsInRole(Roles.Supplier) ? "Supplier"
            : "Admin"; // dev fallback while login is not built yet
    }
}

<div class="sidebar-section">Menu</div>
<partial name="@($"~/Views/Shared/Sidebars/_Sidebar{key}.cshtml")" />

<div class="sidebar-section">Everyone</div>
<partial name="~/Views/Shared/Sidebars/_SidebarShared.cshtml" />
