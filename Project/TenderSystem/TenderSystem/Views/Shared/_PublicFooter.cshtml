<footer class="footer">
  <div class="wrap footer__grid">
    <a class="brand brand--light" asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="home" aria-label="MS. WAND home">
      <img class="brand__lockup" src="/ms-wand-home/img/ms-wand-lockup.webp" alt="">
    </a>
    <div class="footer__col">
      <p class="footer__title">Explore</p>
      <a asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="how-it-works">How It Works</a><a asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="suppliers">Supplier Opportunities</a><a asp-controller="Home" asp-action="About">About Us</a>
    </div>
    <div class="footer__col">
      <p class="footer__title">Suppliers</p>
      <a href="/Account/RegisterSupplier">Supplier Registration</a>@if (User.Identity?.IsAuthenticated == true) { <a href="@DashboardRouter.UrlFor(User)">My Dashboard</a> } else { <a href="/Account/Login">Login</a> }<a asp-area="" asp-controller="Home" asp-action="Index" asp-fragment="site-film">Watch the Film</a>
    </div>
  </div>
  <div class="wrap footer__base">
    <p>© @DateTime.UtcNow.Year MS. WAND</p>
    <a class="footer__team" asp-area="" asp-controller="Home" asp-action="Team">Powered by Team</a>
  </div>
  <p class="footer__giant" aria-hidden="true">MS. <i>WAND</i></p>
</footer>
