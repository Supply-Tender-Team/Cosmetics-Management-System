<footer class="site-footer">

    <div class="footer-content">

        <!-- Company logo -->
        <div class="footer-brand">

            <a class="footer-logo"
               asp-area=""
               asp-controller="Home"
               asp-action="Index"
               aria-label="MS. WAND home">

                <img src="@Url.Content("~/images/ms-wand-tilted-blush-logo.png")"
                     alt="MS. WAND"
                     width="110"
                     height="90" />

            </a>

            <p>Sourcing &amp; Tender Management</p>

        </div>

        <!-- Links within our website -->
        <nav class="footer-section"
             aria-label="Footer navigation">

            <h2>Quick Links</h2>

            <ul class="footer-link-list">

                <li>
                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="Index">
                        Home
                    </a>
                </li>

                <li>
                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="About">
                        About Us
                    </a>
                </li>

                <li>
                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="HowItWorks">
                        How It Works
                    </a>
                </li>

                <li>
                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="Contact">
                        Contact Us
                    </a>
                </li>

            </ul>

        </nav>

        <!-- Contact and social media -->
        <div class="footer-section">

            <h2>Connect With Us</h2>

            <p class="footer-description">
                Stay connected with MS. WAND.
            </p>

            <div class="footer-social">

                <!-- Temporary platform links -->
                <a href="https://www.facebook.com/"
                   target="_blank"
                   rel="noopener noreferrer"
                   title="Temporary link to Facebook"
                   aria-label="Facebook — opens in a new tab">

                    <i class="bi bi-facebook"
                       aria-hidden="true"></i>

                    <span>Facebook</span>

                </a>

                <a href="https://www.instagram.com/"
                   target="_blank"
                   rel="noopener noreferrer"
                   title="Temporary link to Instagram"
                   aria-label="Instagram — opens in a new tab">

                    <i class="bi bi-instagram"
                       aria-hidden="true"></i>

                    <span>Instagram</span>

                </a>

                <a href="https://www.whatsapp.com/"
                   target="_blank"
                   rel="noopener noreferrer"
                   title="Temporary link to WhatsApp"
                   aria-label="WhatsApp — opens in a new tab">

                    <i class="bi bi-whatsapp"
                       aria-hidden="true"></i>

                    <span>WhatsApp</span>

                </a>

            </div>

            <a class="footer-contact-button"
               asp-area=""
               asp-controller="Home"
               asp-action="Contact">

                Contact Us

                <span aria-hidden="true">&rarr;</span>

            </a>

        </div>

    </div>

    <!-- Copyright -->
    <div class="footer-bottom">

        <p>
            &copy; @DateTime.Now.Year MS. WAND.
            All rights reserved.
        </p>

    </div>

</footer>