@inject Microsoft.Extensions.Options.IOptions<TenderSystem.Infrastructure.Options.AiChatOptions> AiChatSettings
<ul class="nav flex-column">
    @* AI-17: the full-screen assistant, in a new tab. Employees only (suppliers keep the small floating chat), and only when the assistant is on. *@
    @if (!User.IsInRole(Roles.Supplier) && AiChatSettings.Value.Provider is "ollama" or "openai")
    {
        <li class="nav-item"><a class="nav-link" asp-area="" asp-controller="Assistant" asp-action="Index" target="_blank" rel="noopener"><i class="bi bi-stars"></i><span>AI Assistant</span></a></li>
    }
    <li class="nav-item"><a class="nav-link" asp-area="Shared" asp-controller="Notifications" asp-action="Index"><i class="bi bi-bell"></i><span>Notifications</span></a></li>
    @if (!User.IsInRole(Roles.Admin))
    {
        <li class="nav-item"><a class="nav-link" asp-area="Shared" asp-controller="Clarifications" asp-action="Index"><i class="bi bi-chat-dots"></i><span>Clarifications</span></a></li>
    }
    <li class="nav-item"><a class="nav-link" asp-area="Shared" asp-controller="Reports" asp-action="Index"><i class="bi bi-graph-up"></i><span>Reports</span></a></li>
    <li class="nav-item"><a class="nav-link" asp-area="Shared" asp-controller="Profile" asp-action="Index"><i class="bi bi-shield-lock"></i><span>Profile & security</span></a></li>
</ul>
