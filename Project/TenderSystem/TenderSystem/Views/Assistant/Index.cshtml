@*
    AI-17: the full-page assistant (like ChatGPT). Saved private chats on the left, the conversation on the right.
    Files: Controllers/AssistantController.cs, Services/Ai/AiChatPageService.cs, wwwroot/css/assistant.css, wwwroot/js/assistant.js
*@
@using TenderSystem.Services.Ai
@inject AiChatPageService Pages
@{
    ViewData["Title"] = "Assistant";
    var role = AiChatPrompts.RoleOf(User);
    var suggestions = AiChatPrompts.SuggestionsFor(role);
}

@section Styles {
    <link rel="stylesheet" href="~/css/assistant.css" asp-append-version="true" />
}

@if (!Pages.Enabled)
{
    <h1 class="page-title">Assistant</h1>
    <div class="alert alert-secondary">The AI assistant is turned off. Ask the administrator to set AI_CHAT_PROVIDER in the .env file.</div>
}
else
{
    <div class="asst" id="asst"
         data-send-url="@Url.Action("Send", "Assistant")"
         data-sessions-url="@Url.Action("Sessions", "Assistant")"
         data-chat-url="@Url.Action("Chat", "Assistant")"
         data-rename-url="@Url.Action("Rename", "Assistant")"
         data-delete-url="@Url.Action("Delete", "Assistant")"
         data-delete-all-url="@Url.Action("DeleteAll", "Assistant")"
         data-export-url="@Url.Action("ExportTable", "AiChat")"
         data-max="@Pages.MaxMessageChars">

        @Html.AntiForgeryToken()

        <aside class="asst-side" id="asstSide">
            <button type="button" class="asst-new" id="asstNew"><i class="bi bi-plus-lg" aria-hidden="true"></i> New chat</button>
            <nav class="asst-list" id="asstList" aria-label="My chats"></nav>
            <div class="asst-side-foot">
                <p class="asst-note"><i class="bi bi-lock" aria-hidden="true"></i> Your chats are private. Nobody else can read them, not even an administrator. They are deleted automatically @Pages.HistoryDays days after the last message.</p>
                <button type="button" class="asst-link-danger" id="asstDeleteAll"><i class="bi bi-trash3" aria-hidden="true"></i> Delete all my chats</button>
            </div>
        </aside>

        <section class="asst-main" aria-label="Conversation">
            <header class="asst-head">
                <button type="button" class="asst-icon-btn asst-toggle" id="asstToggle" aria-label="Show my chats"><i class="bi bi-layout-sidebar" aria-hidden="true"></i></button>
                <div class="asst-head-copy">
                    <h1 class="asst-title" id="asstTitle">MS. WAND assistant</h1>
                    <span class="asst-sub">Helping you as: @Roles.LabelFor(User)</span>
                </div>
                <button type="button" class="asst-icon-btn" id="asstRename" aria-label="Rename this chat" title="Rename this chat" hidden><i class="bi bi-pencil" aria-hidden="true"></i></button>
                <button type="button" class="asst-icon-btn" id="asstDelete" aria-label="Delete this chat" title="Delete this chat" hidden><i class="bi bi-trash3" aria-hidden="true"></i></button>
            </header>

            <div class="asst-scroll" id="asstScroll">
                <div class="asst-thread" id="asstThread" aria-live="polite">
                    <div class="asst-welcome" id="asstWelcome">
                        <span class="asst-welcome-icon" aria-hidden="true"><i class="bi bi-stars"></i></span>
                        <h2>How can I help you today?</h2>
                        <p>Ask about your work in the system, or for help with a draft. I only use what you are allowed to see.</p>
                        <div class="asst-chips">
                            @foreach (var s in suggestions)
                            {
                                <button type="button" class="asst-chip" data-ask="@s">@s</button>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <form class="asst-composer" id="asstForm" autocomplete="off">
                <div class="asst-box">
                    <textarea id="asstInput" rows="1" maxlength="@Pages.MaxMessageChars" placeholder="Ask a question…" aria-label="Your question"></textarea>
                    <button type="submit" class="asst-send" id="asstSend" aria-label="Send"><i class="bi bi-arrow-up" aria-hidden="true"></i></button>
                    <button type="button" class="asst-stop" id="asstStop" aria-label="Stop" hidden><i class="bi bi-stop-fill" aria-hidden="true"></i></button>
                </div>
                <p class="asst-foot">AI can make mistakes. It is an assistant only: check important answers, humans decide.</p>
            </form>
        </section>
    </div>

    <script src="~/js/assistant.js" asp-append-version="true" defer></script>
}
