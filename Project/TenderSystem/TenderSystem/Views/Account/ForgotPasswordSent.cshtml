@{
    ViewData["Title"] = "Check your email";
}

<div class="text-center">
    <div style="font-size:3rem;color:var(--dusty-rose)"><i class="bi bi-envelope-check"></i></div>
    <h1 class="auth-title">Check your email</h1>
    <p class="auth-sub">
        If an account exists for that address, we sent a link to reset the password.
        The link works for 1 hour.
    </p>
    <a class="btn btn-brand" asp-action="Login">Back to sign in</a>
</div>
