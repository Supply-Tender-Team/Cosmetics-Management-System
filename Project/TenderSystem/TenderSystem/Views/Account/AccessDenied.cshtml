@{
    ViewData["Title"] = "Access denied";
}

<div class="text-center">
    <div style="font-size:3rem;color:var(--dusty-rose)"><i class="bi bi-shield-lock"></i></div>
    <h1 class="auth-title">Access denied</h1>
    <p class="auth-sub">Your role does not have permission to open this page.</p>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <a class="btn btn-brand" href="@DashboardRouter.UrlFor(User)">Go to my dashboard</a>
    }
    else
    {
        <a class="btn btn-brand" asp-action="Login">Sign in</a>
    }
</div>
