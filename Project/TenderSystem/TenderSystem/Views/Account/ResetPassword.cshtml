@model ResetPasswordViewModel
@{
    ViewData["Title"] = "Choose a new password";
    var linkBroken = string.IsNullOrEmpty(Model.Email) || string.IsNullOrEmpty(Model.Token);
}

<h1 class="auth-title">Choose a new password</h1>

@if (linkBroken)
{
    <p class="auth-sub">This link is not complete. Please request a new one.</p>
    <div class="text-center"><a class="btn btn-brand" asp-action="ForgotPassword">Request a new link</a></div>
}
else
{
    <p class="auth-sub">Account: <b>@Model.Email</b></p>

    <form asp-action="ResetPassword" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="Token" />

        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" autofocus />
            <div class="form-text">At least 10 characters with upper and lower case, a number and a symbol.</div>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label"></label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-brand w-100 py-2">Save new password</button>
    </form>

    <p class="auth-links"><a asp-action="Login">Back to sign in</a></p>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
