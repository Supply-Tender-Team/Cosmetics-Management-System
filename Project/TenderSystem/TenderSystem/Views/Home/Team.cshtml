@{
    ViewData["Title"] = "The team behind MS. WAND";
    var mentors = new (string Name, string Role, string Avatar, string LinkedIn)[]
    {
        ("Mohammad Frehat", "Manager of Orange Coding Academy", "mohammad.jpg", "https://www.linkedin.com/in/mohammed-frehat-9222402b"),
        ("Batool Walid", "Trainer – Orange Coding Academy", "batool.jpg", "https://www.linkedin.com/in/batool-walid-b33894228"),
        ("Anfal Dherat", "Trainer – Orange Coding Academy", "anfal.png", "https://www.linkedin.com/in/anfal-dherat")
    };
    var members = new (string Initial, string Name, string Avatar, string? Portfolio, string? GitHub, string? LinkedIn)[]
    {
        ("M", "Marwa Walid", "marwa.jpg", "https://marwam5.github.io/My-Portfolio/", "https://github.com/MarwaM5", "https://www.linkedin.com/in/marwa-albadarneh"),
        ("S", "Sara Walid", "sara.png", "https://sarasawalmeh30-debug.github.io/Project_Portfolio/", "https://github.com/sarasawalmeh30-debug", "https://www.linkedin.com/in/sara-sawalmeh-1b9399256"),
        ("W", "Wadea Yawanseh", "wadea.jpg", "https://wadeayh.github.io/WadeaPortfolio", "https://github.com/WadeaYH", "https://www.linkedin.com/in/wadea-yh-2188b6278/"),
        ("A", "Abdullah Altamimi", "abdullah.jpg", "https://stirring-dieffenbachia-f32c35.netlify.app/", "https://github.com/abdallahaltamimi1", "https://www.linkedin.com/in/abdullah-altamimi-a5b480377"),
        ("N", "Nada Alawneh", "nada.png", "https://nada-alawneh.github.io/MyPortfolio/", "https://github.com/Nada-Alawneh", "https://www.linkedin.com/in/nada-alawneh"),
        ("D", "Dana Alkhatib", "dana.jpg", "https://danaalkhateeb123.github.io/portfolio-project/", "https://github.com/DanaAlkhateeb123", "https://www.linkedin.com/in/dana-alkhateeb-3636a5422"),
        ("D", "Deyaa Alwardat", "deyaa.png", "https://deyaa-alwardat.github.io/Deyaa_Alwardat_Personal_Portfolio/", "https://github.com/Deyaa-Alwardat", "https://www.linkedin.com/in/deyaa-al-wardat")
    };
}
@section Styles {
    <link rel="stylesheet" href="~/css/ms-wand-team.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sourcing-modals.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/ms-wand-team.js" asp-append-version="true" defer></script>
}

<main class="wand-team">
    <img class="wand-team__emblem" src="~/ms-wand-home/img/ms-wand-lockup.webp" alt="" />
    <h1>The team behind MS. WAND</h1>
    <p>Pick an initial to meet the person behind it.</p>
    <div class="wand-team__initials" role="group" aria-label="Choose a team member">
        @for (var i = 0; i < members.Length; i++)
        {
            if (i == 2)
            {
                <span aria-hidden="true">.</span>
            }
            <button type="button" aria-label="Meet @members[i].Name" aria-controls="wand-member-@i"
                    aria-expanded="@(i == 0 ? "true" : "false")">
                <span class="wand-team__pan">@members[i].Initial</span>
                <span class="wand-team__pan-name">@members[i].Name.Split(' ')[0]</span>
            </button>
        }
    </div>
    <div class="wand-team__cards">
        <div class="wand-team__powder" aria-hidden="true"></div>
        <div class="wand-team__burst" aria-hidden="true">
            <img src="~/ms-wand-home/img/hero-brush.webp" alt="" />
            <img src="~/ms-wand-home/img/hero-lipstick.webp" alt="" />
            <img src="~/ms-wand-home/img/hero-polish.webp" alt="" />
            <img src="~/ms-wand-home/img/hero-serum.webp" alt="" />
            <img src="~/ms-wand-home/img/pressed-powder.jpg" alt="" class="wand-team__powder-pan" />
            <img src="~/ms-wand-home/img/hero-lipstick.webp" alt="" />
        </div>
        @for (var i = 0; i < members.Length; i++)
        {
            var member = members[i];
            var links = new[] { ("Portfolio", member.Portfolio, "bi-briefcase"), ("GitHub", member.GitHub, "bi-github"), ("LinkedIn", member.LinkedIn, "bi-linkedin") };
            <article class="wand-team__card" id="wand-member-@i" aria-labelledby="wand-member-name-@i" hidden="@(i != 0)">
                <h2 id="wand-member-name-@i">
                    <img class="wand-team__avatar" src="@Url.Content("~/ms-wand-home/img/team/" + member.Avatar)" alt="" width="64" height="64" />
                    @member.Name
                </h2>
                <ul>
                    @foreach (var (label, url, icon) in links)
                    {
                        <li>
                            @if (url is null)
                            {
                                <span>@label <small>Coming soon</small></span>
                            }
                            else
                            {
                                <a class="text-decoration-none" href="@url"><i class="bi @icon me-1" aria-hidden="true"></i>@label</a>
                            }
                        </li>
                    }
                </ul>
            </article>
        }
    </div>
    <div class="wand-mentors">
        <button type="button" class="wand-mentors__trigger">Meet the people behind the team <span aria-hidden="true">✦</span></button>
        <dialog class="wand-mentors__overlay sourcing-confirm-dialog sourcing-dialog-wide" aria-labelledby="mentorsTitle">
            <div class="sourcing-confirm-header">
                <h2 id="mentorsTitle">Meet the people behind the team</h2>
                <img class="requester-modal-art" src="~/images/requester-cosmetics-crop.png" asp-append-version="true" alt="" />
                <form method="dialog"><button class="sourcing-dialog-close" type="submit" aria-label="Close">×</button></form>
            </div>
            <div class="sourcing-confirm-body">
                <div class="wand-mentors__burst" aria-hidden="true"></div>
                <div class="wand-mentors__grid">
                    @foreach (var mentor in mentors)
                    {
                        <article class="wand-mentors__card">
                            <img class="wand-team__avatar wand-mentors__avatar" src="@Url.Content("~/ms-wand-home/img/team/" + mentor.Avatar)" alt="" width="64" height="64" />
                            <h2>@mentor.Name</h2>
                            <p>@mentor.Role</p>
                            <a class="wand-mentors__linkedin" href="@mentor.LinkedIn" target="_blank" rel="noopener noreferrer"><i class="bi bi-linkedin" aria-hidden="true"></i> LinkedIn Profile</a>
                        </article>
                    }
                </div>
                <button type="button" class="wand-mentors__motion" aria-pressed="false" hidden>Pause card motion</button>
            </div>
        </dialog>
    </div>
</main>
