@model HomeViewModel
@{ ViewData["Title"] = "Cosmetics Sourcing & Tender Management"; ViewData["WandHome"] = true; }
@section Styles {
<meta name="description" content="MS. WAND: one digital, transparent process for cosmetics sourcing and tender management.">
<meta name="theme-color" content="#FAF5F0">
<link rel="icon" type="image/webp" href="/ms-wand-home/img/ms-wand-emblem-photo.webp">
<link rel="stylesheet" href="/ms-wand-home/css/home.css">
<script src="https://cdn.jsdelivr.net/npm/gsap@@3.13.0/dist/gsap.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@@3.13.0/dist/ScrollTrigger.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/lenis@@1.1.13/dist/lenis.min.js" defer></script>
<script src="/ms-wand-home/js/powder.js" defer></script>
<script src="/ms-wand-home/js/home.js" defer></script>
<script src="~/ms-wand-home/js/hero-mirror.js" asp-append-version="true" defer></script>
}
<!-- ───────── Shared drawings: the logo and every product on the page ───────── -->
<svg class="sprite" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="g-rosegold" x1="0" x2="1">
      <stop offset="0" stop-color="#5E3D35"/><stop offset=".22" stop-color="#C99A86"/><stop offset=".38" stop-color="#F3DCCD"/>
      <stop offset=".6" stop-color="#B98271"/><stop offset="1" stop-color="#4A302C"/>
    </linearGradient>
    <linearGradient id="g-bullet" x1="0" x2="1">
      <stop offset="0" stop-color="#3E1A1F"/><stop offset=".3" stop-color="#722F37"/><stop offset=".45" stop-color="#C98F91"/>
      <stop offset=".62" stop-color="#8E3D46"/><stop offset="1" stop-color="#3E1A1F"/>
    </linearGradient>
    <linearGradient id="g-tube" x1="0" x2="1">
      <stop offset="0" stop-color="#2A1A18"/><stop offset=".35" stop-color="#4A302C"/><stop offset=".5" stop-color="#805B52"/><stop offset="1" stop-color="#22140F"/>
    </linearGradient>
    <linearGradient id="g-glass" x1="0" x2="1">
      <stop offset="0" stop-color="#C98F91"/><stop offset=".28" stop-color="#F4DCD8"/><stop offset=".55" stop-color="#E6B6B2"/><stop offset="1" stop-color="#A9696E"/>
    </linearGradient>
    <linearGradient id="g-frost" x1="0" x2="1">
      <stop offset="0" stop-color="#D8C1AE"/><stop offset=".3" stop-color="#FAF5F0"/><stop offset=".7" stop-color="#E2D5CF"/><stop offset="1" stop-color="#B9A296"/>
    </linearGradient>
    <linearGradient id="g-handle" x1="0" x2="1">
      <stop offset="0" stop-color="#2A1A18"/><stop offset=".4" stop-color="#805B52"/><stop offset=".55" stop-color="#9C7368"/><stop offset="1" stop-color="#2A1A18"/>
    </linearGradient>
    <radialGradient id="g-bristle" cx=".4" cy=".25" r=".85">
      <stop offset="0" stop-color="#FAF5F0"/><stop offset=".45" stop-color="#E2D5CF"/><stop offset=".85" stop-color="#C98F91"/><stop offset="1" stop-color="#805B52"/>
    </radialGradient>
    <radialGradient id="g-puff" cx=".38" cy=".32" r=".75">
      <stop offset="0" stop-color="#FFFFFF"/><stop offset=".5" stop-color="#F3E4DE"/><stop offset="1" stop-color="#D8B3AA"/>
    </radialGradient>
    <linearGradient id="g-logo-ring" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#E6B6B2"/><stop offset=".45" stop-color="#C98F91"/><stop offset="1" stop-color="#805B52"/>
    </linearGradient>
  </defs>


  <symbol id="p-lipstick" viewBox="0 0 60 200">
    <path d="M16 84V34Q16 22 29 13L44 4V84Z" fill="url(#g-bullet)"/>
    <path d="M22 80V36Q22 27 30 20" stroke="#E6B6B2" stroke-width="2" fill="none" opacity=".55" stroke-linecap="round"/>
    <rect x="13" y="80" width="34" height="34" rx="2" fill="url(#g-rosegold)"/>
    <rect x="9" y="112" width="42" height="86" rx="4" fill="url(#g-tube)"/>
    <rect x="9" y="112" width="42" height="5" fill="url(#g-rosegold)"/>
    <rect x="9" y="190" width="42" height="8" rx="3" fill="url(#g-rosegold)"/>
  </symbol>

  <symbol id="p-brush" viewBox="0 0 60 250">
    <path d="M19 88C7 58 12 16 30 4C48 16 53 58 41 88Z" fill="url(#g-bristle)"/>
    <path d="M24 70C21 50 24 24 30 14" stroke="#FFFFFF" stroke-width="2" fill="none" opacity=".5" stroke-linecap="round"/>
    <path d="M18 86H42L40 124H20Z" fill="url(#g-rosegold)"/>
    <path d="M20 124H40L35 246Q30 250 25 246Z" fill="url(#g-handle)"/>
  </symbol>

  <symbol id="p-polish" viewBox="0 0 90 170">
    <rect x="31" y="4" width="28" height="62" rx="4" fill="url(#g-tube)"/>
    <rect x="35" y="62" width="20" height="11" fill="url(#g-rosegold)"/>
    <rect x="8" y="71" width="74" height="95" rx="18" fill="url(#g-bullet)"/>
    <rect x="13" y="76" width="64" height="85" rx="14" fill="url(#g-glass)" opacity=".38"/>
    <rect x="17" y="82" width="9" height="66" rx="4.5" fill="#FFFFFF" opacity=".45"/>
  </symbol>

  <symbol id="p-serum" viewBox="0 0 80 200">
    <path d="M28 52V22Q28 4 40 4Q52 4 52 22V52Z" fill="url(#g-bullet)"/>
    <rect x="21" y="48" width="38" height="28" rx="3" fill="url(#g-rosegold)"/>
    <path d="M26 76H54V86Q74 90 74 108V182Q74 196 60 196H20Q6 196 6 182V108Q6 90 26 86Z" fill="url(#g-frost)"/>
    <path d="M10 126H70V182Q70 192 60 192H20Q10 192 10 182Z" fill="#E6B6B2" opacity=".75"/>
    <rect x="13" y="100" width="7" height="80" rx="3.5" fill="#FFFFFF" opacity=".55"/>
  </symbol>

  <symbol id="p-puff" viewBox="0 0 120 120">
    <circle cx="60" cy="60" r="54" fill="url(#g-puff)"/>
    <circle cx="60" cy="60" r="54" fill="none" stroke="#D8C1AE" stroke-width="2"/>
    <path d="M22 50Q60 38 98 50L98 62Q60 50 22 62Z" fill="url(#g-bullet)"/>
  </symbol>

  <symbol id="p-pan" viewBox="0 0 120 120">
    <circle cx="60" cy="60" r="56" fill="url(#g-rosegold)"/>
    <circle cx="60" cy="60" r="47" fill="#C98F91"/>
    <circle cx="60" cy="60" r="47" fill="url(#g-puff)" opacity=".35"/>
  </symbol>
</svg>

<a class="skip" href="#main">Skip to content</a>

<canvas class="powder-canvas" aria-hidden="true"></canvas>





  <!-- ───────── 1 · Home: the compact opens ───────── -->
  <section class="hero" id="home" aria-labelledby="hero-title">
    <div class="hero__glow" aria-hidden="true"></div>
    <svg class="hero__silk" viewBox="0 0 1440 900" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
      <defs>
        <linearGradient id="silk-a" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0" stop-color="#722F37"/><stop offset=".35" stop-color="#C98F91"/><stop offset=".55" stop-color="#F3D9D3"/>
          <stop offset=".75" stop-color="#C98F91"/><stop offset="1" stop-color="#722F37"/>
        </linearGradient>
      </defs>
      <path class="silk silk--back" d="M-60 720C220 540 380 820 640 610S980 230 1180 380 1400 640 1520 470"/><path class="silk-current silk-current--back" pathLength="100" d="M-60 720C220 540 380 820 640 610S980 230 1180 380 1400 640 1520 470"/>
      <path class="silk silk--front" d="M-80 300C200 180 360 470 620 420S940 120 1140 230 1360 120 1520 90"/><path class="silk-current silk-current--front" pathLength="100" d="M-80 300C200 180 360 470 620 420S940 120 1140 230 1360 120 1520 90"/>
      <path class="silk silk--sheen" d="M-80 300C200 180 360 470 620 420S940 120 1140 230 1360 120 1520 90"/>
    </svg>

    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="hero__intro" aria-hidden="true">Open your source</p>
        <h1 id="hero-title" class="hero__title">
          <span class="line"><span>Sourcing and</span></span>
          <span class="line"><span>tenders for</span></span>
          <span class="line"><span>cosmetics, in</span></span>
          <span class="line"><span>one place.</span></span>
        </h1>
        <p class="hero__lead">Purchase requests, supplier bids, evaluation and award in one digital, transparent process for our cosmetics manufacturing.</p>
        <div class="hero__ctas">
          <a class="btn btn--solid btn--lg" href="/Account/RegisterSupplier">Register as a supplier</a>
          <a class="btn btn--ghost btn--lg" href="#how-it-works">See how it works</a>
        </div>
      </div>

      <div class="stage">
        <div class="hero-mirror-control">
          <button class="btn btn--solid" type="button" id="heroMirrorToggle" aria-controls="heroMirrorVideo" aria-pressed="false" hidden>See your beauty</button>
          <p class="hero-mirror-status" id="heroMirrorStatus" role="status"></p>
        </div>
        <div class="stage__floor"></div>
        <div class="compact-wrap">
          <div class="compact">
            <div class="compact__side"></div>
            <div class="compact__base">
              <div class="compact__pan"><img class="compact__emboss" src="/ms-wand-home/img/ms-wand-emblem-photo.webp" alt=""></div>
            </div>
            <div class="compact__lid">
              <div class="lid__face lid__face--top"><img class="lid__logo" src="/ms-wand-home/img/ms-wand-emblem-photo.webp" alt="" aria-hidden="true"></div>
              <div class="lid__face lid__face--mirror" aria-hidden="true"><video id="heroMirrorVideo" muted autoplay playsinline hidden></video></div>
            </div>
          </div>
        </div>

        <div class="prod" data-prod="lipstick"><div class="prod__drift"><div class="prod__par" data-depth="1.4"><img class="prod__art" src="/ms-wand-home/img/hero-lipstick.webp" alt="" decoding="async"></div></div></div>
        <div class="prod" data-prod="brush"><div class="prod__drift"><div class="prod__par" data-depth="0.8"><img class="prod__art" src="/ms-wand-home/img/hero-brush.webp" alt="" decoding="async"></div></div></div>
        <div class="prod" data-prod="polish"><div class="prod__drift"><div class="prod__par" data-depth="1.1"><img class="prod__art" src="/ms-wand-home/img/hero-polish.webp" alt="" decoding="async"></div></div></div>
        <div class="prod" data-prod="serum"><div class="prod__drift"><div class="prod__par" data-depth="0.6"><img class="prod__art" src="/ms-wand-home/img/hero-serum.webp" alt="" decoding="async"></div></div></div>
        <div class="prod" data-prod="puff"><div class="prod__drift"><div class="prod__par" data-depth="1.8"><img class="prod__art" src="/ms-wand-home/img/hero-puff.webp" alt="" decoding="async"></div></div></div>
      </div>
    </div>

    <p class="hero__hint" aria-hidden="true"><span class="hero__hint-dot"></span>Tap anywhere to dust</p>
    <a class="hero__scroll" href="#how-it-works" aria-label="Scroll to How It Works"><span></span></a>
  </section>

  <!-- ───────── 2 · How it works: the bottle fills with every step ───────── -->
  <section class="how" id="how-it-works" aria-labelledby="how-title">
    <div class="how__pin">
      <div class="wrap how__grid">
        <div class="how__head">
          <h2 id="how-title" class="h2">From need to award.</h2>
          <p class="how__sub">Follow one order for 30&nbsp;mL serum bottles through the six steps of a tender.</p>
          <ol class="how__steps" aria-label="Tender steps">
            <li><button type="button" data-step="0" aria-pressed="true"><span class="how__n">1</span>Identify need</button></li>
            <li><button type="button" data-step="1" aria-pressed="false"><span class="how__n">2</span>Create purchase request</button></li>
            <li><button type="button" data-step="2" aria-pressed="false"><span class="how__n">3</span>Create tender</button></li>
            <li><button type="button" data-step="3" aria-pressed="false"><span class="how__n">4</span>Receive bids and offers</button></li>
            <li><button type="button" data-step="4" aria-pressed="false"><span class="how__n">5</span>Technical and financial evaluation</button></li>
            <li><button type="button" data-step="5" aria-pressed="false"><span class="how__n">6</span>Final decision and award</button></li>
            <span class="how__swatch" aria-hidden="true"><span></span></span>
          </ol>
        </div>

        <div class="how__detail" aria-live="polite" aria-atomic="true">
          <p class="how__count"><span id="how-num">1</span><small>of 6</small></p>
          <h3 id="how-step-title">Identify need</h3>
          <p id="how-step-text">Production defines what is needed, why, and by when. A new serum launch needs 30&nbsp;mL glass bottles that fit the existing filling line.</p>
          <p class="how__out" id="how-step-out">Result: a confirmed production need</p>
          <button class="btn btn--ghost how__film-btn" type="button" data-open-film>Watch the 36-second walkthrough</button>
        </div>

        <div class="bottle" aria-hidden="true">
          <svg class="bottle__svg" viewBox="0 0 260 520">
            <defs>
              <clipPath id="bottle-inside"><path d="M78 196Q30 206 30 260V462Q30 496 64 496H196Q230 496 230 462V260Q230 206 182 196Z"/></clipPath>
              <linearGradient id="liquid" x1="0" x2="0" y1="0" y2="1">
                <stop offset="0" stop-color="#E6B6B2"/><stop offset=".5" stop-color="#C98F91"/><stop offset="1" stop-color="#722F37"/>
              </linearGradient>
            </defs>
            <image href="/ms-wand-home/img/hero-serum.webp" x="22" y="14" width="216" height="490" preserveAspectRatio="none"/>
            <rect class="bottle__drop" x="124" y="176" width="12" height="16" rx="6" fill="#C98F91"/>
            <g clip-path="url(#bottle-inside)">
              <g class="bottle__liquid">
                <path class="bottle__wave" d="M-200 0Q-150 -14 -100 0T0 0T100 0T200 0T300 0T400 0T500 0V400H-200Z" fill="url(#liquid)"/>
              </g>
              <g class="bottle__bubbles" fill="#FAF5F0" opacity=".7">
                <circle cx="90" cy="470" r="4"/><circle cx="150" cy="480" r="3"/><circle cx="190" cy="460" r="5"/><circle cx="120" cy="490" r="2.5"/>
              </g>
            </g>
            <image href="/ms-wand-home/img/hero-serum.webp" x="22" y="14" width="216" height="490" preserveAspectRatio="none" clip-path="url(#bottle-inside)" opacity=".2"/>
            <g class="bottle__label">
              <rect x="70" y="300" width="120" height="120" rx="60" fill="#FAF5F0" opacity=".88"/>
              <image href="/ms-wand-home/img/ms-wand-emblem-photo.webp" x="91" y="307" width="78" height="78" preserveAspectRatio="xMidYMid meet"/>
              <text x="130" y="396" text-anchor="middle" class="bottle__ml">30 mL</text>
            </g>
          </svg>
          <div class="seal" aria-hidden="true"><span>Awarded</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ───────── 3 · Supplier opportunities: the palette ───────── -->
  <section class="suppliers" id="suppliers" aria-labelledby="sup-title">
    <div class="wrap">
      <div class="sup__head">
        <h2 id="sup-title" class="h2">Your expertise could win the next tender.</h2>
        <p class="sup__lead">If you supply ingredients, packaging or manufacturing services, register once and take part in the tenders that match what you do.</p>
      </div>

      <div class="palette" role="list">
        <div class="palette__rim" aria-hidden="true"></div>
        <article class="pan" role="listitem" tabindex="0" style="--shade:#E6B6B2;--shade-deep:#C98F91">
          <div class="pan__disc" aria-hidden="true"><span class="pan__swipe"></span></div>
          <h3>Ingredients</h3>
          <p>Actives, oils, pigments and fragrance, with grade, specification and quality documents defined up front.</p>
        </article>
        <article class="pan" role="listitem" tabindex="0" style="--shade:#D8C1AE;--shade-deep:#805B52">
          <div class="pan__disc" aria-hidden="true"><span class="pan__swipe"></span></div>
          <h3>Packaging</h3>
          <p>Glass, closures and cartons, with dimensions, finish and filling-line fit spelled out before you quote.</p>
        </article>
        <article class="pan" role="listitem" tabindex="0" style="--shade:#C98F91;--shade-deep:#722F37">
          <div class="pan__disc" aria-hidden="true"><span class="pan__swipe"></span></div>
          <h3>Manufacturing services</h3>
          <p>Filling, assembly and testing, with capacity, delivery windows and acceptance criteria agreed in writing.</p>
        </article>
      </div>

      <div class="ticker" aria-label="Example tenders">
        <div class="ticker__track">
          <span class="chip"><b>30 mL frosted dropper bottles</b><em class="tag tag--open">Accepting offers</em></span>
          <span class="chip"><b>Rosehip seed oil, cold-pressed</b><em class="tag tag--eval">Under evaluation</em></span>
          <span class="chip"><b>Folding cartons, soft-touch</b><em class="tag tag--won">Awarded</em></span>
          <span class="chip"><b>Lipstick bullet filling, 40k units</b><em class="tag tag--open">Accepting offers</em></span>
          <span class="chip"><b>Rose-gold compact cases</b><em class="tag tag--eval">Under evaluation</em></span>
          <span class="chip"><b>Hyaluronic acid, cosmetic grade</b><em class="tag tag--open">Accepting offers</em></span>
        </div>
      </div>

      <div class="sup__route">
        <ol class="route">
          <li><button type="button" class="route__card"><strong>Find your fit</strong><span>Read the specification, eligibility and deadline.</span><span class="route__reveal" aria-hidden="true" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12l5 5L20 6"/></svg></span></button></li>
          <li><button type="button" class="route__card"><strong>Make your offer</strong><span>Send your quote, documents and any samples requested.</span><span class="route__reveal" aria-hidden="true" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h8l4 4v14H6z M14 3v5h4 M9 14l2 2 4-4"/></svg></span></button></li>
          <li><button type="button" class="route__card"><strong>Compete for the award</strong><span>Eligible offers are scored on technical and financial criteria.</span><span class="route__reveal" aria-hidden="true" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 4h8v6a4 4 0 0 1-8 0z M8 6H4v2a4 4 0 0 0 4 4 M16 6h4v2a4 4 0 0 1-4 4 M12 14v5 M8 20h8"/></svg></span></button></li>
        </ol>
        <fieldset class="route-palette">
          <legend>Makeup palette</legend>
          <p id="palette-help">Pick a shade, then sweep.</p>
          <div class="route-palette__pans" aria-describedby="palette-help">
            <button type="button" data-shade="cream-white" aria-label="Cream White" aria-pressed="false"></button>
            <button type="button" data-shade="nude-pink" aria-label="Nude Pink" aria-pressed="false"></button>
            <button type="button" data-shade="warm-beige" aria-label="Warm Beige" aria-pressed="false"></button>
            <button type="button" data-shade="soft-pink" aria-label="Soft Pink" aria-pressed="false"></button>
            <button type="button" data-shade="dusty-rose" aria-label="Dusty Rose" aria-pressed="false"></button>
            <button type="button" data-shade="mocha-brown" aria-label="Mocha Brown" aria-pressed="false"></button>
            <button type="button" data-shade="burgundy" aria-label="Burgundy" aria-pressed="false"></button>
            <button type="button" data-shade="deep-brown" aria-label="Deep Brown" aria-pressed="false"></button>
          </div>
          <span class="route-palette__status" role="status"></span>
        </fieldset>
      </div>

      <div class="stats" aria-labelledby="stats-title">
        <h3 id="stats-title" class="stats__title">Platform at a glance</h3>
        <dl>
          <div><dt>Active tenders</dt><dd data-count="@Model.ActiveTenders">@Model.ActiveTenders.ToString("N0")</dd></div>
          <div><dt>Approved suppliers</dt><dd data-count="@Model.ApprovedSuppliers">@Model.ApprovedSuppliers.ToString("N0")</dd></div>
          <div><dt>Completed requests</dt><dd data-count="@Model.CompletedRequests">@Model.CompletedRequests.ToString("N0")</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- ───────── 4 · About: serum backdrop ───────── -->
  <section class="about" id="about" aria-labelledby="about-title">
    <div class="about__backdrop" aria-hidden="true">
      <video muted loop playsinline preload="none" data-src="@Url.Content("~/ms-wand-home/video/about-background.mp4")"></video>
    </div>
    <div class="wrap about__grid">
      <div class="about__copy">
        <h2 id="about-title" class="h2">Quality begins at the source.</h2>
        <p class="about__mission" data-words>MS. WAND brings cosmetics sourcing and tender management into one digital workflow. We help purchasing and quality teams make decisions they can trace, and give every supplier clear requirements so they can compete fairly.</p>
        <ul class="about__values">
          <li><svg aria-hidden="true"><use href="#p-pan"/></svg><span><strong>Traceable</strong>Every request, offer and score is recorded.</span></li>
          <li><svg aria-hidden="true"><use href="#p-pan"/></svg><span><strong>Fair</strong>The same specification and deadline for every bidder.</span></li>
          <li><svg aria-hidden="true"><use href="#p-pan"/></svg><span><strong>Digital</strong>No paper bids and no lost email threads.</span></li>
        </ul>
        <a class="btn about__story-link" asp-controller="Home" asp-action="About">Discover the MS. WAND story <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <!-- ───────── 5 · Contact ───────── -->
  <section class="intro-film" id="site-film" aria-labelledby="site-film-title">
    <div class="wrap">
      <header class="intro-film__copy">
        <p class="kicker">The MS. WAND film</p>
        <h2 class="h2" id="site-film-title">Before beauty reaches the shelf.</h2>
        <p>See how MS. WAND turns a cosmetics production need into a tender, brings suppliers into the process, and traces the decision through to award.</p>
      </header>
      <div class="intro-film__frame">
        <video controls playsinline preload="none" poster="/ms-wand-home/img/home-film-cover.webp" aria-labelledby="site-film-title">
          <source src="@Url.Action("WalkthroughFilm", "Home")" type="video/mp4">
          <a href="@Url.Action("WalkthroughFilm", "Home")">Open the film</a>
        </video>
      </div>
    </div>
  </section>

<div class="travel-polish" aria-hidden="true">
  <span class="travel-polish__product">
    <img src="@Url.Content("~/ms-wand-home/img/open-nail-polish-unbranded.webp")" asp-append-version="true" alt="" width="300" height="330">

  </span>
  <svg class="travel-polish__spill" viewBox="0 0 132 44">
    <defs>
      <linearGradient id="polish-liquid" x2="0%" y2="100%">
        <stop stop-color="#C98F91"/><stop offset=".24" stop-color="#722F37"/><stop offset=".78" stop-color="#722F37"/><stop offset="1" stop-color="#4A302C"/>
      </linearGradient>
    </defs>
    <path class="polish-pool" fill="url(#polish-liquid)" d="M101 25C89 18 77 19 66 21S38 18 23 21C11 22 3 28 4 34s9 8 24 8c17 0 29-2 45-1s35 0 37-7c1-3-3-7-9-9Z"/>
    <path class="polish-thread" pathLength="1" d="M130 2 C120 3 125 22 111 28 S101 30 91 32"/>
    <path class="polish-reflection" pathLength="1" d="M129 2 C119 5 124 21 110 27 S101 29 91 31"/>
  </svg>
  <span class="travel-polish__chapter"><strong></strong></span>
