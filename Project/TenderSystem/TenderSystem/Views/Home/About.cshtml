@{
    ViewData["Title"] = "About MS. WAND";
}

@section Styles {
    <link rel="stylesheet" href="~/css/about-ms-wand.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/about-ms-wand.js" asp-append-version="true" defer></script>
}

<div class="wand-about">
    <div class="wand-lipstick-trail" aria-hidden="true" hidden>
        <template><img class="wand-lipstick-swatch" src="~/ms-wand-home/img/about-lipstick-swatch.png" asp-append-version="true" alt="" /></template>
        <span class="wand-lipstick-caption"></span>
        <img src="~/ms-wand-home/img/hero-lipstick.webp" asp-append-version="true" alt="" />
    </div>
    <section class="wand-hero-scroll" aria-labelledby="wand-title">
        <video class="wand-hero-video" muted loop playsinline preload="metadata" width="1280" height="720" aria-hidden="true"
               src="@Url.Action("AboutHeroFilm", "Home")"></video>
        <div class="wand-section container wand-vision">
        <div class="wand-hero-controls">
            <button type="button" class="btn wand-sound" aria-pressed="false" hidden>Play soundtrack</button>
            <audio loop preload="none" src="~/ms-wand-home/video/about-soundtrack.m4a"></audio>
        </div>

        <div>
            <p class="wand-kicker">About MS. WAND</p>
            <h1 class="page-title" id="wand-title">
                <span class="visually-hidden">Where luxury beauty meets procurement intelligence.</span>
                <span class="wand-film-caption" aria-hidden="true">
                    <span data-film-cue="0">Beauty begins at the source.</span>
                    <span data-film-cue="2" hidden>Turn a need into a tender.</span>
                    <span data-film-cue="4" hidden>Compare offers with clarity.</span>
                    <span data-film-cue="6" hidden>Follow every decision to award.</span>
                </span>
            </h1>
            <a class="btn btn-brand" href="#our-story">Discover our journey <span aria-hidden="true">↓</span></a>
        </div>


    </div></section>



    <section class="wand-story" id="our-story" aria-labelledby="wand-story-title">
        <div class="container wand-section">
            <p class="wand-kicker">Our story</p>
            <div class="wand-story__editorial">
                <h2 id="wand-story-title">From scattered requests to a clear process.</h2>
                <figure class="wand-story__scene" aria-hidden="true">
                    <img src="~/ms-wand-home/img/about-editorial.webp" alt="" loading="lazy" />
                    <img src="~/ms-wand-home/img/about-impact-serum.webp" alt="" loading="lazy" />
                    <img src="~/ms-wand-home/img/lab.webp" alt="" loading="lazy" />
                    <img class="wand-story__emblem" src="~/ms-wand-home/img/ms-wand-emblem-photo.webp" alt="" loading="lazy" />
                </figure>
            </div>
            <div class="wand-chapters">
                <details name="wand-story-chapters" open><summary>The past</summary><p>Finding the right ingredient or bottle meant chasing email threads, reconciling spreadsheets, and comparing quotations that arrived in different formats.</p></details>
                <details name="wand-story-chapters"><summary>The turning point</summary><p>The precision that goes into a formula should also go into how its ingredients and packaging are sourced. That idea became MS. WAND.</p></details>
                <details name="wand-story-chapters"><summary>Where we are today</summary><p>Purchase requests, quotations, evaluations, and decisions follow a documented path. Teams can see which requirements shaped the award and where a request is in the process.</p></details>
            </div>
        </div>
    </section>

    <section class="container wand-section" aria-labelledby="wand-values">
        <p class="wand-kicker">Our values</p>
        <h2 id="wand-values">What guides the way we work.</h2>
        <div class="wand-grid wand-grid--four">
            <article><h3>Fair competition</h3><p>Suppliers receive a common specification and deadline. Access controls keep individual offers private.</p></article>
            <article><h3>AI-assisted review</h3><p>Our planned AI assistant will help reviewers compare technical and commercial information. Evaluation and award decisions stay with the authorized teams.</p></article>
            <article><h3>Accountable access</h3><p>Role-based access gives each team the information it needs. Face and fingerprint sign-in are planned additions.</p></article>
            <article><h3>Clear handoffs</h3><p>Each team can see what it needs to review, what to record, and who takes the next decision.</p></article>
        </div>
    </section>

    <section class="wand-impact" aria-labelledby="wand-impact">
        <div class="container wand-section wand-impact__grid">
            <figure class="wand-impact__film">
                <video muted loop playsinline preload="none" width="1280" height="720" poster="~/ms-wand-home/img/about-details.webp" aria-labelledby="wand-impact">
                    <source src="~/ms-wand-home/video/about-details.mp4" type="video/mp4" />
                </video>
            </figure>
            <div>
                <p class="wand-kicker">Built for cosmetics</p>
                <h2 id="wand-impact">The details behind every launch.</h2>
                <dl>
                    <div><dt>Raw materials</dt><dd>Specify grades, quality documentation, and lead times for oils, extracts, and other ingredients.</dd></div>
                    <div><dt>Packaging</dt><dd>Compare glass, closures, finishes, and compatibility with the filling line alongside price.</dd></div>
                    <div><dt>Manufacturing equipment</dt><dd>Document specifications, delivery, and service terms for lab equipment and production lines.</dd></div>
                </dl>
            </div>
        </div>
    </section>

    <section class="wand-engine" aria-labelledby="wand-engine">
        <div class="container wand-section">
            <p class="wand-kicker">Technology roadmap</p>
            <h2 id="wand-engine">The technology behind the workflow.</h2>
            <div class="wand-grid wand-grid--four">
                <article><h3>Ollama AI</h3><p>Planned support for extracting relevant details and comparing bids during committee review.</p></article>
                <article><h3>Biometric access</h3><p>Planned face and fingerprint sign-in to strengthen account access.</p></article>
                <article><h3>Voice search</h3><p>Planned voice input to help employees find tasks faster.</p></article>
                <article><h3>Role-based clarification</h3><p>Planned questions and replies routed to the people responsible for each tender stage.</p></article>
            </div>
        </div>
    </section>

    <section class="wand-finale" aria-labelledby="wand-finale">
        <div class="container wand-section">
            <img src="~/ms-wand-home/img/ms-wand-emblem-photo.webp" alt="" width="90" height="90" loading="lazy" />
            <h2 id="wand-finale">Source what your next launch needs.</h2>
            <p>Join the supplier network to bring your ingredients, packaging, or manufacturing expertise to future tenders. If you’re evaluating the platform for your team, get in touch.</p>
            <div class="d-flex justify-content-center flex-wrap gap-2">
                <a class="btn btn-brand" asp-controller="Account" asp-action="RegisterSupplier">Apply as a supplier</a>
                <a class="btn wand-contact" asp-controller="Home" asp-action="Contact">Contact our team</a>
                <a class="btn wand-contact" asp-controller="Home" asp-action="Index" asp-fragment="site-film">Watch the platform film</a>
            </div>
        </div>
    </section>
</div>
