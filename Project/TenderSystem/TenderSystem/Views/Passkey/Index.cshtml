@using TenderSystem.Services.Biometrics
@{
    ViewData["Title"] = "Fingerprint sign-in";
    ViewData["AuthWide"] = true;
    ViewData["Reload"] = true;
    var devices = (ViewData["Devices"] as List<PasskeyDevice>) ?? [];
}

@section Styles {
    <link rel="stylesheet" href="~/css/face.css" asp-append-version="true" />
}

<h1 class="auth-title">Set up fingerprint sign-in</h1>
<p class="auth-sub">
    Use your device's fingerprint, Face ID or screen lock. We never see it: only a public key is saved.
    Set up the laptop and the phone you will sign in from.
</p>

@if (devices.Count > 0)
{
    <h6 class="text-uppercase text-muted small">Your devices</h6>
    <ul class="list-group mb-4">
        @foreach (var d in devices)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center">
                <span>
                    <i class="bi @(d.AuthenticatorType == "platform" ? "bi-laptop" : "bi-phone")"></i>
                    <b>@d.DeviceName</b>
                    <small class="text-muted d-block">
                        Added @d.CreatedAt.ToString("yyyy-MM-dd") &middot;
                        @(d.LastUsedAt is null ? "never used" : "last used " + d.LastUsedAt.Value.ToString("yyyy-MM-dd HH:mm"))
                    </small>
                </span>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-passkey-remove="@d.Id"
                        data-url="@Url.Action("Remove", "Passkey")">Remove</button>
            </li>
        }
    </ul>
}

<partial name="_PasskeyRegister" />

<p class="auth-links"><a href="@DashboardRouter.UrlFor(User)">Back to my dashboard</a></p>

@section Scripts {
    <script src="~/js/passkey.js" asp-append-version="true"></script>
}
