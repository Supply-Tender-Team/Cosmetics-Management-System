# ============================================================================
#  Copy this file to ".env" (same folder) and fill in YOUR values.
#  ".env" is ignored by git, so your keys and passwords are never pushed.
#  Program.cs loads it automatically at startup.
# ============================================================================

SEED_TEST_USERS=false
SEED_DEMO_DATA=false

# ---- Database (SQL Server) -------------------------------------------------
# Option A: LocalDB (comes with Visual Studio)  <- default
DB_CONNECTION=Server=localhost;Database=TenderSystemDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true
# Option B: SQL Server / Express on your machine
# DB_CONNECTION=Server=localhost;Database=TenderSystemDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true
# Option C: SQL login
# DB_CONNECTION=Server=localhost;Database=TenderSystemDb;User Id=sa;Password=YourStrong!Pass;TrustServerCertificate=True

# ---- THE public address of the site: the ONE place to change it ----
# Local work:        PUBLIC_URL=https://localhost:7180
# With a tunnel:     PUBLIC_URL=https://your-link.trycloudflare.com   (paste the new link each time, then restart the app)
# It feeds the links inside emails and the fingerprint (WebAuthn) settings automatically.
PUBLIC_URL=https://continuous-removing-buffer-gather.trycloudflare.com

# ---- Ollama (AI bid analysis) ----------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b
OLLAMA_TIMEOUT_SECONDS=120
# AI_SUMMARY_TIMEOUT_SECONDS: time allowed for ONE AI summary of a whole tender (AI-06). A local model on a CPU can be slow.
# AI_SUMMARY_TIMEOUT_SECONDS=300
AI_ACTIONS=true
# Voice typing in the assistant chat (AI-12): with a local Whisper model the audio stays in the company; without it the browser's own speech recognition is used.
# VOICE_MODEL_PATH=C:\models\ggml-small.bin
# Reading the files attached to offers (AI-13): PDF, Word, Excel and text. Defaults shown, all optional. AI_READ_DOCUMENTS=false = names only.
# AI_READ_DOCUMENTS=true   AI_DOC_MAX_CHARS=1500   AI_DOC_MAX_PER_ANSWER=6   AI_DOC_MAX_FILE_MB=5
# Excel templates of the command center (AI-09). Defaults shown, all optional:
# AI_ACTION_MAX_FILE_MB=2   AI_ACTION_MAX_FILE_ROWS=50   AI_ACTION_MAX_ACCOUNTS_PER_HOUR=100

# ---- Assistant chat (floating button) ---------------------------------------
# ollama = local model above | openai = hosted API (set AI_API_*) | off = hidden. See Services/Ai/README.md
AI_CHAT_PROVIDER=ollama
# AI_API_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_API_MODEL=gpt-4o-mini

# ---- WebAuthn (fingerprint / passkeys) -------------------------------------
# RP_ID must be the host name WITHOUT port. ORIGINS must match the URL in the browser EXACTLY (with port).
# Optional override (normally derived from PUBLIC_URL):
# WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Sourcing & Tender System
# WEBAUTHN_ORIGINS=https://localhost:7180
# WEBAUTHN_MAX_FAILURES: failed fingerprint sign-ins allowed per client address in 10 minutes.
WEBAUTHN_MAX_FAILURES=10

# ---- Face recognition (sign-in and onboarding) ----
# The camera sends a few frames; the server checks a real head movement and compares the face with the saved template.
# Tune these with REAL faces of your team.
# FACE_MATCH_THRESHOLD: higher = stricter (fewer wrong accepts, more false rejects). Same person is usually 0.5 to 0.8.
FACE_MATCH_THRESHOLD=0.5
# FACE_MIN_LIVENESS_SCORE: share of the frames that must behave as asked (0 to 1).
FACE_MIN_LIVENESS_SCORE=0.7
# FACE_YAW_CENTER_MAX: for "look straight" the head turn must stay below this.
FACE_YAW_CENTER_MAX=0.18
# FACE_YAW_TURN_MIN: for "turn your head" it must reach at least this (lower it if people cannot pass, raise it if too easy).
FACE_YAW_TURN_MIN=0.25
# FACE_MIN_FACE_WIDTH: face width divided by picture width. Too small means too far from the camera.
FACE_MIN_FACE_WIDTH=0.15
# FACE_PASSIVE_LIVENESS: ONE-STEP sign-in. true (default) = just look straight; a small open-source anti-photo model (Services/Biometrics/Models) checks the face is live.
#   When it is not sure, the camera automatically asks for one head turn instead. false = always ask for the head turn. Setup and AI approvals always ask for both sides.
FACE_PASSIVE_LIVENESS=true
# FACE_PASSIVE_MIN_REAL: how "real" the straight frames must look (0 to 1) to skip the head turn. Higher = stricter (more people asked to turn). Photos and screens score near 0, real faces near 1.
#   Tune with your team's webcams: the server log prints the numbers ("Passive liveness: average real=...").
FACE_PASSIVE_MIN_REAL=0.80
# FACE_LOGIN_TURNS: head turns asked at SIGN-IN when the one-step check is off or not sure. 1 = look straight + ONE random side (the default). 2 = both sides (strictest, slower).
FACE_LOGIN_TURNS=1
# FACE_ALLOW_IDENTIFY: "smart" sign-in. true = leave the email empty and the system recognises you among everybody. false = email always required.
FACE_ALLOW_IDENTIFY=true
# FACE_IDENTIFY_THRESHOLD: similarity needed to name a person when no email was typed (stricter than FACE_MATCH_THRESHOLD).
FACE_IDENTIFY_THRESHOLD=0.55
# FACE_IDENTIFY_MARGIN: the best match must beat the second-best person by this much, otherwise it is refused as ambiguous.
FACE_IDENTIFY_MARGIN=0.10
# FACE_IDENTIFY_MAX_FAILURES: failed smart attempts allowed per client address in 10 minutes.
FACE_IDENTIFY_MAX_FAILURES=8
# 32 random bytes in base64 for encrypting saved face templates. In Development you may leave it as CHANGE_ME:
# a key file is then created once in App_Data/face-dev.key. In production this key is REQUIRED.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FACE_TEMPLATE_ENCRYPTION_KEY=PZdaLGDA/rkzTdkIEPM3oC2E5sxlnQTnBl/cxMwxuis=

# ---- File uploads -----------------------------------------------------------
UPLOAD_ROOT_PATH=App_Data/uploads
UPLOAD_MAX_MB=10
UPLOAD_ALLOWED_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.docx,.xlsx

# ---- Email / notifications (SMTP) ----
# SMTP_ENABLED=false (default): nothing is sent. In Development every email is saved as an .html file in
#   App_Data/emails so you can open it in the browser. Great for working without a mail server.
# SMTP_ENABLED=true: real sending. Port 587 uses STARTTLS, port 465 uses SSL, both are detected automatically.
#   Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com, SMTP_PASSWORD=<an "app password">, SMTP_FROM=you@gmail.com
#   Local fake inbox (no real mail leaves your PC): install smtp4dev, then SMTP_HOST=localhost, SMTP_PORT=2525, no user/password.
# Quick check in Development: open https://andale-juice-knife-assigned.trycloudflare.com/dev/send-test-email?to=mswandcomp@gmail.com
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=mswandcomp@gmail.com
SMTP_PASSWORD=xgrpvsilhdymxshs
SMTP_FROM=mswandcomp@gmail.com
SMTP_FROM_NAME=Sourcing & Tender System
# Links inside emails use PUBLIC_URL (optional override: APP_BASE_URL=...)

# ---- Development test accounts (created at startup, Development environment ONLY) ----
# One account per role is created so the team can test every dashboard:
#   admin / requester / officer / evaluator / manager / top (@lumiere.local) and supplier@bottlepro.local
# Set SEED_TEST_USERS=false to skip them. Passwords must be 10+ chars with upper, lower, digit and symbol.
SEED_TEST_USERS=true
SEED_TEST_PASSWORD=Test#12345!
SEED_ADMIN_EMAIL=admin@lumiere.local
SEED_ADMIN_PASSWORD=Admin#12345!

# Marwa: fresh LAB testing batch. Change to 02, 03, etc. to add empty scenarios without resetting history.
SEED_DEMO_RUN=01
