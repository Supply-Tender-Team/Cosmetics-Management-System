# =====================================================================
#  What must NEVER be pushed (secrets, machine files, build output)
# =====================================================================

# ---- secrets and local settings ----
.env
.env.*
!.env.example
appsettings.Local.json
appsettings.*.Local.json
secrets.json

# ---- Visual Studio / Rider / VS Code (every developer has their own) ----
.vs/
.idea/
.vscode/
*.user
*.suo
*.userprefs
*.DotSettings.user
*.csproj.user

# Visual Studio "connected services" files (point to one person's database)
**/Properties/serviceDependencies.json
**/Properties/serviceDependencies.*.json
**/Connected Services/

# ---- build output ----
[Bb]in/
[Oo]bj/
[Pp]ublish/
*.pubxml.user
TestResults/
*.log

# ---- local databases ----
*.mdf
*.ldf
*.ndf
*.bak

# ---- uploaded files and runtime data (never commit documents or biometric data) ----
**/App_Data/*
!**/App_Data/.gitkeep
**/wwwroot/uploads/

# ---- node / OS junk ----
node_modules/
Thumbs.db
.DS_Store
desktop.ini
~$*
